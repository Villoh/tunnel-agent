<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TunnelAgent.ViewModels"
             xmlns:cv="using:TunnelAgent.Converters"
             xmlns:si="using:IconPacks.Avalonia.SimpleIcons"
             xmlns:lucide="using:IconPacks.Avalonia.Lucide"
             x:Class="TunnelAgent.Views.ProvidersView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <cv:ServerStateRunningConverter x:Key="StateIsRunning" />
        <cv:ServerStateToTextConverter  x:Key="StateToText" />
        <cv:ServerStateToBrushConverter x:Key="StateToBrush" />
        <cv:HexToBrushConverter         x:Key="HexBrush" />
        <cv:BoolToOpacityConverter      x:Key="BoolToOpacity" />
        <cv:StringNotEmptyConverter     x:Key="StringNotEmpty" />
        <cv:InvertBoolConverter         x:Key="InvertBool" />
    </UserControl.Resources>

    <Panel>
        <ScrollViewer>
            <StackPanel Spacing="0" Margin="0,0,0,24">

                <!-- ── Header ────────────────────────────────────────────── -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Classes="page-title" Text="Services" />
                        <TextBlock Classes="page-sub" Text="Local OpenAI-compatible endpoint for your CLI agents." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Classes="endpoint" ToolTip.Tip="Copy endpoint" Click="OnCopyEndpoint">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{Binding EndpointUrl}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <lucide:PackIconLucide Kind="Copy" Width="13" Height="13"
                                                       Foreground="{DynamicResource FgMutedBrush}"
                                                       VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="app primary"
                                Content="Start"
                                Command="{Binding StartServerCommand}"
                                IsVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}, ConverterParameter=Invert}" />
                        <Button Classes="app"
                                Content="Stop"
                                Command="{Binding StopServerCommand}"
                                IsVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}}" />
                    </StackPanel>
                </Grid>

                <!-- ── Server status pill ────────────────────────────────── -->
                <Border Classes="card" Margin="0,0,0,6">
                    <Grid Margin="16,12" ColumnDefinitions="22,*,Auto">
                        <Grid Classes="status-indicator">
                            <Ellipse Classes="status-pulse"
                                     Fill="{Binding ServerState, Converter={StaticResource StateToBrush}}"
                                     IsVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}}" />
                            <Ellipse Classes="status-dot"
                                     Fill="{Binding ServerState, Converter={StaticResource StateToBrush}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Classes="row-label" Text="Server status" />
                            <TextBlock Classes="row-desc">
                                <Run Text="Localhost proxy on port " />
                                <Run Text="{Binding Port}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ServerState, Converter={StaticResource StateToText}}"
                                   Classes="status"
                                   Foreground="{Binding ServerState, Converter={StaticResource StateToBrush}}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ── Provider list ─────────────────────────────────────── -->
                <Border Classes="card">
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderViewModel">
                                <StackPanel>

                                    <!-- Main provider row (clickable to expand) -->
                                    <Button Classes="provider-row"
                                            Command="{Binding ToggleExpandCommand}"
                                            IsEnabled="{Binding HasAccounts}">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                                            <!-- Toggle pill -->
                                            <ToggleButton Grid.Column="0"
                                                          Classes="enable-toggle"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />

                                            <!-- Provider icon -->
                                            <Border Grid.Column="1"
                                                    Classes="provider-logo"
                                                    Width="28" Height="28"
                                                    Background="{Binding LogoColor, Converter={StaticResource HexBrush}}"
                                                    Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacity}}"
                                                    Margin="0,0,10,0">
                                                <si:PackIconSimpleIcons Kind="{Binding IconKind}"
                                                                        Foreground="White"
                                                                        Width="14" Height="14"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Name + sub-status -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="row-label"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center" />
                                                    <!-- "disabled" badge when toggled off -->
                                                    <Border Classes="chip"
                                                            Background="#22FF7A00"
                                                            IsVisible="{Binding IsEnabled, Converter={StaticResource InvertBool}}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="disabled"
                                                                   Foreground="#CC7A2B"
                                                                   FontSize="10" />
                                                    </Border>
                                                    <!-- Connecting spinner text -->
                                                    <Border Classes="chip"
                                                            Background="#22AAAAFF"
                                                            IsVisible="{Binding IsConnecting}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="connecting…"
                                                                   Foreground="#8888FF"
                                                                   FontSize="10" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Sub-status line -->
                                                <StackPanel Orientation="Horizontal" Spacing="2"
                                                            IsVisible="{Binding IsEnabled}">
                                                    <TextBlock Text="{Binding ConnectedSubText}"
                                                               FontSize="11.5"
                                                               Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}" />
                                                    <TextBlock Text="›"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource FgFaintBrush}"
                                                               IsVisible="{Binding HasAccounts}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Add Account / Connect / Disconnect buttons -->
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0">

                                                <!-- OAuth: Connecting spinner -->
                                                <Button Classes="app"
                                                        IsVisible="{Binding IsConnecting}"
                                                        IsEnabled="False"
                                                        Content="Connecting…"
                                                        FontSize="12" Padding="10,3" />

                                                <!-- OAuth: + Add account (when connected, not connecting) -->
                                                <Button Classes="icon-btn"
                                                        ToolTip.Tip="Add another account"
                                                        Click="OnOAuthConnect"
                                                        Tag="{Binding}">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static cv:MultiBoolAndConverter.Instance}">
                                                            <Binding Path="Connected" />
                                                            <Binding Path="IsConnecting" Converter="{StaticResource InvertBool}" />
                                                            <Binding Path="IsOAuth" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                    <lucide:PackIconLucide Kind="Plus" Width="14" Height="14"
                                                                           Foreground="{DynamicResource FgMutedBrush}" />
                                                </Button>

                                                <!-- OAuth: Disconnect (when connected, not connecting) -->
                                                <Button Classes="app"
                                                        Content="Disconnect"
                                                        Click="OnOAuthDisconnect"
                                                        Tag="{Binding}"
                                                        FontSize="12" Padding="10,3">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static cv:MultiBoolAndConverter.Instance}">
                                                            <Binding Path="Connected" />
                                                            <Binding Path="IsConnecting" Converter="{StaticResource InvertBool}" />
                                                            <Binding Path="IsOAuth" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>

                                                <!-- OAuth: Connect (when not connected, not connecting) -->
                                                <Button Classes="app"
                                                        Content="Connect"
                                                        Click="OnOAuthConnect"
                                                        Tag="{Binding}"
                                                        FontSize="12" Padding="10,3">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static cv:MultiBoolAndConverter.Instance}">
                                                            <Binding Path="Connected" Converter="{StaticResource InvertBool}" />
                                                            <Binding Path="IsConnecting" Converter="{StaticResource InvertBool}" />
                                                            <Binding Path="IsOAuth" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>

                                                <!-- Custom provider: Add Account -->
                                                <Button Classes="app"
                                                        Content="Add Account"
                                                        IsVisible="{Binding IsOAuth, Converter={StaticResource InvertBool}}"
                                                        Command="{Binding RequestAddAccountCommand}"
                                                        FontSize="12" Padding="10,3" />
                                            </StackPanel>

                                            <!-- Expand chevron -->
                                            <Grid Grid.Column="4" Width="20" VerticalAlignment="Center"
                                                  IsVisible="{Binding HasAccounts}">
                                                <lucide:PackIconLucide Kind="ChevronRight"
                                                                        Width="14" Height="14"
                                                                        Foreground="{DynamicResource FgFaintBrush}"
                                                                        IsVisible="{Binding IsExpanded, Converter={StaticResource InvertBool}}" />
                                                <lucide:PackIconLucide Kind="ChevronDown"
                                                                        Width="14" Height="14"
                                                                        Foreground="{DynamicResource FgFaintBrush}"
                                                                        IsVisible="{Binding IsExpanded}" />
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <!-- ── Expanded accounts panel ──────────────────────── -->
                                    <ItemsControl ItemsSource="{Binding Accounts}"
                                                  IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProviderAccountViewModel">
                                                <Border Background="#08FFFFFF"
                                                        Margin="16,8,16,10"
                                                        CornerRadius="8"
                                                        Padding="14,12,14,14">
                                                    <StackPanel Spacing="10">

                                                        <!-- Account header: email + plan badge + actions -->
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">

                                                            <!-- Email / label -->
                                                            <StackPanel Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        Spacing="8"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource FgBrush}" />
                                                                <!-- Plan badge e.g. PLUS -->
                                                                <Border Classes="chip"
                                                                        Background="{DynamicResource AccentSoftBrush}"
                                                                        IsVisible="{Binding PlanBadge, Converter={StaticResource StringNotEmpty}}">
                                                                    <TextBlock Text="{Binding PlanBadge}"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                                <!-- Masked key chip (for custom API-key providers) -->
                                                                <Border Classes="chip"
                                                                        Background="#14000000"
                                                                        IsVisible="{Binding IsCustomKey}">
                                                                    <TextBlock Text="{Binding MaskedKey}"
                                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                                                               FontSize="10" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Enable toggle -->
                                                            <ToggleButton Grid.Column="2"
                                                                          Classes="enable-toggle"
                                                                          IsChecked="{Binding IsDisabled, Mode=TwoWay, Converter={StaticResource InvertBool}}"
                                                                          ToolTip.Tip="Enable / disable this account"
                                                                          Margin="8,0,4,0"
                                                                          VerticalAlignment="Center" />

                                                            <!-- Refresh quota button -->
                                                            <Button Grid.Column="3"
                                                                    Classes="icon-btn"
                                                                    ToolTip.Tip="Refresh quota"
                                                                    Click="OnRefreshQuota"
                                                                    Tag="{Binding}"
                                                                    VerticalAlignment="Center">
                                                                <lucide:PackIconLucide Kind="RefreshCw" Width="13" Height="13"
                                                                                       Foreground="{DynamicResource FgMutedBrush}" />
                                                            </Button>

                                                            <!-- Remove button -->
                                                            <Button Grid.Column="4"
                                                                    Classes="icon-btn"
                                                                    ToolTip.Tip="Remove account"
                                                                    Command="{Binding #Root.DataContext.RemoveAccountCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center">
                                                                <lucide:PackIconLucide Kind="Trash2" Width="13" Height="13"
                                                                                       Foreground="{DynamicResource FgMutedBrush}" />
                                                            </Button>
                                                        </Grid>

                                                        <!-- Quota bars -->
                                                        <ItemsControl ItemsSource="{Binding QuotaBars}"
                                                                      IsVisible="{Binding HasQuota}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:QuotaBarViewModel">
                                                                    <StackPanel Spacing="4" Margin="0,2,0,0">
                                                                        <!-- Title + percentage -->
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding Title}"
                                                                                       FontSize="11.5"
                                                                                       Foreground="{DynamicResource FgMutedBrush}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding UsedLabel}"
                                                                                       FontSize="11.5"
                                                                                       FontWeight="Medium"
                                                                                       Foreground="#3CB371" />
                                                                        </Grid>
                                                                        <!-- Progress track -->
                                                                        <ProgressBar Minimum="0" Maximum="1"
                                                                                     Value="{Binding Used}"
                                                                                     Height="4"
                                                                                     CornerRadius="2"
                                                                                     Background="#22FFFFFF"
                                                                                     Foreground="#3CB371" />
                                                                        <!-- Reset countdown -->
                                                                        <TextBlock Text="{Binding ResetIn}"
                                                                                   FontSize="10.5"
                                                                                   Foreground="{DynamicResource FgFaintBrush}"
                                                                                   IsVisible="{Binding ResetIn, Converter={StaticResource StringNotEmpty}}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Classes="row-divider" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ── Available models ──────────────────────────────────── -->
                <TextBlock Classes="section-label" Text="AVAILABLE MODELS" />
                <Border Classes="card">
                    <StackPanel>
                        <Grid Margin="16,12" ColumnDefinitions="30,*,Auto">
                            <Border Grid.Column="0" Classes="provider-logo" Background="{DynamicResource AccentSoftBrush}">
                                <lucide:PackIconLucide Kind="Brain" Width="16" Height="16"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Classes="row-label" Text="Available models" />
                                <TextBlock Classes="row-desc" Text="Models exposed by connected providers." />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TotalAvailableModelCount, StringFormat='{}{0} total'}"
                                       Classes="status"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Border Classes="row-divider" />

                        <ItemsControl ItemsSource="{Binding AvailableModelGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AvailableModelGroupViewModel">
                                    <StackPanel>
                                        <ToggleButton Classes="model-group" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                            <Grid ColumnDefinitions="30,*,Auto,24">
                                                <Border Grid.Column="0" Classes="provider-logo" Background="#14000000">
                                                    <lucide:PackIconLucide Kind="Boxes" Width="15" Height="15"
                                                                           Foreground="{DynamicResource FgMutedBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Classes="row-label" Text="{Binding ProviderName}" />
                                                    <TextBlock Classes="row-desc" Text="Connected service" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="chip" Background="#14000000" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ModelCount, StringFormat='{}{0} models'}"
                                                               Foreground="{DynamicResource FgMutedBrush}" />
                                                </Border>
                                                <Grid Grid.Column="3" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <lucide:PackIconLucide Kind="ChevronRight" Width="14" Height="14"
                                                                           Foreground="{DynamicResource FgMutedBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           IsVisible="{Binding !IsExpanded}" />
                                                    <lucide:PackIconLucide Kind="ChevronDown" Width="14" Height="14"
                                                                           Foreground="{DynamicResource FgMutedBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           IsVisible="{Binding IsExpanded}" />
                                                </Grid>
                                            </Grid>
                                        </ToggleButton>

                                        <ItemsControl ItemsSource="{Binding Models}" IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AvailableModelViewModel">
                                                    <Grid Margin="54,6,14,8" ColumnDefinitions="*,Auto,Auto">
                                                        <StackPanel Grid.Column="0" MinWidth="0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource FgBrush}" />
                                                            <TextBlock Classes="row-desc" Text="{Binding Context}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Classes="chip" Background="#14000000"
                                                                Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Provider}" Foreground="{DynamicResource FgMutedBrush}" />
                                                        </Border>
                                                        <Border Grid.Column="2" Classes="chip"
                                                                Background="{DynamicResource AccentSoftBrush}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AuthKind}" Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Classes="row-divider" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── OAuth status toast ─────────────────────────────────────────── -->
        <Border IsVisible="{Binding ShowOAuthStatus}"
                Classes="card"
                MaxWidth="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,12,0"
                Padding="14,10"
                ZIndex="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding OAuthStatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource FgBrush}"
                           MaxWidth="330" />
                <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0" VerticalAlignment="Top"
                        Click="OnDismissOAuthStatus">
                    <lucide:PackIconLucide Kind="X" Width="12" Height="12"
                                          Foreground="{DynamicResource FgMutedBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- ── Add Account dialog overlay ────────────────────────────────── -->
        <Border IsVisible="{Binding ShowAddAccountDialog}"
                Background="#88000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="20">
            <Border Classes="card"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15"
                               Text="{Binding AddAccountTarget.Name, StringFormat='Add account — {0}'}" />

                    <StackPanel Spacing="4"
                                IsVisible="{Binding AddAccountTarget.IsOAuth, Converter={StaticResource InvertBool}, FallbackValue=False}">
                        <TextBlock Classes="row-desc" Text="Base URL" />
                        <TextBox x:Name="BaseUrlBox" Classes="app" Watermark="https://api.example.com/v1" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="API Key" />
                        <TextBox x:Name="ApiKeyBox" Classes="app" PasswordChar="●" Watermark="sk-..." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="Label (optional)" />
                        <TextBox x:Name="LabelBox" Classes="app" Watermark="My account" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel"
                                Command="{Binding DismissAddAccountDialogCommand}" />
                        <Button Classes="app primary" Content="Add Account"
                                Click="OnConfirmAddAccount" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
