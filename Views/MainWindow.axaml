<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TunnelAgent.ViewModels"
        xmlns:v="using:TunnelAgent.Views"
        xmlns:cv="using:TunnelAgent.Converters"
        xmlns:lucide="using:IconPacks.Avalonia.Lucide"
        x:Class="TunnelAgent.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Tunnel Agent"
        Icon="/Assets/logo.ico"
        Width="820" Height="600"
        MinWidth="680" MinHeight="460"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource WinBgBrush}">
    <Window.Resources>
        <cv:ServerStateToTextConverter  x:Key="StateToText" />
        <cv:ServerStateToBrushConverter x:Key="StateToBrush" />
        <cv:ServerStateRunningConverter x:Key="StateIsRunning" />
        <cv:SectionEqualsConverter      x:Key="SectionEq" />
        <cv:SidebarWidthConverter       x:Key="SidebarWidth" />
    </Window.Resources>

    <Border Background="{DynamicResource WinBgBrush}"
            BorderBrush="{DynamicResource WinBorderBrush}"
            BorderThickness="0"
            CornerRadius="0"
            ClipToBounds="True">
        <Panel>
        <Grid RowDefinitions="38,*">
            <!-- Custom titlebar -->
            <Grid Grid.Row="0" PointerPressed="OnTitlebarPressed"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource WinBorderBrush}" Opacity="0.8" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/logo-20.png" Width="18" Height="18"
                           VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <TextBlock Text="Tunnel Agent"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgBrush}" />
                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="11"
                               Foreground="{DynamicResource FgFaintBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Classes="traffic minimize" ToolTip.Tip="Minimize" Click="OnMinimize" />
                    <Button Classes="traffic maximize" ToolTip.Tip="Maximize / Restore" Click="OnMaximizeRestore" />
                    <Button Classes="traffic close" ToolTip.Tip="Close" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- Body: sidebar + content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidth}}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SideBgBrush}"
                        BorderBrush="{DynamicResource SideBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True">

                        <!-- Footer -->
                        <Border DockPanel.Dock="Bottom"
                                BorderBrush="{DynamicResource SideBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8">
                            <Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsSidebarCollapsed}">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding AppVersion, StringFormat='v{0} · MIT'}" FontSize="11"
                                                   Foreground="{DynamicResource FgFaintBrush}" />
                                        <Button Classes="link" Command="{Binding OpenIssueUrlCommand}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="Report an issue" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Cursor="Hand" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="icon" HorizontalAlignment="Right"
                                            ToolTip.Tip="Toggle light / dark mode"
                                            Command="{Binding ToggleThemeCommand}">
                                        <Grid Width="18" Height="18" Classes="theme-icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <lucide:PackIconLucide Kind="Moon" Width="15" Height="15"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding !IsDark}" />
                                            <lucide:PackIconLucide Kind="SunMedium" Width="16" Height="16"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding IsDark}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Button Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSidebarCollapsed}"
                                        ToolTip.Tip="Toggle light / dark mode"
                                        Command="{Binding ToggleThemeCommand}">
                                    <Grid Width="18" Height="18" Classes="theme-icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <lucide:PackIconLucide Kind="Moon" Width="15" Height="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                               IsVisible="{Binding !IsDark}" />
                                        <lucide:PackIconLucide Kind="SunMedium" Width="16" Height="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                               IsVisible="{Binding IsDark}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Margin="8,10" Spacing="2">
                            <Grid Margin="0,0,0,4">
                                <!-- Expanded: collapse button aligned right -->
                                <Button Classes="icon" Width="24" Height="24"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsVisible="{Binding !IsSidebarCollapsed}"
                                        ToolTip.Tip="Collapse sidebar"
                                        Command="{Binding ToggleSidebarCommand}">
                                    <lucide:PackIconLucide Kind="PanelLeftClose" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMutedBrush}" />
                                </Button>
                                <!-- Collapsed: expand button centered -->
                                <Button Classes="icon" Width="24" Height="24"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSidebarCollapsed}"
                                        ToolTip.Tip="Expand sidebar"
                                        Command="{Binding ToggleSidebarCommand}">
                                    <lucide:PackIconLucide Kind="PanelLeftOpen" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMutedBrush}" />
                                </Button>
                            </Grid>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Providers}"
                                    Command="{Binding SelectProvidersCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Server" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Providers" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                               IsVisible="{Binding !IsSidebarCollapsed}"/>
                                    <Border Grid.Column="2" CornerRadius="999" Background="#14000000" Padding="6,1"
                                            IsVisible="{Binding !IsSidebarCollapsed}">
                                        <TextBlock Text="{Binding ConnectedProviderCount}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Classes="side" IsEnabled="False" Opacity="0.4"
                                    ToolTip.Tip="Coming soon">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Bot" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Agents" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                               IsVisible="{Binding !IsSidebarCollapsed}"/>
                                    <Border Grid.Column="2" CornerRadius="999" Background="#14000000" Padding="6,1"
                                            IsVisible="{Binding !IsSidebarCollapsed}">
                                        <TextBlock Text="Soon" FontSize="10" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Configuration}"
                                    Command="{Binding SelectConfigurationCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Settings" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Configuration" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                               IsVisible="{Binding !IsSidebarCollapsed}"/>
                                    <!-- Update badge dot -->
                                    <Ellipse Grid.Column="2" Width="7" Height="7"
                                             Fill="{DynamicResource AccentBrush}"
                                             Margin="4,0,0,0"
                                             IsVisible="{Binding ConfigHasBadge}" />
                                </Grid>
                            </Button>

                            <TextBlock Classes="section-label" Text="STATUS" Margin="10,12,10,4"
                                       IsVisible="{Binding !IsSidebarCollapsed}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,2">
                                <Grid Classes="status-indicator">
                                    <Ellipse Classes="status-pulse"
                                             Fill="{Binding ServerState, Converter={StaticResource StateToBrush}}"
                                             IsVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}}" />
                                    <Ellipse Classes="status-dot"
                                             Fill="{Binding ServerState, Converter={StaticResource StateToBrush}}" />
                                </Grid>
                                <TextBlock Text="{Binding ServerState, Converter={StaticResource StateToText}}"
                                           Classes="status" Foreground="{Binding ServerState, Converter={StaticResource StateToBrush}}"
                                           IsVisible="{Binding !IsSidebarCollapsed}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content area -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto">
                    <ContentControl HorizontalContentAlignment="Stretch" Padding="18,16,18,44">
                        <ContentControl.Content>
                            <Grid>
                                <v:ProvidersView IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Providers}" />
                                <!-- Agents disabled until implemented -->
                                <!-- <v:AgentsView IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Agents}" /> -->
                                <v:ConfigurationView IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Configuration}" />
                            </Grid>
                        </ContentControl.Content>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Update toast overlay -->
        <Border IsVisible="{Binding ShowUpdateToast}"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                MaxWidth="380"
                ZIndex="50">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="row-label" Text="Engine update available"/>
                    <TextBlock Classes="row-desc"
                               Text="{Binding LatestVersion, StringFormat='CLIProxyAPI {0} is ready to install.'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="app primary" Content="Update" Command="{Binding UpdateEngineCommand}" />
                    <Button Classes="app" Content="Dismiss" Command="{Binding DismissToastCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        </Panel>
    </Border>
</Window>
