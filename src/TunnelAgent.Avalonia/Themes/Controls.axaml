<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:TunnelAgent.Controls"
        xmlns:lucide="using:IconPacks.Avalonia.Lucide">

    <!-- Global cursor: Hand on all interactive controls -->
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Borderless-window resize hit targets -->
    <Style Selector="Border.resize-handle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ZIndex" Value="100" />
    </Style>

    <!-- Card container -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Row separator -->
    <Style Selector="Border.row-divider">
        <Setter Property="Background" Value="{DynamicResource RowDividerBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="14,0" />
    </Style>

    <!-- Section label -->
    <Style Selector="TextBlock.section-label">
        <Setter Property="Foreground" Value="{DynamicResource FgFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1" />
        <Setter Property="Margin" Value="4,18,4,8" />
        <Setter Property="Text" Value="" />
    </Style>

    <!-- Page title / subtitle -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.page-sub">
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.row-label">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.row-desc">
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Default app button -->
    <Style Selector="Button.app">
        <Setter Property="Background" Value="{DynamicResource BtnBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.app:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}" />
    </Style>
    <Style Selector="Button.app:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}" />
    </Style>

    <Style Selector="Button.app.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.app.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.app.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="Button.app.danger">
        <Setter Property="Foreground" Value="{DynamicResource ErrBrush}" />
    </Style>

    <!-- Cohesive alerts: info / warning / error, solid surfaces -->
    <Style Selector="Border.alert">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="{DynamicResource AlertInfoBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AlertInfoBorderBrush}" />
    </Style>
    <Style Selector="Border.alert.info">
        <Setter Property="Background" Value="{DynamicResource AlertInfoBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AlertInfoBorderBrush}" />
    </Style>
    <Style Selector="Border.alert.warning">
        <Setter Property="Background" Value="{DynamicResource AlertWarnBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AlertWarnBorderBrush}" />
    </Style>
    <Style Selector="Border.alert.error">
        <Setter Property="Background" Value="{DynamicResource AlertErrBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AlertErrBorderBrush}" />
    </Style>
    <Style Selector="TextBlock.alert-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.alert.warning TextBlock.alert-title">
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="Border.alert.error TextBlock.alert-title">
        <Setter Property="Foreground" Value="{DynamicResource ErrBrush}" />
    </Style>
    <Style Selector="TextBlock.alert-body">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Tray usage popup left rail button -->
    <Style Selector="Button.rail">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#14808080" />
    </Style>
    <Style Selector="Button.rail:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#1F808080" />
    </Style>

    <!-- Shared motion for every icon button; size and chrome stay class-specific. -->
    <Style Selector="Button.icon, Button.icon-btn">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter, Button.icon-btn /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <!-- Override Fluent's default hover fill while retaining the scale feedback. -->
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter, Button.icon-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:pointerover, Button.icon-btn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.18)" />
    </Style>
    <Style Selector="Button.icon:pressed, Button.icon-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.icon:disabled, Button.icon-btn:disabled">
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#26000000" />
    </Style>

    <Style Selector="Button.engine-action">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.engine-action:pressed">
        <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button.engine-action.start">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#58B97B" />
    </Style>
    <Style Selector="Button.engine-action.start:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.engine-action.stop">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#D46A6A" />
    </Style>
    <Style Selector="Button.engine-action.stop:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Custom titlebar traffic-light buttons -->
    <Style Selector="Button.traffic">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Ellipse Width="16" Height="16"
                             Fill="{TemplateBinding Background}" />
                    <Border x:Name="IconPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.traffic.minimize">
        <Setter Property="Background" Value="#F6D58A" />
    </Style>
    <Style Selector="Button.traffic.maximize">
        <Setter Property="Background" Value="#82D982" />
    </Style>
    <Style Selector="Button.traffic.close">
        <Setter Property="Background" Value="#F17C9A" />
    </Style>
    <Style Selector="Button.traffic:pointerover /template/ Border#IconPresenter">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Invisible link button (looks like hyperlink text) -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Sidebar item -->
    <Style Selector="Button.side">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Button.side:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0F000000" />
    </Style>
    <!-- Selected background is provided by the sliding pill behind the buttons
         (see MainWindow SidebarPill), so the item itself stays transparent. -->
    <Style Selector="Button.side.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.side.selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.side:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#16000000" />
    </Style>
    <Style Selector="Button.side.selected:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.side lucide|PackIconLucide">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="Button.side.selected lucide|PackIconLucide">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.side-sub">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
    <Style Selector="Button.side-sub.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Sidebar footer proxy status card (Quotio-style) -->
    <Style Selector="Button.proxy-card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.proxy-card:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.proxy-card:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.proxy-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>


    <!-- In-card expandable model group header -->
    <Style Selector="ToggleButton.provider-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.provider-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0F000000" />
    </Style>
    <Style Selector="ToggleButton.provider-row:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.provider-row:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#16000000" />
    </Style>
    <Style Selector="ToggleButton.provider-row:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="ToggleButton.model-group">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="14,12,14,8" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.model-group:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0F000000" />
    </Style>
    <Style Selector="ToggleButton.model-group:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.model-group:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#16000000" />
    </Style>

    <!-- ToggleSwitch: hide On/Off content -->
    <Style Selector="ToggleSwitch.app">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Theme toggle icon: scale on hover, spin+shrink on press -->
    <Style Selector="Grid.theme-icon">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.theme-icon:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.2)" />
    </Style>
    <Style Selector="Button:pressed > Grid.theme-icon">
        <Setter Property="RenderTransform" Value="rotate(180deg) scale(0.85)" />
    </Style>
    <Style Selector="Button.theme-toggle:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Status indicator -->
    <Style Selector="Grid.status-indicator">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.status-dot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.status-pulse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.35" />
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="Width" Value="8" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Opacity" Value="0.35" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Width" Value="18" />
                    <Setter Property="Height" Value="18" />
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Status pill text -->
    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Endpoint pill -->
    <Style Selector="Border.endpoint">
        <Setter Property="Background" Value="#0D000000" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,4,9,4" />
        <Setter Property="MaxWidth" Value="220" />
    </Style>

    <!-- Copy endpoint button -->
    <Style Selector="Button.copy-endpoint /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.copy-endpoint:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.78" />
    </Style>
    <Style Selector="Button.copy-endpoint:pressed /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.58" />
    </Style>
    <Style Selector="Button.copy-endpoint.copied /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#3CB371" />
    </Style>

    <!-- Provider logo -->
    <Style Selector="Border.provider-logo">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Chips -->
    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,1" />
    </Style>
    <Style Selector="Border.chip TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Enable/disable toggle pill with sliding white thumb via ControlTemplate -->
    <Style Selector="ToggleButton.enable-toggle">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Track"
                        Width="36" Height="20"
                        CornerRadius="10"
                        Background="#3A3A3A">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15" />
                        </Transitions>
                    </Border.Transitions>
                    <Canvas Width="36" Height="20">
                        <Border x:Name="Thumb"
                                Width="14" Height="14"
                                CornerRadius="7"
                                Background="White"
                                Canvas.Left="3"
                                Canvas.Top="3">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Canvas.Left" Duration="0:0:0.15" Easing="CubicEaseInOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Canvas>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.enable-toggle:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.enable-toggle:checked /template/ Border#Thumb">
        <Setter Property="Canvas.Left" Value="19" />
    </Style>
    <Style Selector="ToggleButton.enable-toggle:pointerover /template/ Border#Track">
        <Setter Property="Background" Value="#555555" />
    </Style>
    <Style Selector="ToggleButton.enable-toggle:checked:pointerover /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.enable-toggle:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>


    <!-- Quota bar track -->
    <Style Selector="Border.quota-track">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="Border.quota-fill">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="#3CB371" />
    </Style>

    <!-- Name cell inside provider row: click to expand, no visual chrome -->
    <Style Selector="Button.provider-row-name">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.provider-row-name /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.provider-row-name:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.provider-row-name:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Provider row expand button (full-width, no chrome) -->
    <Style Selector="Button.provider-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.provider-row /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.provider-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#08FFFFFF" />
    </Style>
    <Style Selector="Button.provider-row:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#10FFFFFF" />
    </Style>
    <Style Selector="Button.provider-row.add-provider-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0F000000" />
    </Style>
    <Style Selector="Button.provider-row.add-provider-row:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#16000000" />
    </Style>

    <!-- Spinning refresh icon -->
    <Style Selector="lucide|PackIconLucide.spin">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:0.7" IterationCount="Infinite" Easing="LinearEasing">
                <KeyFrame Cue="0%">
                    <Setter Property="(RotateTransform.Angle)" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="(RotateTransform.Angle)" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Power toggle button for per-account enable/disable -->
    <Style Selector="Button.power-toggle /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.power-toggle.account-disabled /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    </Style>
    <Style Selector="Button.power-toggle:pressed /template/ ContentPresenter">
        <Setter Property="RenderTransform" Value="scale(0.82)" />
    </Style>
    <Style Selector="Button.power-toggle:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Inline text+icon "add" link (e.g. Add Entry) -->
    <Style Selector="Button.link-add">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.link-add:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#14000000" />
    </Style>
    <Style Selector="Button.link-add:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#1F000000" />
    </Style>

    <!-- Rounded, slightly darker flyout used by the fallback add pickers -->
    <Style Selector="FlyoutPresenter.fallback-flyout">
        <Setter Property="Background" Value="{DynamicResource SideBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Compact menu shown from collapsed sidebar items with children -->
    <Style Selector="MenuFlyoutPresenter.sidebar-flyout">
        <Setter Property="Background" Value="{DynamicResource SideBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="188" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Fluent's presenter template ignores Padding and uses FlyoutBorderThemePadding /
         MenuFlyoutScrollerMargin instead, which left a gap around first/last hover. -->
    <Style Selector="MenuFlyoutPresenter.sidebar-flyout /template/ Border#LayoutRoot">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.sidebar-flyout /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.sidebar-flyout MenuItem:nth-child(1)">
        <Setter Property="CornerRadius" Value="7,7,0,0" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.sidebar-flyout MenuItem:nth-last-child(1)">
        <Setter Property="CornerRadius" Value="0,0,7,7" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.sidebar-flyout MenuItem:nth-child(1):nth-last-child(1)">
        <Setter Property="CornerRadius" Value="7" />
    </Style>

    <!-- Borderless expand/collapse chevron (no checked highlight) -->
    <Style Selector="ToggleButton.chevron">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.chevron /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.chevron:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>

    <!-- Animated collapsible region (height + fade) -->
    <Style Selector="Border.collapsible">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="MaxHeight" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="MaxHeight" Duration="0:0:0.20" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.collapsible.expanded">
        <Setter Property="MaxHeight" Value="2000" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.chevron:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#14000000" />
    </Style>
    <Style Selector="ToggleButton.chevron:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#14000000" />
    </Style>
    <Style Selector="ToggleButton.chevron:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#22000000" />
    </Style>

    <!-- Small icon-only button (e.g. trash) -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#22000000" />
    </Style>
    <Style Selector="Button.icon-btn.engine-action:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon-btn.page">
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    </Style>
    <Style Selector="Button.icon-btn.page:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button.icon-btn.page:pressed">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button.icon-btn.page.current /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.icon-btn.page.current:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.icon-btn.page.current">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.icon-btn.engine-action.start">
        <Setter Property="Foreground" Value="#58B97B" />
    </Style>
    <Style Selector="Button.icon-btn.engine-action.stop">
        <Setter Property="Foreground" Value="#D46A6A" />
    </Style>
    <!-- Keep engine start/stop buttons clean while their async command is running (Starting state) -->
    <Style Selector="Button.icon-btn.engine-action:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon-btn.engine-action.start:disabled">
        <Setter Property="Foreground" Value="#58B97B" />
    </Style>
    <Style Selector="Button.icon-btn.engine-action.stop:disabled">
        <Setter Property="Foreground" Value="#D46A6A" />
    </Style>

    <!-- Horizontal pill tab bar -->
    <Style Selector="Border.tab-bar">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Button.tab-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab-item /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0AFFFFFF" />
    </Style>
    <Style Selector="Button.tab-item.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.tab-item:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF" />
    </Style>
    <Style Selector="Button.tab-item.active:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.tab-item.active">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- DateRangePicker: single Fluent-style box (editable text + calendar icon
         button that opens a range Calendar popup). -->
    <Style Selector="ctrl|DateRangePicker">
        <Setter Property="Background" Value="{DynamicResource BtnBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="190" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Name="PART_TextBox" Grid.Column="0"
                                 Background="Transparent" BorderThickness="0"
                                 CornerRadius="6,0,0,6"
                                 Padding="9,3" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Watermark="{TemplateBinding Watermark}" />
                        <Button Name="PART_Button" Grid.Column="1" Classes="icon-btn"
                                Width="28" Focusable="False"
                                Foreground="{DynamicResource FgMutedBrush}">
                            <lucide:PackIconLucide Kind="Calendar" Width="14" Height="14" />
                        </Button>
                        <Popup Name="PART_Popup" PlacementTarget="{TemplateBinding}"
                               Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
                            <Border Classes="card" Padding="4" Margin="0,4,0,0">
                                <Calendar Name="PART_Calendar" SelectionMode="SingleRange" />
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
