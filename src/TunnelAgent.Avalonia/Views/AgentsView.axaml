<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TunnelAgent.ViewModels"
             xmlns:cv="using:TunnelAgent.Converters"
             xmlns:lucide="using:IconPacks.Avalonia.Lucide"
             xmlns:svg="using:Avalonia.Svg.Skia"
             xmlns:l="using:TunnelAgent.Services"
             x:Class="TunnelAgent.Views.AgentsView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <cv:HexToBrushConverter        x:Key="HexBrush" />
        <cv:IntGreaterThanZeroConverter x:Key="IntGtZero" />
        <cv:StringNotEmptyConverter    x:Key="StringNotEmpty" />
        <cv:InvertBoolConverter        x:Key="InvertBool" />
    </UserControl.Resources>

    <StackPanel Spacing="0">

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Grid Margin="0,0,0,14" ColumnDefinitions="*,Auto,Auto">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{l:Loc AgentsView_Title}" />
                <TextBlock Classes="page-sub" Text="{l:Loc AgentsView_Subtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="icon" VerticalAlignment="Bottom" Margin="0,0,8,0"
                    ToolTip.Tip="{l:Loc AgentsView_ConfigureMultipleTooltip}"
                    Command="{Binding OpenBulkAgentConfigCommand}">
                <lucide:PackIconLucide Kind="Settings" Width="15" Height="15" />
            </Button>
            <Button Grid.Column="2" Classes="icon" VerticalAlignment="Bottom"
                    ToolTip.Tip="{l:Loc AgentsView_DetectAgentsTooltip}"
                    Click="OnDetectAgents">
                <lucide:PackIconLucide Kind="RefreshCw" Width="15" Height="15"
                                       Classes.spin="{Binding IsDetectingAgents}" />
            </Button>
        </Grid>

        <!-- ── Stats chips ─────────────────────────────────────────────── -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,18">
            <Border Classes="chip" Background="#1446C788">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding InstalledAgentCount}"
                               Foreground="#46C788" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{l:Loc AgentsView_InstalledChip}" Foreground="#46C788" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Classes="chip" Background="#144285F4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding ConfiguredAgentCount}"
                               Foreground="#4285F4" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{l:Loc AgentsView_ConfiguredChip}" Foreground="#4285F4" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── Installed section ───────────────────────────────────────── -->
        <StackPanel Spacing="6" Margin="0,0,0,18"
                    IsVisible="{Binding InstalledAgentCount, Converter={StaticResource IntGtZero}}">
            <TextBlock Classes="section-label" Text="{l:Loc AgentsView_InstalledSection}" Margin="4,0,4,6" />
            <ItemsControl ItemsSource="{Binding InstalledAgents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentViewModel">
                        <Border Classes="card" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="48,*,Auto" Margin="14,12">

                                <!-- Agent icon: SVG or initials fallback -->
                                <Panel Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}"
                                           Width="32" Height="32"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding HasIcon}" />
                                    <Panel IsVisible="{Binding HasIcon, Converter={StaticResource InvertBool}}">
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                                                Opacity="0.15" />
                                        <TextBlock Text="{Binding Initials}"
                                                   Foreground="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                </Panel>

                                <!-- Name + badge + description + path -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="row-label" Text="{Binding Name}" />
                                        <Border Classes="chip" Background="#1446C788"
                                                IsVisible="{Binding Configured}">
                                            <TextBlock Text="{l:Loc AgentsView_Agent_ConfiguredBadge}" Foreground="#46C788" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Classes="chip" Background="#14E2A52E"
                                                IsVisible="{Binding IsInstalledOnly}">
                                            <TextBlock Text="{l:Loc AgentsView_Agent_InstalledBadge}" Foreground="#E2A52E" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Classes="row-desc" Text="{Binding Description}" />
                                    <TextBlock Text="{Binding BinaryPath}"
                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                               FontSize="11"
                                               Foreground="{DynamicResource FgMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding BinaryPath, Converter={StaticResource StringNotEmpty}}" />
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="icon"
                                            ToolTip.Tip="{l:Loc AgentsView_Agent_DocsTooltip}"
                                            IsVisible="{Binding DocsUrl, Converter={StaticResource StringNotEmpty}}"
                                            Tag="{Binding DocsUrl}"
                                            Click="OnDocsClick">
                                        <lucide:PackIconLucide Kind="ExternalLink" Width="13" Height="13" />
                                    </Button>
                                    <Button Classes="icon"
                                            ToolTip.Tip="{Binding ConfigureButtonLabel}"
                                            Click="OnConfigureClick">
                                        <lucide:PackIconLucide Kind="Settings" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ── Not-installed section ───────────────────────────────────── -->
        <StackPanel Spacing="8"
                    IsVisible="{Binding NotInstalledAgentCount, Converter={StaticResource IntGtZero}}">
            <TextBlock Classes="section-label" Text="{l:Loc AgentsView_NotInstalledSection}"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="4,0,4,6" />
            <ItemsControl ItemsSource="{Binding NotInstalledAgents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentViewModel">
                        <Border CornerRadius="6" Padding="8,6" Margin="0,0,6,6"
                                Background="{DynamicResource CardBgBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Icon: SVG or initials -->
                                <Panel Width="20" Height="20">
                                    <Image Source="{Binding Icon}"
                                           Width="16" Height="16"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding HasIcon}" />
                                    <Panel IsVisible="{Binding HasIcon, Converter={StaticResource InvertBool}}">
                                        <Border Width="20" Height="20" CornerRadius="10"
                                                Background="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                                                Opacity="0.2" />
                                        <TextBlock Text="{Binding Initials}"
                                                   Foreground="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                </Panel>
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           Foreground="{DynamicResource FgMutedBrush}"
                                           VerticalAlignment="Center" />
                                <Button Classes="icon"
                                        ToolTip.Tip="{l:Loc AgentsView_Agent_DocsTooltip}"
                                        IsVisible="{Binding DocsUrl, Converter={StaticResource StringNotEmpty}}"
                                        Tag="{Binding DocsUrl}"
                                        Click="OnDocsClick">
                                    <lucide:PackIconLucide Kind="ExternalLink" Width="11" Height="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </StackPanel>
</UserControl>
