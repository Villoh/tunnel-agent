<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TunnelAgent.ViewModels"
        xmlns:v="using:TunnelAgent.Views"
        xmlns:cv="using:TunnelAgent.Converters"
        xmlns:ctrl="using:TunnelAgent.Controls"
        xmlns:lucide="using:IconPacks.Avalonia.Lucide"
        xmlns:svc="using:TunnelAgent.Services"
        xmlns:l="using:TunnelAgent.Services"
        xmlns:svg="using:Avalonia.Svg.Skia"
        x:Class="TunnelAgent.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="{l:Loc App_Title}"
        Icon="/Assets/logo.ico"
        Width="820" Height="620"
        MinWidth="600" MinHeight="500"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource WinBgBrush}">
    <Window.Resources>
        <cv:ServerStateToTextConverter  x:Key="StateToText" />
        <cv:ServerStateToBrushConverter x:Key="StateToBrush" />
        <cv:ServerStateRunningConverter x:Key="StateIsRunning" />
        <cv:SectionEqualsConverter      x:Key="SectionEq" />
        <cv:SidebarWidthConverter       x:Key="SidebarWidth" />
        <cv:InvertBoolConverter         x:Key="InvertBool" />
        <cv:StringNotEmptyConverter     x:Key="StringNotEmpty" />
        <cv:HexToBrushConverter         x:Key="HexBrush" />
        <cv:SvgImageConverter           x:Key="SvgImage" />
        <cv:SecretPasswordCharConverter x:Key="SecretPasswordChar" />
        <cv:BoolToEyeIconConverter      x:Key="EyeIcon" />
        <cv:IntGreaterThanZeroConverter  x:Key="IntGtZero" />
        <cv:BoolToCloseCancelConverter   x:Key="BoolToCloseCancelConverter" />
    </Window.Resources>

    <Border Background="{DynamicResource WinBgBrush}"
            BorderBrush="{DynamicResource WinBorderBrush}"
            BorderThickness="0"
            CornerRadius="0"
            ClipToBounds="True">
        <Panel>
        <Grid RowDefinitions="38,*">
            <!-- Custom titlebar -->
            <Grid Grid.Row="0" PointerPressed="OnTitlebarPressed"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource WinBorderBrush}" Opacity="0.8" />


                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Classes="traffic minimize" ToolTip.Tip="{l:Loc MainWindow_MinimizeTooltip}" Click="OnMinimize">
                        <lucide:PackIconLucide Kind="Minus" Width="8" Height="8" Foreground="Black" />
                    </Button>
                    <Button Classes="traffic maximize" ToolTip.Tip="{l:Loc MainWindow_MaximizeTooltip}" Click="OnMaximizeRestore">
                        <lucide:PackIconLucide Kind="Maximize2" Width="8" Height="8" Foreground="Black" />
                    </Button>
                    <Button Classes="traffic close" ToolTip.Tip="{l:Loc MainWindow_CloseTooltip}" Click="OnClose">
                        <lucide:PackIconLucide Kind="X" Width="8" Height="8" Foreground="Black" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body: sidebar + content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Width="{Binding SidebarWidth}"
                        Background="{DynamicResource SideBgBrush}"
                        BorderBrush="{DynamicResource SideBorderBrush}"
                        BorderThickness="0,0,1,0"
                        ClipToBounds="True">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseInOut" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <StackPanel Grid.Row="0" Margin="8,10,8,0" Spacing="2">
                            <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                                <Panel Grid.ColumnSpan="2"
                                       Opacity="{Binding SidebarContentOpacity}">
                                    <Panel.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Panel.Transitions>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                        <Image Source="/Assets/logo-20.png" Width="16" Height="16"
                                               VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <TextBlock FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center">
                                            <Run Text="{l:Loc Sidebar_Logo_App}" FontWeight="Bold" />
                                            <Run Text="{l:Loc Sidebar_Logo_Agent}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Panel>
                                <!-- Single toggle button with flip animation -->
                                <Button Grid.Column="1" Classes="icon" Width="24" Height="24"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ToolTip.Tip="{l:Loc Sidebar_ToggleSidebarTooltip}"
                                        Command="{Binding ToggleSidebarCommand}">
                                    <Panel Width="15" Height="15"
                                           RenderTransformOrigin="50%,50%">
                                        <Panel.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding SidebarToggleIconScaleX}">
                                                <ScaleTransform.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="ScaleX" Duration="0:0:0.22" Easing="CubicEaseInOut" />
                                                    </Transitions>
                                                </ScaleTransform.Transitions>
                                            </ScaleTransform>
                                        </Panel.RenderTransform>
                                        <lucide:PackIconLucide Kind="PanelLeftClose" Width="15" Height="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}" />
                                    </Panel>
                                </Button>
                            </Grid>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Home}"
                                    Command="{Binding SelectHomeCommand}">
                                <Grid ColumnDefinitions="20,*">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="LayoutDashboard" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="{l:Loc Sidebar_Home}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Providers}"
                                    Command="{Binding SelectProvidersCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Server" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="{l:Loc Sidebar_Providers}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding ConnectedProviderCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Quota}"
                                    Command="{Binding SelectQuotaCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="ChartBar" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="{l:Loc Sidebar_Quota}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding QuotaProviderCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side"
                                    Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Fallback}"
                                    Command="{Binding SelectFallbackCommand}">
                                <Grid ColumnDefinitions="20,*">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="GitFork" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="{l:Loc Sidebar_Fallback}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side"
                                    Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Agents}"
                                    Command="{Binding SelectAgentsCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Bot" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="{l:Loc Sidebar_Agents}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding ConfiguredAgentCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side"
                                    Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Logs}"
                                    Command="{Binding SelectLogsCommand}">
                                <Grid ColumnDefinitions="20,*">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="ScrollText" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="{l:Loc Sidebar_Logs}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side" Classes.selected="{Binding IsConfigSection}"
                                    Command="{Binding SelectConfigurationCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Settings" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="{l:Loc Sidebar_Configuration}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Grid Classes="status-indicator" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,1,0"
                                              IsVisible="{Binding ConfigHasBadge}">
                                            <Ellipse Classes="status-pulse" Fill="{DynamicResource WarnBrush}" />
                                            <Ellipse Classes="status-dot" Fill="{DynamicResource WarnBrush}" />
                                        </Grid>
                                    </Panel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="8,0,8,10" Spacing="6">
                            <Border Height="1" Margin="2,0,2,2" Background="{DynamicResource SideBorderBrush}" />
                            <Panel Opacity="{Binding SidebarContentOpacity}">
                                <Panel.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                    </Transitions>
                                </Panel.Transitions>
                                <TextBlock Classes="section-label" Text="{l:Loc Sidebar_Status}" Margin="10,0,10,0"
                                           IsVisible="{Binding !IsSidebarCollapsed}"/>
                            </Panel>

                            <Button Classes="proxy-card" Margin="2,0"
                                    Command="{Binding SelectCliProxyProvidersCommand}"
                                    ToolTip.Tip="{l:Loc Sidebar_CLIProxyAPI_StatusTooltip}"
                                    IsVisible="{Binding !IsSidebarCollapsed}"
                                    Opacity="{Binding SidebarContentOpacity}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                    <Grid Grid.Column="0" Classes="status-indicator" VerticalAlignment="Center">
                                        <Ellipse Classes="status-pulse"
                                                 Fill="{Binding CliProxyServerState, Converter={StaticResource StateToBrush}}"
                                                 IsVisible="{Binding CliProxyServerState, Converter={StaticResource StateIsRunning}}" />
                                        <Ellipse Classes="status-dot"
                                                 Fill="{Binding CliProxyServerState, Converter={StaticResource StateToBrush}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{l:Loc Sidebar_CLIProxyAPI}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <lucide:PackIconLucide Grid.Column="2" Kind="ChevronRight" Width="13" Height="13"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource FgFaintBrush}" />
                                </Grid>
                            </Button>

                            <Button Classes="proxy-card" Margin="2,0"
                                    Command="{Binding SelectPerplexityProvidersCommand}"
                                    ToolTip.Tip="{l:Loc Sidebar_Perplexity_StatusTooltip}"
                                    IsVisible="{Binding !IsSidebarCollapsed}"
                                    Opacity="{Binding SidebarContentOpacity}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                    <Grid Grid.Column="0" Classes="status-indicator" VerticalAlignment="Center">
                                        <Ellipse Classes="status-pulse"
                                                 Fill="{Binding PerplexityServerState, Converter={StaticResource StateToBrush}}"
                                                 IsVisible="{Binding PerplexityServerState, Converter={StaticResource StateIsRunning}}" />
                                        <Ellipse Classes="status-dot"
                                                 Fill="{Binding PerplexityServerState, Converter={StaticResource StateToBrush}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{l:Loc Sidebar_Perplexity}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <lucide:PackIconLucide Grid.Column="2" Kind="ChevronRight" Width="13" Height="13"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource FgFaintBrush}" />
                                </Grid>
                            </Button>

                            <Button Classes="proxy-card" Margin="2,0"
                                    Command="{Binding SelectConfigLocalProxyCommand}"
                                    ToolTip.Tip="{l:Loc Sidebar_ProxyCard_Hint}"
                                    IsVisible="{Binding !IsSidebarCollapsed}"
                                    Opacity="{Binding SidebarContentOpacity}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                    <Grid Grid.Column="0" Classes="status-indicator" VerticalAlignment="Center">
                                        <Ellipse Classes="status-pulse"
                                                 Fill="{Binding FallbackProxyServerState, Converter={StaticResource StateToBrush}}"
                                                 IsVisible="{Binding FallbackProxyServerState, Converter={StaticResource StateIsRunning}}" />
                                        <Ellipse Classes="status-dot"
                                                 Fill="{Binding FallbackProxyServerState, Converter={StaticResource StateToBrush}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{l:Loc Sidebar_ProxyCard_Title}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <lucide:PackIconLucide Grid.Column="2" Kind="ChevronRight" Width="13" Height="13"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource FgFaintBrush}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource SideBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8">
                            <Grid>
                                <Grid ColumnDefinitions="*,Auto"
                                      IsVisible="{Binding !IsSidebarCollapsed}"
                                      Opacity="{Binding SidebarContentOpacity}">
                                    <Grid.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Grid.Transitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{l:LocFormat Key=Sidebar_Version, Path=AppVersion}" FontSize="11"
                                                   Foreground="{DynamicResource FgFaintBrush}" />
                                        <Button Classes="link" Command="{Binding OpenIssueUrlCommand}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{l:Loc Sidebar_ReportIssue}" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Cursor="Hand" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="icon" HorizontalAlignment="Right"
                                            ToolTip.Tip="{l:Loc Sidebar_ToggleThemeTooltip}"
                                            Command="{Binding ToggleThemeCommand}">
                                        <Grid Width="18" Height="18" Classes="theme-icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <lucide:PackIconLucide Kind="Moon" Width="15" Height="15"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding !IsDark}" />
                                            <lucide:PackIconLucide Kind="SunMedium" Width="16" Height="16"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding IsDark}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Button Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSidebarCollapsed}"
                                        ToolTip.Tip="{l:Loc Sidebar_ToggleThemeTooltip}"
                                        Command="{Binding ToggleThemeCommand}">
                                    <Grid Width="18" Height="18" Classes="theme-icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <lucide:PackIconLucide Kind="Moon" Width="15" Height="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                               IsVisible="{Binding !IsDark}" />
                                        <lucide:PackIconLucide Kind="SunMedium" Width="16" Height="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                               IsVisible="{Binding IsDark}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content area -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="SectionHost"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="18,16,18,44" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Delete log file confirmation dialog -->
        <Border IsVisible="{Binding Logs.ShowClearConfirm}"
                Background="#88000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="50">
            <Border Classes="card"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="{l:Loc Dialog_DeleteLogFile_Title}" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="{l:Loc Dialog_DeleteLogFile_Description}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="{l:Loc Dialog_DeleteLogFile_Cancel}"
                                Command="{Binding DismissDeleteLogsConfirmCommand}" />
                        <Button Classes="app danger" Content="{l:Loc Dialog_DeleteLogFile_Delete}"
                                Command="{Binding ConfirmDeleteLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Clear usage history confirmation dialog -->
        <Border IsVisible="{Binding Logs.ShowClearUsageConfirm}"
                Background="#88000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="50">
            <Border Classes="card"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="{l:Loc Dialog_ClearUsageHistory_Title}" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="{l:Loc Dialog_ClearUsageHistory_Description}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="{l:Loc Dialog_ClearUsageHistory_Cancel}"
                                Command="{Binding DismissClearUsageConfirmCommand}" />
                        <Button Classes="app danger" Content="{l:Loc Dialog_ClearUsageHistory_Delete}"
                                Command="{Binding ConfirmClearUsageCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Reset credentials confirmation dialog -->
        <Border IsVisible="{Binding ShowResetCredentialsDialog}"
                Background="#88000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="50">
            <Border Classes="card"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="{l:Loc Dialog_ResetCredentials_Title}" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="{l:Loc Dialog_ResetCredentials_Description}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="{l:Loc Dialog_ResetCredentials_Cancel}"
                                Command="{Binding DismissResetCredentialsDialogCommand}" />
                        <Button Classes="app danger" Content="{l:Loc Dialog_ResetCredentials_Reset}"
                                Command="{Binding ConfirmResetCredentialsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ContentControl x:Name="ApiKeysOverlayHost"
                        IsVisible="{Binding ShowApiKeysDialog}"
                        ZIndex="50" />

        <!-- Add CLIProxy account mode dialog -->
        <Border x:Name="AddAccountModeOverlay" IsVisible="{Binding ShowAddAccountModeDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnAddAccountModeDialogKeyDown" Focusable="True"
                PointerPressed="OnAddAccountOverlayPressed">
            <Border Classes="card" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="row-label" FontSize="16" Text="{l:Loc Dialog_AddAccount_HeaderTitle}" />
                            <TextBlock Classes="row-desc" Text="{l:Loc Dialog_AddAccount_ModeDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissAddAccountDialogCommand}" VerticalAlignment="Top">
                            <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Border Classes="row-divider" />
                    <StackPanel Spacing="8">
                        <Button Classes="app" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8" Command="{Binding AddAccountWithOAuthCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="provider-logo" Background="{DynamicResource AccentSoftBrush}" Width="34" Height="34" Margin="0,0,12,0">
                                    <lucide:PackIconLucide Kind="CircleUserRound" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="row-label" Text="{l:Loc Dialog_AddAccount_OAuthOption}" />
                                    <TextBlock Classes="row-desc" Text="{l:Loc Dialog_AddAccount_OAuthOptionDesc}" />
                                </StackPanel>
                                <lucide:PackIconLucide Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="app" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8" Command="{Binding AddAccountWithApiKeyCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="provider-logo" Background="{DynamicResource AccentSoftBrush}" Width="34" Height="34" Margin="0,0,12,0">
                                    <lucide:PackIconLucide Kind="KeyRound" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="row-label" Text="{l:Loc Dialog_AddAccount_ApiKeyOption}" />
                                    <TextBlock Classes="row-desc" Text="{l:Loc Dialog_AddAccount_ApiKeyOptionDesc}" />
                                </StackPanel>
                                <lucide:PackIconLucide Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add CLIProxy account dialog -->
        <Border x:Name="AddAccountOverlay" IsVisible="{Binding ShowAddAccountDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnAddAccountDialogKeyDown" Focusable="True"
                PointerPressed="OnAddAccountOverlayPressed">
            <Border Classes="card" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="row-label" FontSize="16" Text="{Binding ApiKeyDialogTitle}" />
                            <TextBlock Classes="row-desc" Text="{l:Loc Dialog_AddAccount_ApiKeyDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissAddAccountDialogCommand}" VerticalAlignment="Top">
                            <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Border Classes="row-divider" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc Dialog_AddAccount_ApiKeyLabel}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" x:Name="ApiKeyBox" Classes="app" PasswordChar="{Binding ShowAddAccountApiKey, Converter={StaticResource SecretPasswordChar}}" Watermark="{l:Loc Dialog_AddAccount_ApiKeyPlaceholder}" Text="{Binding AddAccountApiKeyDraft, Mode=TwoWay}" />
                                <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0" ToolTip.Tip="{l:Loc Dialog_AddAccount_ShowHideTooltip}" Command="{Binding ToggleAddAccountApiKeyVisibilityCommand}">
                                    <lucide:PackIconLucide Kind="{Binding ShowAddAccountApiKey, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <Border Classes="row-divider" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="app" Content="{l:Loc Dialog_AddAccount_Cancel}" Command="{Binding DismissAddAccountDialogCommand}" />
                        <Button Classes="app primary" Content="{Binding ApiKeyDialogApplyText}" Click="OnConfirmAddAccount" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add custom OpenAI-compatible provider dialog -->
        <Border x:Name="AddCustomProviderOverlay" IsVisible="{Binding ShowAddCustomProviderDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnAddCustomProviderDialogKeyDown" Focusable="True"
                PointerPressed="OnAddCustomProviderOverlayPressed">
            <Border Classes="card" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="row-label" FontSize="16" Text="{l:Loc Dialog_AddCustomProvider_Title}" />
                            <TextBlock Classes="row-desc" Text="{l:Loc Dialog_AddCustomProvider_Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissAddCustomProviderCommand}" VerticalAlignment="Top">
                            <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Border Classes="row-divider" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc Dialog_AddCustomProvider_NameLabel}" />
                            <TextBox Classes="app" Watermark="{l:Loc Dialog_AddCustomProvider_NamePlaceholder}" Text="{Binding CustomProviderNameDraft, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc Dialog_AddAccount_BaseUrlLabel}" />
                            <TextBox Classes="app" Watermark="{l:Loc Dialog_AddAccount_BaseUrlPlaceholder}" Text="{Binding CustomProviderBaseUrlDraft, Mode=TwoWay}" />
                        </StackPanel>
                        <Border Classes="row-divider" Margin="0,4,0,2" />
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc Dialog_AddAccount_ApiKeyLabel}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Classes="app" PasswordChar="{Binding ShowCustomProviderApiKey, Converter={StaticResource SecretPasswordChar}}" Watermark="{l:Loc Dialog_AddAccount_ApiKeyPlaceholder}" Text="{Binding CustomProviderApiKeyDraft, Mode=TwoWay}" />
                                <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0" ToolTip.Tip="{l:Loc Dialog_AddAccount_ShowHideTooltip}" Command="{Binding ToggleCustomProviderApiKeyVisibilityCommand}">
                                    <lucide:PackIconLucide Kind="{Binding ShowCustomProviderApiKey, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <Border Classes="row-divider" />
                    <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsFetchingCustomProviderModels}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="app" Content="{l:Loc Dialog_AddAccount_Cancel}" Command="{Binding DismissAddCustomProviderCommand}"
                                IsEnabled="{Binding IsFetchingCustomProviderModels, Converter={StaticResource InvertBool}}" />
                        <Button Classes="app primary" Content="{l:Loc Dialog_AddCustomProvider_Add}" Command="{Binding ConfirmAddCustomProviderCommand}"
                                IsEnabled="{Binding IsFetchingCustomProviderModels, Converter={StaticResource InvertBool}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Edit custom provider dialog -->
        <Border x:Name="EditCustomProviderOverlay" IsVisible="{Binding ShowEditCustomProviderDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnEditCustomProviderDialogKeyDown" Focusable="True"
                PointerPressed="OnEditCustomProviderOverlayPressed">
            <Border Classes="card" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="row-label" FontSize="16" Text="{l:Loc Dialog_EditCustomProvider_Title}" />
                            <TextBlock Classes="row-desc" Text="{l:Loc Dialog_AddCustomProvider_Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissEditCustomProviderCommand}" VerticalAlignment="Top">
                            <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Border Classes="row-divider" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc Dialog_AddCustomProvider_NameLabel}" />
                            <TextBox Classes="app" Watermark="{l:Loc Dialog_AddCustomProvider_NamePlaceholder}" Text="{Binding CustomProviderNameDraft, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc Dialog_AddAccount_BaseUrlLabel}" />
                            <TextBox Classes="app" Watermark="{l:Loc Dialog_AddAccount_BaseUrlPlaceholder}" Text="{Binding CustomProviderBaseUrlDraft, Mode=TwoWay}" />
                        </StackPanel>
                        <Border Classes="row-divider" Margin="0,4,0,2" />
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc Dialog_AddAccount_ApiKeyLabel}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Classes="app" PasswordChar="{Binding ShowCustomProviderApiKey, Converter={StaticResource SecretPasswordChar}}" Watermark="{l:Loc Dialog_AddAccount_ApiKeyPlaceholder}" Text="{Binding CustomProviderApiKeyDraft, Mode=TwoWay}" />
                                <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0" ToolTip.Tip="{l:Loc Dialog_AddAccount_ShowHideTooltip}" Command="{Binding ToggleCustomProviderApiKeyVisibilityCommand}">
                                    <lucide:PackIconLucide Kind="{Binding ShowCustomProviderApiKey, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <Border Classes="row-divider" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="app" Content="{l:Loc Dialog_AddAccount_Cancel}" Command="{Binding DismissEditCustomProviderCommand}" />
                        <Button Classes="app primary" Content="{l:Loc Dialog_EditCustomProvider_Save}" Command="{Binding ConfirmEditCustomProviderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Custom provider model selection dialog -->
        <Border x:Name="CustomProviderModelsOverlay" IsVisible="{Binding ShowCustomProviderModelsDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnCustomProviderModelsDialogKeyDown" Focusable="True"
                PointerPressed="OnCustomProviderModelsOverlayPressed">
            <Border Classes="card" Width="480" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="row-label" FontSize="16" Text="{l:Loc Dialog_CustomProviderModels_Title}" />
                            <TextBlock Classes="row-desc" Text="{l:Loc Dialog_CustomProviderModels_Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissCustomProviderModelsCommand}" VerticalAlignment="Top">
                            <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Border DockPanel.Dock="Top" Classes="row-divider" Margin="0,12" />
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBox Grid.Column="0" Classes="app" Watermark="{l:Loc Dialog_CustomProviderModels_SearchWatermark}"
                                 Height="26" MinHeight="26" Padding="8,3" VerticalAlignment="Center"
                                 Text="{Binding CustomProviderModelSearch, Mode=TwoWay}" />
                        <CheckBox Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" IsThreeState="False"
                                  Content="{l:Loc Dialog_CustomProviderModels_SelectAll}"
                                  IsChecked="{Binding AllVisibleCustomProviderModelsSelected, Mode=TwoWay}" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                        <TextBlock Grid.Column="0" Classes="row-desc" VerticalAlignment="Center"
                                   Text="{Binding CustomProviderModelsSelectedLabel}" />
                        <Button Grid.Column="1" Classes="app" Margin="0,0,8,0"
                                Content="{l:Loc Dialog_AddAccount_Cancel}" Command="{Binding DismissCustomProviderModelsCommand}" />
                        <Button Grid.Column="2" Classes="app primary"
                                Content="{l:Loc Dialog_AddCustomProvider_Add}" Command="{Binding ConfirmCustomProviderModelsCommand}"
                                IsVisible="{Binding !IsEditingCustomProviderModels}"
                                IsEnabled="{Binding CanConfirmCustomProviderModels}" />
                        <Button Grid.Column="2" Classes="app primary"
                                Content="{l:Loc Dialog_EditCustomProvider_Save}" Command="{Binding ConfirmCustomProviderModelsCommand}"
                                IsVisible="{Binding IsEditingCustomProviderModels}"
                                IsEnabled="{Binding CanConfirmCustomProviderModels}" />
                    </Grid>
                    <TextBlock Classes="row-desc" Margin="2,8"
                               Text="{l:Loc AgentConfigOverlay_NoModelSearchResults}"
                               IsVisible="{Binding ShowNoCustomProviderModelResults}" />
                    <ListBox ItemsSource="{Binding VisibleCustomProviderModels}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SelectableModelViewModel">
                                <Grid ColumnDefinitions="Auto,*" Margin="2,3">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>

        <!-- Add Perplexity account dialog -->
        <Border x:Name="PerplexityAccountOverlay" IsVisible="{Binding ShowPerplexityAccountDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnPerplexityAccountDialogKeyDown" Focusable="True"
                PointerPressed="OnPerplexityAccountOverlayPressed">
            <Border Classes="card" Width="440" MinHeight="150" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <Grid>
                    <StackPanel Spacing="14" IsVisible="{Binding IsPerplexityTokenGenerationMode, Converter={StaticResource InvertBool}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="row-label" FontSize="15" Text="{l:Loc Dialog_AddPerplexity_Title}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" Command="{Binding DismissPerplexityAccountDialogCommand}" VerticalAlignment="Center">
                                <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                            </Button>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="row-desc" Text="{l:Loc Dialog_AddPerplexity_LabelLabel}" />
                            <TextBox x:Name="PerplexityLabelBox" Classes="app" Watermark="{l:Loc Dialog_AddPerplexity_LabelPlaceholder}"
                                     KeyDown="OnPerplexityAccountInputKeyDown" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="row-desc" Text="{l:Loc Dialog_AddPerplexity_TokenLabel}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" x:Name="PerplexitySessionTokenBox" Classes="app"
                                         PasswordChar="{Binding ShowPerplexitySessionToken, Converter={StaticResource SecretPasswordChar}}"
                                         Watermark="{l:Loc Dialog_AddPerplexity_TokenPlaceholder}"
                                         Text="{Binding PerplexitySessionTokenDraft, Mode=TwoWay}"
                                         KeyDown="OnPerplexityAccountInputKeyDown" />
                                <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0"
                                        ToolTip.Tip="{l:Loc Dialog_AddPerplexity_ShowHideTooltip}"
                                        Command="{Binding TogglePerplexitySessionTokenVisibilityCommand}">
                                    <lucide:PackIconLucide Kind="{Binding ShowPerplexitySessionToken, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="row-desc" TextWrapping="Wrap"
                                   Text="{l:Loc Dialog_AddPerplexity_Description}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Classes="app" Content="{l:Loc Dialog_AddPerplexity_GenerateToken}" Click="OnStartPerplexityTokenFlow" />
                            <Button Classes="app" Content="{l:Loc Dialog_AddPerplexity_Cancel}" Command="{Binding DismissPerplexityAccountDialogCommand}" />
                            <Button Classes="app primary" Content="{l:Loc Dialog_AddPerplexity_Save}" Click="OnConfirmPerplexityAccount" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsPerplexityTokenGenerationMode}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="row-label" FontSize="15" Text="{l:Loc Dialog_GeneratePerplexityToken_Title}" />
                            <TextBlock Grid.Column="1" Classes="row-desc" Text="{Binding PerplexityTokenStepLabel}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Classes="icon" Command="{Binding DismissPerplexityAccountDialogCommand}" VerticalAlignment="Top">
                                <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="row-desc" Text="{Binding PerplexityTokenPrompt}" TextWrapping="Wrap"
                                   IsVisible="{Binding !PerplexityTokenHasError}" />
                        <TextBlock Classes="row-desc" Text="{Binding PerplexityTokenDetail}" TextWrapping="Wrap"
                                   IsVisible="{Binding !PerplexityTokenHasError}" />
                        <Border Classes="alert error" IsVisible="{Binding PerplexityTokenHasError}">
                            <Grid ColumnDefinitions="Auto,*">
                                <lucide:PackIconLucide Grid.Column="0" Kind="TriangleAlert" Width="18" Height="18"
                                                       Foreground="{DynamicResource ErrBrush}" VerticalAlignment="Top" Margin="0,1,9,0" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="alert-title" Text="{l:Loc Dialog_GeneratePerplexityToken_Failed}" />
                                    <TextBlock Classes="alert-body" Text="{Binding PerplexityTokenDetail}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBox x:Name="PerplexityTokenFlowInputBox" Classes="app"
                                 Watermark="{Binding PerplexityTokenInputWatermark}"
                                 IsEnabled="{Binding IsPerplexityTokenFlowBusy, Converter={StaticResource InvertBool}}"
                                 KeyDown="OnPerplexityTokenFlowInputKeyDown" />
                        <ProgressBar IsIndeterminate="True" Height="6"
                                     IsVisible="{Binding IsPerplexityTokenFlowBusy}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Classes="app" Content="{l:Loc Dialog_GeneratePerplexityToken_Back}" Command="{Binding CancelPerplexityTokenFlowCommand}" />
                            <Button Classes="app primary" Content="{Binding PerplexityTokenContinueLabel}" Click="OnSubmitPerplexityTokenFlow" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Edit Perplexity account label dialog -->
        <Border IsVisible="{Binding ShowEditPerplexityLabelDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                PointerPressed="OnEditPerplexityLabelOverlayPressed"
                KeyDown="OnEditPerplexityLabelKeyDown" Focusable="True">
            <Border Classes="card" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="row-label" FontSize="15" Text="{l:Loc Dialog_EditPerplexityLabel_Title}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissEditPerplexityLabelDialogCommand}" VerticalAlignment="Center">
                            <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="{l:Loc Dialog_EditPerplexityLabel_LabelLabel}" />
                        <TextBox x:Name="EditPerplexityLabelBox" Classes="app" Watermark="{l:Loc Dialog_EditPerplexityLabel_LabelPlaceholder}"
                                 Text="{Binding EditPerplexityLabelDraft, Mode=TwoWay}"
                                 KeyDown="OnEditPerplexityLabelKeyDown" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="{l:Loc Dialog_EditPerplexityLabel_Cancel}" Command="{Binding DismissEditPerplexityLabelDialogCommand}" />
                        <Button Classes="app primary" Content="{l:Loc Dialog_EditPerplexityLabel_Save}" Command="{Binding ConfirmEditPerplexityLabelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Reset Perplexity accounts confirmation dialog -->
        <Border IsVisible="{Binding ShowResetPerplexityDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50">
            <Border Classes="card" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="{l:Loc Dialog_ResetPerplexity_Title}" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="{l:Loc Dialog_ResetPerplexity_Description}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="{l:Loc Dialog_ResetPerplexity_Cancel}" Command="{Binding DismissResetPerplexityDialogCommand}" />
                        <Button Classes="app danger" Content="{l:Loc Dialog_ResetPerplexity_Reset}" Command="{Binding ConfirmResetPerplexityAccountsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ContentControl x:Name="AgentConfigOverlayHost"
                        IsVisible="{Binding ShowAgentConfigDialog}"
                        ZIndex="50" />

        <!-- Update toasts -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Spacing="8"
                    ZIndex="50">
            <Border ctrl:Toast.IsOpen="{Binding AppUpdateAvailable}" IsVisible="False" Opacity="0"
                    Classes="alert" Width="420">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <lucide:PackIconLucide Grid.Column="0" Kind="Info" Width="19" Height="19"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="alert-title" Text="{l:Loc Toast_AppUpdateAvailable_Title}"/>
                        <TextBlock Classes="alert-body"
                                   Text="{l:LocFormat Key=Toast_AppUpdateAvailable_Version, Path=AppUpdateNewVersion}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Classes="app primary" Content="{l:Loc Toast_AppUpdateAvailable_Download}" Command="{Binding DownloadAppUpdateCommand}" />
                        <Button Classes="app" Content="{l:Loc Toast_AppUpdateAvailable_Dismiss}" Command="{Binding DismissAppUpdateCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border ctrl:Toast.IsOpen="{Binding ShowUpdateToast}" IsVisible="False" Opacity="0"
                    Classes="alert" Width="420">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <lucide:PackIconLucide Grid.Column="0" Kind="Info" Width="19" Height="19"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="alert-title"
                                   Text="{l:Loc Toast_EngineUpdateAvailable_Title}"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                        <TextBlock Classes="alert-body"
                                   Text="{Binding UpdateToastText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Classes="app primary" Content="{l:Loc Toast_EngineUpdateAvailable_Update}" Command="{Binding UpdateToastEngineCommand}" />
                        <Button Classes="app" Content="{l:Loc Toast_EngineUpdateAvailable_Dismiss}" Command="{Binding DismissToastCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Window-pinned status toasts (info / error), stacked top-right -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,20,0" Spacing="8" ZIndex="60">

            <!-- Provider status toast (info / error) -->
            <Border ctrl:Toast.IsOpen="{Binding ShowOAuthStatus}" IsVisible="False" Opacity="0" Classes="alert" Classes.error="{Binding OAuthStatusIsError}" MaxWidth="460">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <lucide:PackIconLucide Grid.Column="0" Kind="TriangleAlert" Width="19" Height="19"
                                           Foreground="{DynamicResource ErrBrush}" VerticalAlignment="Top" Margin="0,1,10,0"
                                           IsVisible="{Binding OAuthStatusIsError}" />
                    <lucide:PackIconLucide Grid.Column="0" Kind="Info" Width="19" Height="19"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0"
                                           IsVisible="{Binding !OAuthStatusIsError}" />
                    <StackPanel Grid.Column="1" Spacing="8" MaxWidth="370" VerticalAlignment="Center">
                        <TextBlock Classes="alert-body" Text="{Binding OAuthStatusMessage}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding OAuthStatusHasUrl}">
                            <Border Classes="endpoint" VerticalAlignment="Center" MaxWidth="320">
                                <TextBlock Text="{Binding OAuthStatusUrl}"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Classes="icon-btn copy-endpoint"
                                    Classes.copied="{Binding OAuthUrlCopied}"
                                    ToolTip.Tip="{l:Loc OAuth_Status_CopyUrl}"
                                    Click="OnCopyOAuthUrl">
                                <Panel>
                                    <lucide:PackIconLucide Kind="Copy" Width="13" Height="13" IsVisible="{Binding !OAuthUrlCopied}" />
                                    <lucide:PackIconLucide Kind="Check" Width="13" Height="13" IsVisible="{Binding OAuthUrlCopied}" />
                                </Panel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon-btn" Margin="10,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DismissOAuthStatusCommand}">
                        <lucide:PackIconLucide Kind="X" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Configuration status toast (info / error) -->
            <Border ctrl:Toast.IsOpen="{Binding ShowConfigurationStatus}" IsVisible="False" Opacity="0" Classes="alert" Classes.error="{Binding ConfigurationStatusIsError}" MaxWidth="460">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <lucide:PackIconLucide Grid.Column="0" Kind="TriangleAlert" Width="19" Height="19"
                                           Foreground="{DynamicResource ErrBrush}" VerticalAlignment="Top" Margin="0,1,10,0"
                                           IsVisible="{Binding ConfigurationStatusIsError}" />
                    <lucide:PackIconLucide Grid.Column="0" Kind="Info" Width="19" Height="19"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0"
                                           IsVisible="{Binding !ConfigurationStatusIsError}" />
                    <TextBlock Grid.Column="1" Classes="alert-body" Text="{Binding ConfigurationStatusMessage}"
                               VerticalAlignment="Center" MaxWidth="370" />
                    <Button Grid.Column="2" Classes="icon-btn" Margin="10,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DismissConfigurationStatusCommand}">
                        <lucide:PackIconLucide Kind="X" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Management key repaired toast -->
            <Border ctrl:Toast.IsOpen="{Binding ShowManagementKeyRepairedToast}" IsVisible="False" Opacity="0" Classes="alert" MaxWidth="460">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <lucide:PackIconLucide Grid.Column="0" Kind="Info" Width="19" Height="19"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Classes="alert-body" Text="{l:Loc Toast_ManagementKeyRepaired}"
                               VerticalAlignment="Center" MaxWidth="370" />
                    <Button Grid.Column="2" Classes="icon-btn" Margin="10,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DismissManagementKeyRepairedToastCommand}">
                        <lucide:PackIconLucide Kind="X" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Engine 'no update available' toast -->
            <Border ctrl:Toast.IsOpen="{Binding ShowNoUpdateToast}" IsVisible="False" Opacity="0" Classes="alert" MaxWidth="460">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <lucide:PackIconLucide Grid.Column="0" Kind="Info" Width="19" Height="19"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Classes="alert-body" Text="{l:Loc Toast_NoUpdateAvailable}"
                               VerticalAlignment="Center" MaxWidth="370" />
                    <Button Grid.Column="2" Classes="icon-btn" Margin="10,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DismissNoUpdateToastCommand}">
                        <lucide:PackIconLucide Kind="X" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- App 'no update available' toast -->
            <Border ctrl:Toast.IsOpen="{Binding ShowAppNoUpdateToast}" IsVisible="False" Opacity="0" Classes="alert" MaxWidth="460">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <lucide:PackIconLucide Grid.Column="0" Kind="Info" Width="19" Height="19"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Classes="alert-body" Text="{l:Loc Toast_AppNoUpdateAvailable}"
                               VerticalAlignment="Center" MaxWidth="370" />
                    <Button Grid.Column="2" Classes="icon-btn" Margin="10,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DismissAppNoUpdateToastCommand}">
                        <lucide:PackIconLucide Kind="X" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

        </StackPanel>

        </Panel>
    </Border>
</Window>
