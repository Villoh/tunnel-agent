<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TunnelAgent.ViewModels"
        xmlns:v="using:TunnelAgent.Views"
        xmlns:cv="using:TunnelAgent.Converters"
        xmlns:lucide="using:IconPacks.Avalonia.Lucide"
        xmlns:svc="using:TunnelAgent.Services"
        xmlns:svg="using:Avalonia.Svg.Skia"
        x:Class="TunnelAgent.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="Tunnel Agent"
        Icon="/Assets/logo.ico"
        Width="820" Height="620"
        MinWidth="600" MinHeight="500"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource WinBgBrush}">
    <Window.Resources>
        <cv:ServerStateToTextConverter  x:Key="StateToText" />
        <cv:ServerStateToBrushConverter x:Key="StateToBrush" />
        <cv:ServerStateRunningConverter x:Key="StateIsRunning" />
        <cv:SectionEqualsConverter      x:Key="SectionEq" />
        <cv:SidebarWidthConverter       x:Key="SidebarWidth" />
        <cv:InvertBoolConverter         x:Key="InvertBool" />
        <cv:StringNotEmptyConverter     x:Key="StringNotEmpty" />
        <cv:HexToBrushConverter         x:Key="HexBrush" />
        <cv:SvgImageConverter           x:Key="SvgImage" />
        <cv:SecretPasswordCharConverter x:Key="SecretPasswordChar" />
        <cv:BoolToEyeIconConverter      x:Key="EyeIcon" />
        <cv:IntGreaterThanZeroConverter  x:Key="IntGtZero" />
    </Window.Resources>

    <Border Background="{DynamicResource WinBgBrush}"
            BorderBrush="{DynamicResource WinBorderBrush}"
            BorderThickness="0"
            CornerRadius="0"
            ClipToBounds="True">
        <Panel>
        <Grid RowDefinitions="38,*">
            <!-- Custom titlebar -->
            <Grid Grid.Row="0" PointerPressed="OnTitlebarPressed"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource WinBorderBrush}" Opacity="0.8" />


                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Classes="traffic minimize" ToolTip.Tip="Minimize" Click="OnMinimize">
                        <lucide:PackIconLucide Kind="Minus" Width="8" Height="8" Foreground="Black" />
                    </Button>
                    <Button Classes="traffic maximize" ToolTip.Tip="Maximize / Restore" Click="OnMaximizeRestore">
                        <lucide:PackIconLucide Kind="Maximize2" Width="8" Height="8" Foreground="Black" />
                    </Button>
                    <Button Classes="traffic close" ToolTip.Tip="Close" Click="OnClose">
                        <lucide:PackIconLucide Kind="X" Width="8" Height="8" Foreground="Black" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body: sidebar + content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Width="{Binding SidebarWidth}"
                        Background="{DynamicResource SideBgBrush}"
                        BorderBrush="{DynamicResource SideBorderBrush}"
                        BorderThickness="0,0,1,0"
                        ClipToBounds="True">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseInOut" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <StackPanel Grid.Row="0" Margin="8,10,8,0" Spacing="2">
                            <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                                <Panel Grid.ColumnSpan="2"
                                       Opacity="{Binding SidebarContentOpacity}">
                                    <Panel.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Panel.Transitions>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                        <Image Source="/Assets/logo-20.png" Width="16" Height="16"
                                               VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <TextBlock FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center">
                                            <Run Text="Tunnel" FontWeight="Bold" />
                                            <Run Text="Agent" />
                                        </TextBlock>
                                    </StackPanel>
                                </Panel>
                                <!-- Single toggle button with flip animation -->
                                <Button Grid.Column="1" Classes="icon" Width="24" Height="24"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ToolTip.Tip="Toggle sidebar"
                                        Command="{Binding ToggleSidebarCommand}">
                                    <Panel Width="15" Height="15"
                                           RenderTransformOrigin="50%,50%">
                                        <Panel.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding SidebarToggleIconScaleX}">
                                                <ScaleTransform.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="ScaleX" Duration="0:0:0.22" Easing="CubicEaseInOut" />
                                                    </Transitions>
                                                </ScaleTransform.Transitions>
                                            </ScaleTransform>
                                        </Panel.RenderTransform>
                                        <lucide:PackIconLucide Kind="PanelLeftClose" Width="15" Height="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}" />
                                    </Panel>
                                </Button>
                            </Grid>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Providers}"
                                    Command="{Binding SelectProvidersCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Server" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Providers" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding ConnectedProviderCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Quota}"
                                    Command="{Binding SelectQuotaCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="ChartBar" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Quota" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding QuotaProviderCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side"
                                    Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Agents}"
                                    Command="{Binding SelectAgentsCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Bot" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Agents" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding ConfiguredAgentCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side" Classes.selected="{Binding IsConfigSection}"
                                    Command="{Binding SelectConfigurationCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Settings" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Configuration" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Ellipse HorizontalAlignment="Right" Width="7" Height="7"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Margin="4,0,0,0"
                                                 IsVisible="{Binding ConfigHasBadge}" />
                                    </Panel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="8,0,8,10" Spacing="6">
                            <Panel Opacity="{Binding SidebarContentOpacity}">
                                <Panel.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                    </Transitions>
                                </Panel.Transitions>
                                <TextBlock Classes="section-label" Text="STATUS" Margin="10,0,10,0"
                                           IsVisible="{Binding !IsSidebarCollapsed}"/>
                            </Panel>

                            <Grid Margin="10,0" ColumnDefinitions="Auto,*">
                                <Grid Grid.Column="0" Classes="status-indicator">
                                    <Ellipse Classes="status-pulse"
                                             Fill="{Binding CliProxyServerState, Converter={StaticResource StateToBrush}}"
                                             IsVisible="{Binding CliProxyServerState, Converter={StaticResource StateIsRunning}}" />
                                    <Ellipse Classes="status-dot"
                                             Fill="{Binding CliProxyServerState, Converter={StaticResource StateToBrush}}" />
                                </Grid>
                                <Panel Grid.Column="1"
                                       Opacity="{Binding SidebarContentOpacity}">
                                    <Panel.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Panel.Transitions>
                                    <TextBlock Text="CLIProxyAPI" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource FgBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsSidebarCollapsed}" />
                                </Panel>
                            </Grid>

                            <Grid Margin="10,0" ColumnDefinitions="Auto,*">
                                <Grid Grid.Column="0" Classes="status-indicator">
                                    <Ellipse Classes="status-pulse"
                                             Fill="{Binding PerplexityServerState, Converter={StaticResource StateToBrush}}"
                                             IsVisible="{Binding PerplexityServerState, Converter={StaticResource StateIsRunning}}" />
                                    <Ellipse Classes="status-dot"
                                             Fill="{Binding PerplexityServerState, Converter={StaticResource StateToBrush}}" />
                                </Grid>
                                <Panel Grid.Column="1"
                                       Opacity="{Binding SidebarContentOpacity}">
                                    <Panel.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Panel.Transitions>
                                    <TextBlock Text="Perplexity" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource FgBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsSidebarCollapsed}" />
                                </Panel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource SideBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8">
                            <Grid>
                                <Grid ColumnDefinitions="*,Auto"
                                      IsVisible="{Binding !IsSidebarCollapsed}"
                                      Opacity="{Binding SidebarContentOpacity}">
                                    <Grid.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Grid.Transitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding AppVersion, StringFormat='v{0} · MIT'}" FontSize="11"
                                                   Foreground="{DynamicResource FgFaintBrush}" />
                                        <Button Classes="link" Command="{Binding OpenIssueUrlCommand}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="Report an issue" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Cursor="Hand" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="icon" HorizontalAlignment="Right"
                                            ToolTip.Tip="Toggle light / dark mode"
                                            Command="{Binding ToggleThemeCommand}">
                                        <Grid Width="18" Height="18" Classes="theme-icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <lucide:PackIconLucide Kind="Moon" Width="15" Height="15"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding !IsDark}" />
                                            <lucide:PackIconLucide Kind="SunMedium" Width="16" Height="16"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding IsDark}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Button Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSidebarCollapsed}"
                                        ToolTip.Tip="Toggle light / dark mode"
                                        Command="{Binding ToggleThemeCommand}">
                                    <Grid Width="18" Height="18" Classes="theme-icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <lucide:PackIconLucide Kind="Moon" Width="15" Height="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                               IsVisible="{Binding !IsDark}" />
                                        <lucide:PackIconLucide Kind="SunMedium" Width="16" Height="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                               IsVisible="{Binding IsDark}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content area -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl HorizontalContentAlignment="Stretch" Padding="18,16,18,44">
                        <ContentControl.Content>
                            <Grid>
                                <v:ProvidersView IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Providers}" />
                                <v:QuotaView IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Quota}" />
                                <v:AgentsView IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Agents}" />
                                <v:ConfigurationView IsVisible="{Binding IsConfigSection}" />
                            </Grid>
                        </ContentControl.Content>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Reset credentials confirmation dialog -->
        <Border IsVisible="{Binding ShowResetCredentialsDialog}"
                Background="#88000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="50">
            <Border Classes="card"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="Reset all credentials?" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="This backs up and removes Tunnel Agent-managed OAuth tokens and custom provider keys. Other JSON files in the auth folder are preserved." />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel"
                                Command="{Binding DismissResetCredentialsDialogCommand}" />
                        <Button Classes="app danger" Content="Reset credentials"
                                Command="{Binding ConfirmResetCredentialsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- CLIProxy API keys dialog -->
        <Border x:Name="ApiKeysOverlay" IsVisible="{Binding ShowApiKeysDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnApiKeysDialogKeyDown" Focusable="True"
                PointerPressed="OnApiKeysOverlayPressed">
            <Border Classes="card" Width="480" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0"
                    PointerPressed="OnDialogCardPressed">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Margin="24,20,24,14" Spacing="4">
                        <TextBlock Classes="row-label" FontSize="15" Text="CLIProxyAPI keys" />
                        <TextBlock Classes="row-desc" TextWrapping="Wrap"
                                   Text="Keys accepted by CLIProxyAPI clients. Agent setup uses the default key; leave empty for no auth." />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Margin="24,0,24,0">
                            <ItemsControl ItemsSource="{Binding CliProxyApiKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CliProxyApiKeyViewModel">
                                        <Border Background="{DynamicResource SideBgBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Masked}"
                                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                                               FontSize="12" VerticalAlignment="Center" />
                                                    <Border Classes="chip" Background="{DynamicResource AccentSoftBrush}"
                                                            IsVisible="{Binding IsDefault}">
                                                        <TextBlock Text="default" Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                                                    </Border>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="app" Content="Use"
                                                        Margin="8,0,4,0" Padding="8,0"
                                                        Height="24" MinHeight="0"
                                                        VerticalContentAlignment="Center"
                                                        IsVisible="{Binding CanSetDefault}"
                                                        Command="{Binding #Root.DataContext.SetDefaultApiKeyCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Classes="icon-btn"
                                                        ToolTip.Tip="Remove key"
                                                        IsVisible="{Binding CanRemove}"
                                                        Command="{Binding #Root.DataContext.RemoveApiKeyCommand}"
                                                        CommandParameter="{Binding}">
                                                    <lucide:PackIconLucide Kind="Trash2" Width="13" Height="13"
                                                                           Foreground="{DynamicResource FgMutedBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="row-desc" Text="Add key" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Classes="app"
                                             PasswordChar="{Binding ShowApiKeyDraft, Converter={StaticResource SecretPasswordChar}}"
                                             Watermark="sk-..."
                                             Text="{Binding ApiKeyDraft, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0"
                                            ToolTip.Tip="Show/hide key"
                                            Command="{Binding ToggleApiKeyDraftVisibilityCommand}">
                                        <lucide:PackIconLucide Kind="{Binding ShowApiKeyDraft, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="24,14,24,20">
                        <Button Classes="app" Content="Close" Command="{Binding DismissApiKeysCommand}" />
                        <Button Classes="app primary" Content="Add key" Command="{Binding AddApiKeyCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Add CLIProxy account dialog -->
        <Border IsVisible="{Binding ShowAddAccountDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50">
            <Border Classes="card" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="{Binding AddAccountTarget.Name, StringFormat='Add account — {0}'}" />
                    <StackPanel Spacing="4" IsVisible="{Binding AddAccountTarget.IsOAuth, Converter={StaticResource InvertBool}, FallbackValue=False}">
                        <TextBlock Classes="row-desc" Text="Base URL" />
                        <TextBox x:Name="BaseUrlBox" Classes="app" Watermark="https://api.example.com/v1" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="API Key" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" x:Name="ApiKeyBox" Classes="app"
                                     PasswordChar="{Binding ShowAddAccountApiKey, Converter={StaticResource SecretPasswordChar}}"
                                     Watermark="sk-..."
                                     Text="{Binding AddAccountApiKeyDraft, Mode=TwoWay}" />
                            <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0"
                                    ToolTip.Tip="Show/hide key"
                                    Command="{Binding ToggleAddAccountApiKeyVisibilityCommand}">
                                <lucide:PackIconLucide Kind="{Binding ShowAddAccountApiKey, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="Label (optional)" />
                        <TextBox x:Name="LabelBox" Classes="app" Watermark="My account" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel" Command="{Binding DismissAddAccountDialogCommand}" />
                        <Button Classes="app primary" Content="Add Account" Click="OnConfirmAddAccount" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add Perplexity account dialog -->
        <Border x:Name="PerplexityAccountOverlay" IsVisible="{Binding ShowPerplexityAccountDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnPerplexityAccountDialogKeyDown" Focusable="True"
                PointerPressed="OnPerplexityAccountOverlayPressed">
            <Border Classes="card" Width="440" MinHeight="150" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <Grid>
                    <StackPanel Spacing="14" IsVisible="{Binding IsPerplexityTokenGenerationMode, Converter={StaticResource InvertBool}}">
                        <TextBlock Classes="row-label" FontSize="15" Text="Add Perplexity account" />
                        <StackPanel Spacing="4">
                            <TextBlock Classes="row-desc" Text="Label (optional)" />
                            <TextBox x:Name="PerplexityLabelBox" Classes="app" Watermark="Primary"
                                     KeyDown="OnPerplexityAccountInputKeyDown" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="row-desc" Text="Session token" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" x:Name="PerplexitySessionTokenBox" Classes="app"
                                         PasswordChar="{Binding ShowPerplexitySessionToken, Converter={StaticResource SecretPasswordChar}}"
                                         Watermark="pplx-session-token"
                                         Text="{Binding PerplexitySessionTokenDraft, Mode=TwoWay}"
                                         KeyDown="OnPerplexityAccountInputKeyDown" />
                                <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0"
                                        ToolTip.Tip="Show/hide token"
                                        Command="{Binding TogglePerplexitySessionTokenVisibilityCommand}">
                                    <lucide:PackIconLucide Kind="{Binding ShowPerplexitySessionToken, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="row-desc" TextWrapping="Wrap"
                                   Text="Paste your Perplexity WebUI session token, or generate one via email verification." />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Classes="app" Content="Generate Token" Click="OnStartPerplexityTokenFlow" />
                            <Button Classes="app" Content="Cancel" Command="{Binding DismissPerplexityAccountDialogCommand}" />
                            <Button Classes="app primary" Content="Save Account" Click="OnConfirmPerplexityAccount" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsPerplexityTokenGenerationMode}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="row-label" FontSize="15" Text="Generate Perplexity token" />
                            <TextBlock Grid.Column="1" Classes="row-desc" Text="{Binding PerplexityTokenStepLabel}" />
                        </Grid>
                        <TextBlock Classes="row-desc" Text="{Binding PerplexityTokenPrompt}" TextWrapping="Wrap"
                                   IsVisible="{Binding !PerplexityTokenHasError}" />
                        <TextBlock Classes="row-desc" Text="{Binding PerplexityTokenDetail}" TextWrapping="Wrap"
                                   IsVisible="{Binding !PerplexityTokenHasError}" />
                        <Border Classes="alert error" IsVisible="{Binding PerplexityTokenHasError}">
                            <Grid ColumnDefinitions="Auto,*">
                                <lucide:PackIconLucide Grid.Column="0" Kind="TriangleAlert" Width="16" Height="16"
                                                       Foreground="{DynamicResource ErrBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="alert-title" Text="Token generation failed" />
                                    <TextBlock Classes="alert-body" Text="{Binding PerplexityTokenDetail}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBox x:Name="PerplexityTokenFlowInputBox" Classes="app"
                                 Watermark="{Binding PerplexityTokenInputWatermark}"
                                 IsEnabled="{Binding IsPerplexityTokenFlowBusy, Converter={StaticResource InvertBool}}"
                                 KeyDown="OnPerplexityTokenFlowInputKeyDown" />
                        <ProgressBar IsIndeterminate="True" Height="6"
                                     IsVisible="{Binding IsPerplexityTokenFlowBusy}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Classes="app" Content="Back" Command="{Binding CancelPerplexityTokenFlowCommand}" />
                            <Button Classes="app primary" Content="{Binding PerplexityTokenContinueLabel}" Click="OnSubmitPerplexityTokenFlow" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Edit Perplexity account label dialog -->
        <Border IsVisible="{Binding ShowEditPerplexityLabelDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                PointerPressed="OnEditPerplexityLabelOverlayPressed"
                KeyDown="OnEditPerplexityLabelKeyDown" Focusable="True">
            <Border Classes="card" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="Edit Perplexity account label" />
                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="Label" />
                        <TextBox x:Name="EditPerplexityLabelBox" Classes="app" Watermark="Primary"
                                 Text="{Binding EditPerplexityLabelDraft, Mode=TwoWay}"
                                 KeyDown="OnEditPerplexityLabelKeyDown" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel" Command="{Binding DismissEditPerplexityLabelDialogCommand}" />
                        <Button Classes="app primary" Content="Save" Command="{Binding ConfirmEditPerplexityLabelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Reset Perplexity accounts confirmation dialog -->
        <Border IsVisible="{Binding ShowResetPerplexityDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50">
            <Border Classes="card" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="Reset Perplexity accounts?" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="This backs up and removes all saved Perplexity WebUI session token files." />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel" Command="{Binding DismissResetPerplexityDialogCommand}" />
                        <Button Classes="app danger" Content="Reset accounts" Command="{Binding ConfirmResetPerplexityAccountsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Agent config dialog -->
        <Border x:Name="AgentConfigOverlay" IsVisible="{Binding ShowAgentConfigDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Padding="20" ZIndex="50"
                KeyDown="OnAgentConfigDialogKeyDown" Focusable="True"
                PointerPressed="OnAgentConfigOverlayPressed">
            <Border Classes="card" Width="580" MaxHeight="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0"
                    PointerPressed="OnDialogCardPressed">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="18,14" ColumnDefinitions="Auto,*,Auto">
                        <lucide:PackIconLucide Grid.Column="0" Kind="Bot" Width="20" Height="20"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0"
                                              Foreground="{DynamicResource FgMutedBrush}" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                            <TextBlock Classes="row-label" FontSize="14"
                                       Text="{Binding AgentConfigDialogTitle}" />
                            <TextBlock Classes="row-desc"
                                       Text="{Binding AgentConfigDialogDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top"
                                Command="{Binding DismissAgentConfigCommand}">
                            <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Classes="row-divider" />

                    <!-- Body -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14" Margin="18,14,18,24">

                            <!-- Pre-result view -->
                            <StackPanel Spacing="12" IsVisible="{Binding !AgentConfigHasResult}">

                                <!-- Single agent summary -->
                                <Border Classes="card" Padding="12,10"
                                        IsVisible="{Binding ShowSingleAgentSummary}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Panel Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                            <Image Source="{Binding AgentConfigTarget.IconAssetPath, Converter={StaticResource SvgImage}}"
                                                   Width="22" Height="22"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding AgentConfigTarget.HasIcon}" />
                                            <Panel IsVisible="{Binding AgentConfigTarget.HasIcon, Converter={StaticResource InvertBool}}">
                                                <Border Width="28" Height="28" CornerRadius="14"
                                                        Background="{Binding AgentConfigTarget.AccentHex, Converter={StaticResource HexBrush}}"
                                                        Opacity="0.15" />
                                                <TextBlock Text="{Binding AgentConfigTarget.Initials}"
                                                           Foreground="{Binding AgentConfigTarget.AccentHex, Converter={StaticResource HexBrush}}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Panel>
                                        </Panel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                            <TextBlock Text="{Binding AgentConfigTarget.Name}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AgentConfigTarget.BinaryPath}"
                                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Bulk agent picker -->
                                <StackPanel Spacing="6" IsVisible="{Binding ShowAgentConfigAgentPicker}">
                                    <TextBlock Classes="section-label" Text="AGENTS" Margin="2,0" />
                                    <ItemsControl ItemsSource="{Binding InstalledAgents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" Margin="0,0,0,3"
                                                        Background="{DynamicResource SideBgBrush}"
                                                        CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding IsSelectedForConfig, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" />
                                                        <Panel Width="22" Height="22">
                                                            <Image Source="{Binding IconAssetPath, Converter={StaticResource SvgImage}}"
                                                                   Width="18" Height="18"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasIcon}" />
                                                            <Panel IsVisible="{Binding HasIcon, Converter={StaticResource InvertBool}}">
                                                                <Border Width="22" Height="22" CornerRadius="11"
                                                                        Background="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                                                                        Opacity="0.15" />
                                                                <TextBlock Text="{Binding Initials}"
                                                                           Foreground="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                                                                           FontSize="9" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Panel>
                                                        </Panel>
                                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Border Classes="chip" Background="#1446C788"
                                                                        IsVisible="{Binding Configured}">
                                                                    <TextBlock Text="Configured" Foreground="#46C788" FontSize="9" />
                                                                </Border>
                                                                <Border Classes="chip" Background="#14E2A52E"
                                                                        IsVisible="{Binding IsInstalledOnly}">
                                                                    <TextBlock Text="Installed" Foreground="#E2A52E" FontSize="9" />
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="row-desc"
                                               IsVisible="{Binding NotInstalledAgentCount, Converter={StaticResource IntGtZero}}"
                                               Text="{Binding NotInstalledAgentCount, StringFormat='{}{0} agent(s) not installed — install them to configure.'}"
                                               Margin="2,2,0,0" />
                                </StackPanel>

                                <!-- Config mode selector (Proxy only) -->
                                <StackPanel Spacing="6" IsVisible="{Binding !IsAgentConfigDefaultMode}">
                                    <TextBlock Classes="section-label" Text="CONFIG MODE" Margin="2,0" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="app"
                                                Classes.primary="{Binding !IsAgentConfigManualMode}"
                                                Command="{Binding SetAgentAutoModeCommand}">Automatic</Button>
                                        <Button Classes="app"
                                                Classes.primary="{Binding IsAgentConfigManualMode}"
                                                Command="{Binding SetAgentManualModeCommand}">Manual</Button>
                                    </StackPanel>
                                    <TextBlock Classes="row-desc" IsVisible="{Binding !IsAgentConfigManualMode}"
                                               Text="Writes config files directly. A backup is created before any changes." />
                                    <TextBlock Classes="row-desc" IsVisible="{Binding IsAgentConfigManualMode}"
                                               Text="Preview the config and copy it manually to the target location." />
                                </StackPanel>

                                <!-- Amp upstream API key -->
                                <StackPanel Spacing="4" IsVisible="{Binding ShowAmpUpstreamApiKeyField}">
                                    <TextBlock Classes="row-desc" Text="Amp access token" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Classes="app"
                                                 Height="32" MinHeight="32" Padding="8,5"
                                                 PasswordChar="{Binding ShowAmpUpstreamApiKey, Converter={StaticResource SecretPasswordChar}}"
                                                 Watermark="your-amp-access-token"
                                                 Text="{Binding AmpUpstreamApiKeyDraft, Mode=TwoWay}" />
                                        <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0"
                                                ToolTip.Tip="Show/hide key"
                                                Command="{Binding ToggleAmpUpstreamApiKeyVisibilityCommand}">
                                            <lucide:PackIconLucide Kind="{Binding ShowAmpUpstreamApiKey, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                    <Button Classes="link" HorizontalAlignment="Left" Padding="0"
                                            Tag="https://ampcode.com/settings"
                                            Click="OnOpenUrlClick">
                                        <TextBlock Classes="row-desc" Text="Used to authenticate the Amp CLI. Get it from ampcode.com/settings"
                                                   TextDecorations="Underline" />
                                    </Button>
                                </StackPanel>

                                <!-- Models selector -->

                                <StackPanel Spacing="4" IsVisible="{Binding AgentConfigSupportsModelSelection}">
                                    <Button Classes="app" Command="{Binding ToggleModelsCommand}"
                                            HorizontalAlignment="Stretch" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="section-label"
                                                       Text="{Binding ModelsExpanderLabel}"
                                                       VerticalAlignment="Center" Margin="0" />
                                            <lucide:PackIconLucide Grid.Column="1" Width="13" Height="13"
                                                                   Kind="ChevronDown"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding !IsModelsExpanded}" />
                                            <lucide:PackIconLucide Grid.Column="1" Width="13" Height="13"
                                                                   Kind="ChevronUp"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding IsModelsExpanded}" />
                                        </Grid>
                                    </Button>
                                    <StackPanel IsVisible="{Binding IsModelsExpanded}" Spacing="12">
                                        <!-- Empty state -->
                                        <TextBlock Classes="row-desc" Margin="2,0"
                                                   Text="Start an engine to load available models."
                                                   IsVisible="{Binding HasSelectableModels, Converter={StaticResource InvertBool}}" />
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSelectableModels}">
                                            <TextBox Grid.Column="0" Classes="app" Watermark="Search models"
                                                     Height="26" MinHeight="26" Padding="8,3"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding ModelSearchText, Mode=TwoWay}" />
                                            <CheckBox Grid.Column="1"
                                                      Margin="14,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsThreeState="True"
                                                      Content="Select all"
                                                      IsChecked="{Binding AllVisibleModelsSelected, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock Classes="row-desc" Margin="2,0"
                                                   Text="No models match your search."
                                                   IsVisible="{Binding ShowNoModelSearchResults}" />
                                        <!-- CLIProxy models -->
                                        <StackPanel IsVisible="{Binding HasCliProxySelectableModels}" Spacing="4">
                                            <TextBlock Classes="section-label" Text="CLIPROXYAPI" Margin="2,4,2,2" />
                                            <ItemsControl ItemsSource="{Binding CliProxySelectableModels}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SelectableModelViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,3"
                                                              IsVisible="{Binding IsVisible}">
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Provider}"
                                                                       FontSize="10" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource FgFaintBrush}"
                                                                       Margin="8,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <!-- Perplexity models -->
                                        <StackPanel IsVisible="{Binding HasPerplexitySelectableModels}" Spacing="4">
                                            <TextBlock Classes="section-label" Text="PERPLEXITY" Margin="2,4,2,2" />
                                            <ItemsControl ItemsSource="{Binding PerplexitySelectableModels}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SelectableModelViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,3"
                                                              IsVisible="{Binding IsVisible}">
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Provider}"
                                                                       FontSize="10" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource FgFaintBrush}"
                                                                       Margin="8,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Proxy endpoint info (Automatic) -->
                                <Border Classes="card" Padding="12,10"
                                        IsVisible="{Binding !IsAgentConfigManualMode}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="section-label" Text="PROXY ENDPOINT" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding AgentProxyBaseUrl}"
                                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                                   FontSize="11" Foreground="{DynamicResource FgMutedBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Manual config preview -->
                                <StackPanel Spacing="8" IsVisible="{Binding IsAgentConfigManualMode}">
                                    <TextBlock Classes="section-label" Text="CONFIG PREVIEW" Margin="2,0" />
                                    <ItemsControl ItemsSource="{Binding AgentConfigPreviews}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:RawConfigPreview">
                                                <Border Classes="card" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Classes="row-desc"
                                                                       Text="{Binding Filename}"
                                                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                                                       FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Classes="row-desc"
                                                                       Text="{Binding TargetPath}" FontSize="10"
                                                                       Foreground="{DynamicResource FgFaintBrush}" />
                                                        </Grid>
                                                        <Border Background="{DynamicResource SideBgBrush}"
                                                                CornerRadius="4" Padding="8">
                                                            <ScrollViewer MaxHeight="180"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled">
                                                                <TextBlock Text="{Binding Content}"
                                                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                                                           FontSize="11" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource FgBrush}" />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>

                            <!-- Result view -->
                            <StackPanel Spacing="12" IsVisible="{Binding AgentConfigHasResult}">

                                <!-- Summary line -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <lucide:PackIconLucide Kind="CircleCheck" Width="22" Height="22" Foreground="#46C788"
                                                           IsVisible="{Binding AgentConfigSuccess}" />
                                    <lucide:PackIconLucide Kind="TriangleAlert" Width="22" Height="22"
                                                           Foreground="{DynamicResource ErrBrush}"
                                                           IsVisible="{Binding AgentConfigSuccess, Converter={StaticResource InvertBool}}" />
                                    <TextBlock Text="{Binding AgentConfigResult.Instructions, FallbackValue=''}"
                                               FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Per-agent result rows -->
                                <ItemsControl ItemsSource="{Binding AgentConfigMultiResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AgentConfigItemResult">
                                            <Border Padding="10,8" Margin="0,0,0,4"
                                                    Background="{DynamicResource SideBgBrush}"
                                                    CornerRadius="6">
                                                <Grid ColumnDefinitions="22,*">
                                                    <lucide:PackIconLucide Grid.Column="0" Width="14" Height="14"
                                                                           VerticalAlignment="Center"
                                                                           Kind="CircleCheck" Foreground="#46C788"
                                                                           IsVisible="{Binding Success}" />
                                                    <lucide:PackIconLucide Grid.Column="0" Width="14" Height="14"
                                                                           VerticalAlignment="Center"
                                                                           Kind="CircleX"
                                                                           Foreground="{DynamicResource ErrBrush}"
                                                                           IsVisible="{Binding Success, Converter={StaticResource InvertBool}}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding AgentName}"
                                                                   FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="{Binding ConfigPath, FallbackValue=''}"
                                                                   FontFamily="Cascadia Mono,Consolas,monospace" FontSize="10"
                                                                   Foreground="{DynamicResource FgFaintBrush}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding Success}" />
                                                        <TextBlock Text="{Binding Error, FallbackValue=''}"
                                                                   FontSize="11" Foreground="{DynamicResource ErrBrush}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding Success, Converter={StaticResource InvertBool}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3" Classes="row-divider" />

                    <!-- Footer -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="8" Margin="18,12">
                        <Button Classes="app" Content="Cancel"
                                IsVisible="{Binding !AgentConfigHasResult}"
                                Command="{Binding DismissAgentConfigCommand}" />
                        <Button Classes="app primary" Content="Copy All"
                                IsVisible="{Binding ShowAgentConfigCopyButton}"
                                Click="OnCopyAgentConfigClick" />
                        <Button Classes="app primary"
                                Content="{Binding AgentConfigApplyLabel}"
                                IsVisible="{Binding ShowAgentConfigApplyButton}"
                                IsEnabled="{Binding IsApplyingAgentConfig, Converter={StaticResource InvertBool}}"
                                Command="{Binding ApplyAgentConfigCommand}" />
                        <Button Classes="app primary" Content="Done"
                                IsVisible="{Binding AgentConfigHasResult}"
                                Command="{Binding DismissAgentConfigCommand}" />
                    </StackPanel>

                </Grid>
            </Border>
        </Border>

        <!-- App self-update toast -->
        <Border IsVisible="{Binding AppUpdateAvailable}"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,60"
                MaxWidth="400"
                ZIndex="50">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="row-label" Text="Tunnel Agent update available"/>
                    <TextBlock Classes="row-desc"
                               Text="{Binding AppUpdateNewVersion, StringFormat='Version {0} is ready to download.'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="app primary" Content="Download" Command="{Binding DownloadAppUpdateCommand}"
                            IsVisible="{Binding !AppUpdateDownloading}" />
                    <Button Classes="app primary" Content="Restart &amp; Install" Command="{Binding InstallAppUpdateAndRestartCommand}"
                            IsVisible="{Binding AppUpdateReady}" />
                    <StackPanel IsVisible="{Binding AppUpdateDownloading}" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="row-desc" Text="Downloading…" />
                        <ProgressBar Value="{Binding AppUpdateDownloadProgress}" Minimum="0" Maximum="100"
                                     Width="80" Height="4" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>


        <!-- Engine update toast overlay -->
        <Border IsVisible="{Binding ShowUpdateToast}"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                MaxWidth="380"
                ZIndex="50">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="row-label" Text="Engine update available"/>
                    <TextBlock Classes="row-desc"
                               Text="{Binding LatestVersion, StringFormat='CLIProxyAPI {0} is ready to install.'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="app primary" Content="Update" Command="{Binding UpdateEngineCommand}" />
                    <Button Classes="app" Content="Dismiss" Command="{Binding DismissToastCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        </Panel>
    </Border>
</Window>
