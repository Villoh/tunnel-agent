<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TunnelAgent.ViewModels"
        xmlns:v="using:TunnelAgent.Views"
        xmlns:cv="using:TunnelAgent.Converters"
        xmlns:lucide="using:IconPacks.Avalonia.Lucide"
        xmlns:svc="using:TunnelAgent.Services"
        xmlns:svg="using:Avalonia.Svg.Skia"
        x:Class="TunnelAgent.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="Tunnel Agent"
        Icon="/Assets/logo.ico"
        Width="820" Height="620"
        MinWidth="600" MinHeight="500"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource WinBgBrush}">
    <Window.Resources>
        <cv:ServerStateToTextConverter  x:Key="StateToText" />
        <cv:ServerStateToBrushConverter x:Key="StateToBrush" />
        <cv:ServerStateRunningConverter x:Key="StateIsRunning" />
        <cv:SectionEqualsConverter      x:Key="SectionEq" />
        <cv:SidebarWidthConverter       x:Key="SidebarWidth" />
        <cv:InvertBoolConverter         x:Key="InvertBool" />
        <cv:StringNotEmptyConverter     x:Key="StringNotEmpty" />
        <cv:HexToBrushConverter         x:Key="HexBrush" />
        <cv:SvgImageConverter           x:Key="SvgImage" />
        <cv:SecretPasswordCharConverter x:Key="SecretPasswordChar" />
        <cv:BoolToEyeIconConverter      x:Key="EyeIcon" />
        <cv:IntGreaterThanZeroConverter  x:Key="IntGtZero" />
        <cv:BoolToCloseCancelConverter   x:Key="BoolToCloseCancelConverter" />
    </Window.Resources>

    <Border Background="{DynamicResource WinBgBrush}"
            BorderBrush="{DynamicResource WinBorderBrush}"
            BorderThickness="0"
            CornerRadius="0"
            ClipToBounds="True">
        <Panel>
        <Grid RowDefinitions="38,*">
            <!-- Custom titlebar -->
            <Grid Grid.Row="0" PointerPressed="OnTitlebarPressed"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource WinBorderBrush}" Opacity="0.8" />


                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Classes="traffic minimize" ToolTip.Tip="Minimize" Click="OnMinimize">
                        <lucide:PackIconLucide Kind="Minus" Width="8" Height="8" Foreground="Black" />
                    </Button>
                    <Button Classes="traffic maximize" ToolTip.Tip="Maximize / Restore" Click="OnMaximizeRestore">
                        <lucide:PackIconLucide Kind="Maximize2" Width="8" Height="8" Foreground="Black" />
                    </Button>
                    <Button Classes="traffic close" ToolTip.Tip="Close" Click="OnClose">
                        <lucide:PackIconLucide Kind="X" Width="8" Height="8" Foreground="Black" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body: sidebar + content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Width="{Binding SidebarWidth}"
                        Background="{DynamicResource SideBgBrush}"
                        BorderBrush="{DynamicResource SideBorderBrush}"
                        BorderThickness="0,0,1,0"
                        ClipToBounds="True">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseInOut" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <StackPanel Grid.Row="0" Margin="8,10,8,0" Spacing="2">
                            <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                                <Panel Grid.ColumnSpan="2"
                                       Opacity="{Binding SidebarContentOpacity}">
                                    <Panel.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Panel.Transitions>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                        <Image Source="/Assets/logo-20.png" Width="16" Height="16"
                                               VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <TextBlock FontSize="13" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center">
                                            <Run Text="Tunnel" FontWeight="Bold" />
                                            <Run Text="Agent" />
                                        </TextBlock>
                                    </StackPanel>
                                </Panel>
                                <!-- Single toggle button with flip animation -->
                                <Button Grid.Column="1" Classes="icon" Width="24" Height="24"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ToolTip.Tip="Toggle sidebar"
                                        Command="{Binding ToggleSidebarCommand}">
                                    <Panel Width="15" Height="15"
                                           RenderTransformOrigin="50%,50%">
                                        <Panel.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding SidebarToggleIconScaleX}">
                                                <ScaleTransform.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="ScaleX" Duration="0:0:0.22" Easing="CubicEaseInOut" />
                                                    </Transitions>
                                                </ScaleTransform.Transitions>
                                            </ScaleTransform>
                                        </Panel.RenderTransform>
                                        <lucide:PackIconLucide Kind="PanelLeftClose" Width="15" Height="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}" />
                                    </Panel>
                                </Button>
                            </Grid>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Providers}"
                                    Command="{Binding SelectProvidersCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Server" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Providers" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding ConnectedProviderCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side" Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Quota}"
                                    Command="{Binding SelectQuotaCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="ChartBar" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Quota" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding QuotaProviderCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side"
                                    Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Agents}"
                                    Command="{Binding SelectAgentsCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Bot" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Agents" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="999" Background="#14000000" Padding="6,1"
                                                IsVisible="{Binding !IsSidebarCollapsed}">
                                            <TextBlock Text="{Binding ConfiguredAgentCount}" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side"
                                    Classes.selected="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=Logs}"
                                    Command="{Binding SelectLogsCommand}">
                                <Grid ColumnDefinitions="20,*">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="ScrollText" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Logs" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Button Classes="side" Classes.selected="{Binding IsConfigSection}"
                                    Command="{Binding SelectConfigurationCommand}">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Settings" Width="15" Height="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Grid.ColumnSpan="2"
                                           Opacity="{Binding SidebarContentOpacity}">
                                        <Panel.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                            </Transitions>
                                        </Panel.Transitions>
                                        <TextBlock Text="Configuration" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                                        <Grid Classes="status-indicator" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,1,0"
                                              IsVisible="{Binding ConfigHasBadge}">
                                            <Ellipse Classes="status-pulse" Fill="{DynamicResource WarnBrush}" />
                                            <Ellipse Classes="status-dot" Fill="{DynamicResource WarnBrush}" />
                                        </Grid>
                                    </Panel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="8,0,8,10" Spacing="6">
                            <Panel Opacity="{Binding SidebarContentOpacity}">
                                <Panel.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                    </Transitions>
                                </Panel.Transitions>
                                <TextBlock Classes="section-label" Text="STATUS" Margin="10,0,10,0"
                                           IsVisible="{Binding !IsSidebarCollapsed}"/>
                            </Panel>

                            <Grid Margin="10,0" ColumnDefinitions="Auto,*">
                                <Grid Grid.Column="0" Classes="status-indicator">
                                    <Ellipse Classes="status-pulse"
                                             Fill="{Binding CliProxyServerState, Converter={StaticResource StateToBrush}}"
                                             IsVisible="{Binding CliProxyServerState, Converter={StaticResource StateIsRunning}}" />
                                    <Ellipse Classes="status-dot"
                                             Fill="{Binding CliProxyServerState, Converter={StaticResource StateToBrush}}" />
                                </Grid>
                                <Panel Grid.Column="1"
                                       Opacity="{Binding SidebarContentOpacity}">
                                    <Panel.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Panel.Transitions>
                                    <TextBlock Text="CLIProxyAPI" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource FgBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsSidebarCollapsed}" />
                                </Panel>
                            </Grid>

                            <Grid Margin="10,0" ColumnDefinitions="Auto,*">
                                <Grid Grid.Column="0" Classes="status-indicator">
                                    <Ellipse Classes="status-pulse"
                                             Fill="{Binding PerplexityServerState, Converter={StaticResource StateToBrush}}"
                                             IsVisible="{Binding PerplexityServerState, Converter={StaticResource StateIsRunning}}" />
                                    <Ellipse Classes="status-dot"
                                             Fill="{Binding PerplexityServerState, Converter={StaticResource StateToBrush}}" />
                                </Grid>
                                <Panel Grid.Column="1"
                                       Opacity="{Binding SidebarContentOpacity}">
                                    <Panel.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Panel.Transitions>
                                    <TextBlock Text="Perplexity" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource FgBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsSidebarCollapsed}" />
                                </Panel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource SideBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8">
                            <Grid>
                                <Grid ColumnDefinitions="*,Auto"
                                      IsVisible="{Binding !IsSidebarCollapsed}"
                                      Opacity="{Binding SidebarContentOpacity}">
                                    <Grid.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                                        </Transitions>
                                    </Grid.Transitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding AppVersion, StringFormat='v{0} · MIT'}" FontSize="11"
                                                   Foreground="{DynamicResource FgFaintBrush}" />
                                        <Button Classes="link" Command="{Binding OpenIssueUrlCommand}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="Report an issue" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Cursor="Hand" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="icon" HorizontalAlignment="Right"
                                            ToolTip.Tip="Toggle light / dark mode"
                                            Command="{Binding ToggleThemeCommand}">
                                        <Grid Width="18" Height="18" Classes="theme-icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <lucide:PackIconLucide Kind="Moon" Width="15" Height="15"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding !IsDark}" />
                                            <lucide:PackIconLucide Kind="SunMedium" Width="16" Height="16"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                                   IsVisible="{Binding IsDark}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Button Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSidebarCollapsed}"
                                        ToolTip.Tip="Toggle light / dark mode"
                                        Command="{Binding ToggleThemeCommand}">
                                    <Grid Width="18" Height="18" Classes="theme-icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <lucide:PackIconLucide Kind="Moon" Width="15" Height="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                               IsVisible="{Binding !IsDark}" />
                                        <lucide:PackIconLucide Kind="SunMedium" Width="16" Height="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FgMutedBrush}"
                                                               IsVisible="{Binding IsDark}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content area -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="SectionHost"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="18,16,18,44" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Delete log file confirmation dialog -->
        <Border IsVisible="{Binding Logs.ShowClearConfirm}"
                Background="#88000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="50">
            <Border Classes="card"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="Delete log file?" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="This permanently deletes the CLIProxyAPI log file on disk. The view will be cleared and new entries will appear as the proxy runs." />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel"
                                Command="{Binding DismissDeleteLogsConfirmCommand}" />
                        <Button Classes="app danger" Content="Delete log file"
                                Command="{Binding ConfirmDeleteLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Reset credentials confirmation dialog -->
        <Border IsVisible="{Binding ShowResetCredentialsDialog}"
                Background="#88000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="50">
            <Border Classes="card"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="Reset all credentials?" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="This backs up and removes Tunnel Agent-managed OAuth tokens and custom provider keys. Other JSON files in the auth folder are preserved." />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel"
                                Command="{Binding DismissResetCredentialsDialogCommand}" />
                        <Button Classes="app danger" Content="Reset credentials"
                                Command="{Binding ConfirmResetCredentialsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ContentControl x:Name="ApiKeysOverlayHost"
                        IsVisible="{Binding ShowApiKeysDialog}"
                        ZIndex="50" />

        <!-- Add CLIProxy account dialog -->
        <Border IsVisible="{Binding ShowAddAccountDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50">
            <Border Classes="card" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="{Binding AddAccountTarget.Name, StringFormat='Add account — {0}'}" />
                    <StackPanel Spacing="4" IsVisible="{Binding AddAccountTarget.IsOAuth, Converter={StaticResource InvertBool}, FallbackValue=False}">
                        <TextBlock Classes="row-desc" Text="Base URL" />
                        <TextBox x:Name="BaseUrlBox" Classes="app" Watermark="https://api.example.com/v1" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="API Key" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" x:Name="ApiKeyBox" Classes="app"
                                     PasswordChar="{Binding ShowAddAccountApiKey, Converter={StaticResource SecretPasswordChar}}"
                                     Watermark="sk-..."
                                     Text="{Binding AddAccountApiKeyDraft, Mode=TwoWay}" />
                            <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0"
                                    ToolTip.Tip="Show/hide key"
                                    Command="{Binding ToggleAddAccountApiKeyVisibilityCommand}">
                                <lucide:PackIconLucide Kind="{Binding ShowAddAccountApiKey, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="Label (optional)" />
                        <TextBox x:Name="LabelBox" Classes="app" Watermark="My account" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel" Command="{Binding DismissAddAccountDialogCommand}" />
                        <Button Classes="app primary" Content="Add Account" Click="OnConfirmAddAccount" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add Perplexity account dialog -->
        <Border x:Name="PerplexityAccountOverlay" IsVisible="{Binding ShowPerplexityAccountDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                KeyDown="OnPerplexityAccountDialogKeyDown" Focusable="True"
                PointerPressed="OnPerplexityAccountOverlayPressed">
            <Border Classes="card" Width="440" MinHeight="150" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <Grid>
                    <StackPanel Spacing="14" IsVisible="{Binding IsPerplexityTokenGenerationMode, Converter={StaticResource InvertBool}}">
                        <TextBlock Classes="row-label" FontSize="15" Text="Add Perplexity account" />
                        <StackPanel Spacing="4">
                            <TextBlock Classes="row-desc" Text="Label (optional)" />
                            <TextBox x:Name="PerplexityLabelBox" Classes="app" Watermark="Primary"
                                     KeyDown="OnPerplexityAccountInputKeyDown" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="row-desc" Text="Session token" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" x:Name="PerplexitySessionTokenBox" Classes="app"
                                         PasswordChar="{Binding ShowPerplexitySessionToken, Converter={StaticResource SecretPasswordChar}}"
                                         Watermark="pplx-session-token"
                                         Text="{Binding PerplexitySessionTokenDraft, Mode=TwoWay}"
                                         KeyDown="OnPerplexityAccountInputKeyDown" />
                                <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0"
                                        ToolTip.Tip="Show/hide token"
                                        Command="{Binding TogglePerplexitySessionTokenVisibilityCommand}">
                                    <lucide:PackIconLucide Kind="{Binding ShowPerplexitySessionToken, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="row-desc" TextWrapping="Wrap"
                                   Text="Paste your Perplexity WebUI session token, or generate one via email verification." />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Classes="app" Content="Generate Token" Click="OnStartPerplexityTokenFlow" />
                            <Button Classes="app" Content="Cancel" Command="{Binding DismissPerplexityAccountDialogCommand}" />
                            <Button Classes="app primary" Content="Save Account" Click="OnConfirmPerplexityAccount" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsPerplexityTokenGenerationMode}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="row-label" FontSize="15" Text="Generate Perplexity token" />
                            <TextBlock Grid.Column="1" Classes="row-desc" Text="{Binding PerplexityTokenStepLabel}" />
                        </Grid>
                        <TextBlock Classes="row-desc" Text="{Binding PerplexityTokenPrompt}" TextWrapping="Wrap"
                                   IsVisible="{Binding !PerplexityTokenHasError}" />
                        <TextBlock Classes="row-desc" Text="{Binding PerplexityTokenDetail}" TextWrapping="Wrap"
                                   IsVisible="{Binding !PerplexityTokenHasError}" />
                        <Border Classes="alert error" IsVisible="{Binding PerplexityTokenHasError}">
                            <Grid ColumnDefinitions="Auto,*">
                                <lucide:PackIconLucide Grid.Column="0" Kind="TriangleAlert" Width="16" Height="16"
                                                       Foreground="{DynamicResource ErrBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="alert-title" Text="Token generation failed" />
                                    <TextBlock Classes="alert-body" Text="{Binding PerplexityTokenDetail}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBox x:Name="PerplexityTokenFlowInputBox" Classes="app"
                                 Watermark="{Binding PerplexityTokenInputWatermark}"
                                 IsEnabled="{Binding IsPerplexityTokenFlowBusy, Converter={StaticResource InvertBool}}"
                                 KeyDown="OnPerplexityTokenFlowInputKeyDown" />
                        <ProgressBar IsIndeterminate="True" Height="6"
                                     IsVisible="{Binding IsPerplexityTokenFlowBusy}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Classes="app" Content="Back" Command="{Binding CancelPerplexityTokenFlowCommand}" />
                            <Button Classes="app primary" Content="{Binding PerplexityTokenContinueLabel}" Click="OnSubmitPerplexityTokenFlow" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Edit Perplexity account label dialog -->
        <Border IsVisible="{Binding ShowEditPerplexityLabelDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                PointerPressed="OnEditPerplexityLabelOverlayPressed"
                KeyDown="OnEditPerplexityLabelKeyDown" Focusable="True">
            <Border Classes="card" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="Edit Perplexity account label" />
                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="Label" />
                        <TextBox x:Name="EditPerplexityLabelBox" Classes="app" Watermark="Primary"
                                 Text="{Binding EditPerplexityLabelDraft, Mode=TwoWay}"
                                 KeyDown="OnEditPerplexityLabelKeyDown" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel" Command="{Binding DismissEditPerplexityLabelDialogCommand}" />
                        <Button Classes="app primary" Content="Save" Command="{Binding ConfirmEditPerplexityLabelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Reset Perplexity accounts confirmation dialog -->
        <Border IsVisible="{Binding ShowResetPerplexityDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50">
            <Border Classes="card" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="row-label" FontSize="15" Text="Reset Perplexity accounts?" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="This backs up and removes all saved Perplexity WebUI session token files." />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="app" Content="Cancel" Command="{Binding DismissResetPerplexityDialogCommand}" />
                        <Button Classes="app danger" Content="Reset accounts" Command="{Binding ConfirmResetPerplexityAccountsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Gemini interactive login dialog -->
        <Border x:Name="GeminiLoginOverlay" IsVisible="{Binding ShowGeminiLoginDialog}" Background="#88000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
                PointerPressed="OnGeminiLoginOverlayPressed" KeyDown="OnGeminiLoginKeyDown" Focusable="True">
            <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    PointerPressed="OnDialogCardPressed">
                <StackPanel Spacing="16">

                    <TextBlock Classes="row-label" FontSize="15" Text="Add Gemini account" />

                    <!-- Error banner -->
                    <Border Classes="alert error" IsVisible="{Binding GeminiLoginHasError}">
                        <Grid ColumnDefinitions="Auto,*">
                            <lucide:PackIconLucide Grid.Column="0" Kind="TriangleAlert" Width="16" Height="16"
                                                   Foreground="{DynamicResource ErrBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="alert-title" Text="{Binding GeminiLoginPrompt}" />
                                <TextBlock Classes="alert-body" Text="{Binding GeminiLoginDetail}"
                                           IsVisible="{Binding GeminiLoginDetail, Converter={StaticResource StringNotEmpty}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Panel: Waiting for OAuth (browser open) -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsGeminiWaiting}">
                        <TextBlock Classes="row-desc" TextWrapping="Wrap"
                                   Text="{Binding GeminiLoginPrompt}"
                                   IsVisible="{Binding GeminiLoginHasError, Converter={StaticResource InvertBool}}" />
                        <ProgressBar IsIndeterminate="True" Height="6" IsVisible="{Binding IsGeminiLoginBusy}" />
                    </StackPanel>

                    <!-- Panel: Mode selection -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsGeminiModeSelection}">
                        <TextBlock Classes="row-desc" TextWrapping="Wrap"
                                   Text="Choose how Gemini should authenticate."
                                   IsVisible="{Binding GeminiLoginHasError, Converter={StaticResource InvertBool}}" />
                        <Button Classes="app" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                IsEnabled="{Binding IsGeminiLoginBusy, Converter={StaticResource InvertBool}}"
                                Click="OnGeminiSelectMode1">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="Code Assist" />
                                <TextBlock Classes="row-desc" Text="GCP project, manual selection" />
                            </StackPanel>
                        </Button>
                        <Button Classes="app" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                IsEnabled="{Binding IsGeminiLoginBusy, Converter={StaticResource InvertBool}}"
                                Click="OnGeminiSelectMode2">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="Google One" />
                                <TextBlock Classes="row-desc" Text="Personal account, auto-discover project" />
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Height="6" IsVisible="{Binding IsGeminiLoginBusy}" />
                    </StackPanel>

                    <!-- Panel: Project selection -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsGeminiProjectSelection}">
                        <TextBlock Classes="row-desc" TextWrapping="Wrap"
                                   Text="{Binding GeminiLoginPrompt}"
                                   IsVisible="{Binding GeminiLoginHasError, Converter={StaticResource InvertBool}}" />
                        <ListBox x:Name="GeminiProjectListBox"
                                 ItemsSource="{Binding GeminiLoginProjects}"
                                 SelectionMode="Single" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontWeight="Medium" Text="{Binding Id}" />
                                        <TextBlock Classes="row-desc" Text="{Binding Label}"
                                                   IsVisible="{Binding Label, Converter={StaticResource StringNotEmpty}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ProgressBar IsIndeterminate="True" Height="6" IsVisible="{Binding IsGeminiLoginBusy}" />
                    </StackPanel>

                    <!-- Panel: Success -->
                    <StackPanel Spacing="8" Orientation="Horizontal" IsVisible="{Binding IsGeminiDone}">
                        <lucide:PackIconLucide Kind="CircleCheck" Width="18" Height="18"
                                               Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" />
                        <TextBlock Classes="row-desc" Text="{Binding GeminiLoginPrompt}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Classes="app"
                                Content="{Binding IsGeminiDone, Converter={StaticResource BoolToCloseCancelConverter}}"
                                Command="{Binding DismissGeminiLoginDialogCommand}" />
                        <Button Classes="app primary" Content="Connect"
                                IsVisible="{Binding IsGeminiProjectSelection}"
                                IsEnabled="{Binding IsGeminiLoginBusy, Converter={StaticResource InvertBool}}"
                                Click="OnGeminiConfirmProject" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Border>

        <ContentControl x:Name="AgentConfigOverlayHost"
                        IsVisible="{Binding ShowAgentConfigDialog}"
                        ZIndex="50" />

        <!-- App self-update toast -->
        <Border IsVisible="{Binding AppUpdateAvailable}"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,60"
                MaxWidth="400"
                ZIndex="50">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="row-label" Text="Tunnel Agent update available"/>
                    <TextBlock Classes="row-desc"
                               Text="{Binding AppUpdateNewVersion, StringFormat='Version {0} is ready to download.'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="app primary" Content="Download" Command="{Binding DownloadAppUpdateCommand}" />
                    <Button Classes="app" Content="Dismiss" Command="{Binding DismissAppUpdateCommand}" />
                </StackPanel>
            </Grid>
        </Border>


        <!-- Engine update toast overlay -->
        <Border IsVisible="{Binding ShowUpdateToast}"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                MaxWidth="380"
                ZIndex="50">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="row-label" Text="Engine update available"/>
                    <TextBlock Classes="row-desc"
                               Text="{Binding LatestVersion, StringFormat='CLIProxyAPI {0} is ready to install.'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="app primary" Content="Update" Command="{Binding UpdateEngineCommand}" />
                    <Button Classes="app" Content="Dismiss" Command="{Binding DismissToastCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        </Panel>
    </Border>
</Window>
