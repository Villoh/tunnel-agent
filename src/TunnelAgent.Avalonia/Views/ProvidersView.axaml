<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TunnelAgent.ViewModels"
             xmlns:cv="using:TunnelAgent.Converters"
             xmlns:si="using:IconPacks.Avalonia.SimpleIcons"
             xmlns:lucide="using:IconPacks.Avalonia.Lucide"
             xmlns:ctrl="using:TunnelAgent.Controls"
             xmlns:l="using:TunnelAgent.Services"
             x:Class="TunnelAgent.Views.ProvidersView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <cv:ServerStateRunningConverter x:Key="StateIsRunning" />
        <cv:ServerStateToOpacityConverter x:Key="StateToOpacity" />
        <cv:ServerStateToTextConverter  x:Key="StateToText" />
        <cv:ServerStateToBrushConverter x:Key="StateToBrush" />
        <cv:HexToBrushConverter         x:Key="HexBrush" />
        <cv:BoolToOpacityConverter      x:Key="BoolToOpacity" />
        <cv:StringNotEmptyConverter     x:Key="StringNotEmpty" />
        <cv:InvertBoolConverter         x:Key="InvertBool" />
        <cv:BoolToEnableDisableTextConverter x:Key="BoolToEnableDisableText" />
    </UserControl.Resources>

    <Panel>
        <ScrollViewer>
            <StackPanel Spacing="0" Margin="0,0,0,24">

                <!-- ── Engine tab bar ─────────────────────────────────── -->
                <ctrl:SlidingTabBar Margin="0,0,0,16"
                                    SelectedIndex="{Binding ProvidersTabIndex}">
                    <ctrl:SlidingTabBar.Tabs>
                        <ctrl:SlidingTab Header="{l:Loc ProvidersView_TabCLIProxyAPI}" Command="{Binding FocusCliProxyCommand}" />
                        <ctrl:SlidingTab Header="{l:Loc ProvidersView_TabNineRouter}"  Command="{Binding FocusNineRouterCommand}" />
                        <ctrl:SlidingTab Header="{l:Loc ProvidersView_TabPerplexity}"  Command="{Binding FocusPerplexityCommand}" />
                    </ctrl:SlidingTabBar.Tabs>
                </ctrl:SlidingTabBar>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Classes="page-title" Text="{l:Loc ProvidersView_Title}" />
                        <TextBlock Classes="page-sub" Text="{Binding ActiveEngineDescription}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Border Classes="endpoint" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EndpointUrl}"
                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource FgBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Button Classes="icon-btn copy-endpoint"
                                Classes.copied="{Binding EndpointCopied}"
                                ToolTip.Tip="{l:Loc ProvidersView_CopyEndpointTooltip}"
                                Click="OnCopyEndpoint">
                            <Panel>
                                <lucide:PackIconLucide Kind="Copy" Width="13" Height="13" IsVisible="{Binding !EndpointCopied}" />
                                <lucide:PackIconLucide Kind="Check" Width="13" Height="13" IsVisible="{Binding EndpointCopied}" />
                            </Panel>
                        </Button>
                        <Button Classes="icon-btn copy-endpoint"
                                ToolTip.Tip="{l:Loc ConfigView_NineRouter_Dashboard_Open}"
                                Command="{Binding OpenNineRouterDashboardCommand}"
                                IsVisible="{Binding IsNineRouterEngineSelected}"
                                IsEnabled="{Binding IsNineRouterEngineRunning}">
                            <lucide:PackIconLucide Kind="ExternalLink" Width="13" Height="13" />
                        </Button>
                        <Panel Width="26" Height="26">
                            <Button Classes="icon-btn engine-action start"
                                    ToolTip.Tip="{l:Loc ProvidersView_StartServerTooltip}"
                                    Command="{Binding StartServerCommand}"
                                    Opacity="{Binding ServerState, Converter={StaticResource StateToOpacity}, ConverterParameter=Invert}"
                                    IsHitTestVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}, ConverterParameter=Invert}">
                                <lucide:PackIconLucide Kind="Play" Width="12" Height="12" Margin="1,0,0,0" />
                            </Button>
                            <Button Classes="icon-btn engine-action stop"
                                    ToolTip.Tip="{l:Loc ProvidersView_StopServerTooltip}"
                                    Command="{Binding StopServerCommand}"
                                    Opacity="{Binding ServerState, Converter={StaticResource StateToOpacity}}"
                                    IsHitTestVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}}">
                                <lucide:PackIconLucide Kind="Square" Width="10" Height="10" />
                            </Button>
                        </Panel>
                    </StackPanel>
                </Grid>

                <Border Classes="card" Margin="0,0,0,6">
                    <Grid Margin="16,12" ColumnDefinitions="22,*,Auto">
                        <Grid Classes="status-indicator">
                            <Ellipse Classes="status-pulse"
                                     Fill="{Binding ServerState, Converter={StaticResource StateToBrush}}"
                                     IsVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}}" />
                            <Ellipse Classes="status-dot"
                                     Fill="{Binding ServerState, Converter={StaticResource StateToBrush}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Classes="row-label" Text="{Binding ActiveEngineName}" />
                            <TextBlock Classes="row-desc">
                                <Run Text="{l:Loc ProvidersView_ListeningOn}" />
                                <Run Text="{Binding Port}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ServerState, Converter={StaticResource StateToText}}"
                                   Classes="status"
                                   Foreground="{Binding ServerState, Converter={StaticResource StateToBrush}}"
                                   ToolTip.Tip="{Binding FocusedEngineErrorTooltip}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsPerplexityEngineSelected}" Margin="0,0,0,12">
                    <StackPanel Margin="16,14" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="row-label" Text="{l:Loc ProvidersView_PerplexitySection_Title}" />
                                <TextBlock Classes="row-desc" Text="{l:Loc ProvidersView_PerplexitySection_Description}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="icon-btn"
                                    ToolTip.Tip="{l:Loc ProvidersView_PerplexitySection_AddTooltip}"
                                    Command="{Binding ShowAddPerplexityAccountCommand}">
                                <lucide:PackIconLucide Kind="Plus" Width="14" Height="14"
                                                       Foreground="{DynamicResource FgMutedBrush}" />
                            </Button>
                        </Grid>

                        <Border Background="#08FFFFFF" CornerRadius="8" Padding="14,16"
                                IsVisible="{Binding HasPerplexityAccounts, Converter={StaticResource InvertBool}}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="row-label" Text="{l:Loc ProvidersView_PerplexitySection_NoAccounts}" />
                                <TextBlock Classes="row-desc" Text="{Binding PerplexityEmptyStateText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PerplexityAccounts}" IsVisible="{Binding HasPerplexityAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PerplexityAccountViewModel">
                                    <Border Background="#08FFFFFF" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                            <StackPanel Grid.Column="0" Grid.RowSpan="2" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="row-label" Text="{Binding Label}" />
                                                    <Border Classes="chip" Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding IsDefault}">
                                                        <TextBlock Text="{l:Loc ProvidersView_PerplexityAccount_DefaultBadge}" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Classes="row-desc"
                                                           Text="{Binding MaskedSessionToken}"
                                                           FontFamily="Cascadia Mono,Consolas,monospace" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="app" Content="{l:Loc ProvidersView_PerplexityAccount_MakeDefault}"
                                                    Margin="8,0,8,0"
                                                    IsVisible="{Binding IsDefault, Converter={StaticResource InvertBool}}"
                                                    Command="{Binding #Root.DataContext.SetDefaultPerplexityAccountCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Classes="icon-btn"
                                                    ToolTip.Tip="{l:Loc ProvidersView_PerplexityAccount_EditLabelTooltip}"
                                                    Command="{Binding #Root.DataContext.EditPerplexityAccountLabelCommand}"
                                                    CommandParameter="{Binding}">
                                                <lucide:PackIconLucide Kind="Pencil" Width="13" Height="13"
                                                                       Foreground="{DynamicResource FgMutedBrush}" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="icon-btn"
                                                    ToolTip.Tip="{l:Loc ProvidersView_PerplexityAccount_RemoveTooltip}"
                                                    Command="{Binding #Root.DataContext.RemovePerplexityAccountCommand}"
                                                    CommandParameter="{Binding}">
                                                <lucide:PackIconLucide Kind="Trash2" Width="13" Height="13"
                                                                       Foreground="#D46A6A" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsNineRouterEngineSelected}" Margin="0,0,0,12">
                    <StackPanel Margin="16,14" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="row-label" Text="{l:Loc ProvidersView_NineRouterSection_Title}" />
                                <TextBlock Classes="row-desc" Text="{l:Loc ProvidersView_NineRouterSection_Description}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="icon-btn"
                                    ToolTip.Tip="{l:Loc ProvidersView_NineRouterSection_AddTooltip}"
                                    Command="{Binding ShowAddNineRouterApiKeyCommand}"
                                    IsEnabled="{Binding IsNineRouterEngineRunning}">
                                <lucide:PackIconLucide Kind="Plus" Width="14" Height="14"
                                                       Foreground="{DynamicResource FgMutedBrush}" />
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,130" ColumnSpacing="8">
                            <Border Grid.Column="0" Background="{DynamicResource BtnBgBrush}" BorderBrush="{DynamicResource BtnBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,0,0,0">
                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                    <lucide:PackIconLucide Grid.Column="0" Kind="Search" Width="13" Height="13"
                                                           Foreground="{DynamicResource FgFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4,8"
                                             VerticalContentAlignment="Center" FontSize="12"
                                             Watermark="{l:Loc ProvidersView_NineRouterSection_SearchPlaceholder}"
                                             Text="{Binding NineRouterProviderSearch, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <ComboBox Grid.Column="1" Classes="app" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding NineRouterProviderAuthFilters}"
                                      SelectedItem="{Binding NineRouterProviderAuthFilter, Mode=TwoWay}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding NineRouterProviders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NineRouterProviderViewModel">
                                    <StackPanel>
                                        <ToggleButton Classes="provider-row" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                <ToggleButton Grid.Column="0" Classes="enable-toggle"
                                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                              IsEnabled="{Binding HasAccounts}"
                                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                                              Command="{Binding #Root.DataContext.ToggleNineRouterProviderCommand}"
                                                              CommandParameter="{Binding}" />
                                                <Border Grid.Column="1" Classes="provider-logo" Width="28" Height="28"
                                                        Background="{Binding LogoColor, Converter={StaticResource HexBrush}}"
                                                        Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacity}}"
                                                        Margin="0,0,10,0">
                                                    <Panel>
                                                        <si:PackIconSimpleIcons Kind="{Binding IconKind}" Foreground="White" Width="14" Height="14"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                IsVisible="{Binding ShowSimpleIcon}" />
                                                        <TextBlock Text="{Binding Monogram}" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding UseMonogram}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="row-label" Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Border Classes="chip" Background="#22FF7A00"
                                                                IsVisible="{Binding IsEnabled, Converter={StaticResource InvertBool}}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{l:Loc ProvidersView_Provider_Disabled}" Foreground="#CC7A2B" FontSize="10" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ConnectedSubText}" FontSize="11.5" Foreground="{DynamicResource FgMutedBrush}" />
                                                    <TextBlock Text="{Binding Id}" Classes="row-desc" FontFamily="Cascadia Mono,Consolas,monospace" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0">
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_AddAccountTooltip}"
                                                            IsVisible="{Binding Option.SupportsOAuth}"
                                                            Command="{Binding #Root.DataContext.ConnectNineRouterOAuthProviderCommand}"
                                                            CommandParameter="{Binding Option}">
                                                        <lucide:PackIconLucide Kind="CircleUserRound" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_AddApiKeyTooltip}"
                                                            IsVisible="{Binding SupportsStoredCredential}"
                                                            Command="{Binding #Root.DataContext.ShowAddNineRouterProviderCommand}"
                                                            CommandParameter="{Binding}">
                                                        <lucide:PackIconLucide Kind="KeyRound" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_AddAccountTooltip}"
                                                            IsVisible="{Binding Option.SupportsNoAuth}"
                                                            Command="{Binding #Root.DataContext.ShowAddNineRouterProviderCommand}"
                                                            CommandParameter="{Binding}">
                                                        <lucide:PackIconLucide Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                                                    </Button>
                                                </StackPanel>
                                                <Panel Grid.Column="4" Width="20" VerticalAlignment="Center">
                                                    <lucide:PackIconLucide Kind="ChevronRight" Width="14" Height="14" Foreground="{DynamicResource FgFaintBrush}"
                                                                            IsVisible="{Binding IsExpanded, Converter={StaticResource InvertBool}}" />
                                                    <lucide:PackIconLucide Kind="ChevronDown" Width="14" Height="14" Foreground="{DynamicResource FgFaintBrush}"
                                                                            IsVisible="{Binding IsExpanded}" />
                                                </Panel>
                                            </Grid>
                                        </ToggleButton>
                                        <ItemsControl ItemsSource="{Binding Accounts}" IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NineRouterConnectionViewModel">
                                                    <Border Background="#08FFFFFF" Margin="16,8,16,10" CornerRadius="8" Padding="14,12">
                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" />
                                                                    <Border Classes="chip" Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding HasAuthType}">
                                                                        <TextBlock Text="{Binding AuthType}" Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding LastError}" Classes="row-desc" Foreground="#D46A6A"
                                                                           TextWrapping="Wrap" IsVisible="{Binding HasLastError}" />
                                                            </StackPanel>
                                                            <ToggleButton Grid.Column="1" Classes="enable-toggle" IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                          Margin="8,0" VerticalAlignment="Center"
                                                                          Command="{Binding #Root.DataContext.ToggleNineRouterConnectionCommand}"
                                                                          CommandParameter="{Binding}" />
                                                            <Button Grid.Column="2" Classes="icon-btn" VerticalAlignment="Center"
                                                                    ToolTip.Tip="{l:Loc ProvidersView_NineRouterConnection_DeleteTooltip}"
                                                                    Command="{Binding #Root.DataContext.DeleteNineRouterConnectionCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <lucide:PackIconLucide Kind="Trash2" Width="13" Height="13" Foreground="#D46A6A" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Classes="row-divider" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <Button Classes="icon-btn" ToolTip.Tip="{l:Loc LogsView_Requests_FirstPageTooltip}"
                                    IsVisible="{Binding CanGoNineRouterProviderPrev}"
                                    Command="{Binding FirstNineRouterProviderPageCommand}">
                                <lucide:PackIconLucide Kind="ChevronsLeft" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                            </Button>
                            <Button Classes="icon-btn" ToolTip.Tip="{l:Loc LogsView_Requests_PrevPageTooltip}"
                                    IsVisible="{Binding CanGoNineRouterProviderPrev}"
                                    Command="{Binding PrevNineRouterProviderPageCommand}">
                                <lucide:PackIconLucide Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                            </Button>
                            <ItemsControl ItemsSource="{Binding NineRouterProviderPageNavigationItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogPageItem">
                                        <Panel>
                                            <Button Classes="icon-btn page" Classes.current="{Binding IsCurrent}" MinWidth="24" Padding="6,4"
                                                    Content="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                    IsVisible="{Binding !IsEllipsis}"
                                                    Command="{Binding #Root.DataContext.GoToNineRouterProviderPageCommand}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgFaintBrush}" Padding="6,4" MinWidth="24"
                                                       TextAlignment="Center" IsVisible="{Binding IsEllipsis}" />
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="icon-btn" ToolTip.Tip="{l:Loc LogsView_Requests_NextPageTooltip}"
                                    IsVisible="{Binding CanGoNineRouterProviderNext}"
                                    Command="{Binding NextNineRouterProviderPageCommand}">
                                <lucide:PackIconLucide Kind="ChevronRight" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                            </Button>
                            <Button Classes="icon-btn" ToolTip.Tip="{l:Loc LogsView_Requests_LastPageTooltip}"
                                    IsVisible="{Binding CanGoNineRouterProviderNext}"
                                    Command="{Binding LastNineRouterProviderPageCommand}">
                                <lucide:PackIconLucide Kind="ChevronsRight" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding IsCliProxyEngineSelected}">
                    <Border Classes="card">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderViewModel">
                                    <StackPanel>
                                        <ToggleButton Classes="provider-row" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                <ToggleButton Grid.Column="0"
                                                              Classes="enable-toggle"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              IsEnabled="{Binding HasAccounts}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,12,0"
                                                              ToolTip.Tip="{Binding IsEnabled, Converter={StaticResource BoolToEnableDisableText}}" />
                                                <Border Grid.Column="1" Classes="provider-logo" Width="28" Height="28"
                                                        Background="{Binding LogoColor, Converter={StaticResource HexBrush}}"
                                                        Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacity}}"
                                                        Margin="0,0,10,0">
                                                    <Panel>
                                                        <si:PackIconSimpleIcons Kind="{Binding IconKind}" Foreground="White" Width="14" Height="14"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                IsVisible="{Binding ShowSimpleIcon}" />
                                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 IsVisible="{Binding HasCustomIcon}">
                                                            <Path Data="{Binding CustomIconData}" Fill="White" Stretch="Uniform" />
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding Monogram}" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding UseMonogram}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="row-label" Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Border Classes="chip" Background="#22FF7A00"
                                                                IsVisible="{Binding IsEnabled, Converter={StaticResource InvertBool}}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{l:Loc ProvidersView_Provider_Disabled}" Foreground="#CC7A2B" FontSize="10" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ConnectedSubText}" FontSize="11.5"
                                                               IsVisible="{Binding IsEnabled}"
                                                               Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}" />
                                                    <TextBlock Text="{Binding ProviderDetailText}" Classes="row-desc"
                                                               IsVisible="{Binding ProviderDetailText, Converter={StaticResource StringNotEmpty}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0">
                                                    <Border Classes="chip" Background="#22AAAAFF" IsVisible="{Binding IsConnecting}" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <TextBlock Text="{l:Loc ProvidersView_Provider_Connecting}" Foreground="#8888FF" FontSize="10" />
                                                    </Border>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_AddAccountTooltip}" IsVisible="{Binding HasOnlyOAuth}"
                                                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBool}}"
                                                            Click="OnOAuthConnect" Tag="{Binding}">
                                                        <lucide:PackIconLucide Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_AddAccountTooltip}" IsVisible="{Binding HasMultipleAddModes}"
                                                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBool}}"
                                                            Command="{Binding RequestAddAccountCommand}">
                                                        <lucide:PackIconLucide Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_RemoveAllTooltip}" IsVisible="{Binding Connected}"
                                                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBool}}"
                                                            Click="OnOAuthDisconnect" Tag="{Binding}">
                                                        <lucide:PackIconLucide Kind="Trash2" Width="14" Height="14" Foreground="#D46A6A" />
                                                    </Button>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_AddApiKeyTooltip}"
                                                            IsVisible="{Binding SupportsOAuth, Converter={StaticResource InvertBool}}"
                                                            Command="{Binding RequestAddAccountCommand}">
                                                        <lucide:PackIconLucide Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_EditProviderTooltip}"
                                                            IsVisible="{Binding IsCustomProvider}"
                                                            Command="{Binding #Root.DataContext.OpenEditCustomProviderCommand}"
                                                            CommandParameter="{Binding}">
                                                        <lucide:PackIconLucide Kind="Pencil" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}" />
                                                    </Button>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_EditModelsTooltip}"
                                                            IsVisible="{Binding IsCustomProvider}"
                                                            IsEnabled="{Binding !IsFetchingModels}"
                                                            Command="{Binding #Root.DataContext.EditProviderModelsCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Panel>
                                                            <lucide:PackIconLucide Kind="SlidersHorizontal" Width="14" Height="14" Foreground="{DynamicResource FgMutedBrush}"
                                                                                   IsVisible="{Binding !IsFetchingModels}" />
                                                            <lucide:PackIconLucide Classes="spin" Kind="LoaderCircle" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}"
                                                                                   IsVisible="{Binding IsFetchingModels}" />
                                                        </Panel>
                                                    </Button>
                                                    <Button Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_RemoveProviderTooltip}"
                                                            IsVisible="{Binding IsCustomProvider}"
                                                            Command="{Binding #Root.DataContext.RemoveCustomProviderCommand}"
                                                            CommandParameter="{Binding}">
                                                        <lucide:PackIconLucide Kind="Trash2" Width="14" Height="14" Foreground="#D46A6A" />
                                                    </Button>
                                                </StackPanel>
                                                <Panel Grid.Column="4" Width="20" VerticalAlignment="Center">
                                                    <lucide:PackIconLucide Kind="ChevronRight" Width="14" Height="14"
                                                                            Foreground="{DynamicResource FgFaintBrush}"
                                                                            IsVisible="{Binding IsExpanded, Converter={StaticResource InvertBool}}" />
                                                    <lucide:PackIconLucide Kind="ChevronDown" Width="14" Height="14"
                                                                            Foreground="{DynamicResource FgFaintBrush}"
                                                                            IsVisible="{Binding IsExpanded}" />
                                                </Panel>
                                            </Grid>
                                        </ToggleButton>

                                        <ItemsControl ItemsSource="{Binding Accounts}" IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProviderAccountViewModel">
                                                    <Border Background="#08FFFFFF" Margin="16,8,16,10" CornerRadius="8" Padding="14,12,14,14">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" />
                                                                        <Border Classes="chip" Background="{DynamicResource AccentSoftBrush}"
                                                                                IsVisible="{Binding PlanBadge, Converter={StaticResource StringNotEmpty}}">
                                                                            <TextBlock Text="{Binding PlanBadge}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding DetailText}" Classes="row-desc"
                                                                               IsVisible="{Binding DetailText, Converter={StaticResource StringNotEmpty}}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_EditAccountTooltip}"
                                                                        IsVisible="{Binding IsCustomKey}"
                                                                        Command="{Binding #Root.DataContext.EditApiAccountCommand}"
                                                                        CommandParameter="{Binding}" VerticalAlignment="Center">
                                                                    <lucide:PackIconLucide Kind="Pencil" Width="13" Height="13" Foreground="{DynamicResource FgMutedBrush}" />
                                                                </Button>
                                                                <Button Grid.Column="2" Classes="icon-btn power-toggle" Classes.account-disabled="{Binding IsDisabled}"
                                                                        IsVisible="{Binding IsCustomKey, Converter={StaticResource InvertBool}}"
                                                                        IsEnabled="{Binding IsProviderEnabled}" ToolTip.Tip="{l:Loc ProvidersView_Provider_EnableDisableTooltip}"
                                                                        Click="OnToggleAccount" Tag="{Binding}" VerticalAlignment="Center">
                                                                    <lucide:PackIconLucide Kind="Power" Width="13" Height="13" />
                                                                </Button>
                                                                <Button Grid.Column="3" Classes="icon-btn" ToolTip.Tip="{l:Loc ProvidersView_Provider_RemoveAccountTooltip}"
                                                                        Command="{Binding #Root.DataContext.RemoveAccountCommand}"
                                                                        CommandParameter="{Binding}" VerticalAlignment="Center">
                                                                    <lucide:PackIconLucide Kind="Trash2" Width="13" Height="13" Foreground="#D46A6A" />
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Classes="row-divider" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="provider-row add-provider-row" Command="{Binding OpenAddCustomProviderCommand}"
                                ToolTip.Tip="{l:Loc ProvidersView_AddCustomProvider}">
                            <Grid ColumnDefinitions="48,Auto,*">
                                <Border Grid.Column="1" Classes="provider-logo" Width="28" Height="28"
                                        Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                    <lucide:PackIconLucide Kind="Plus" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="2" Classes="row-label" Text="{l:Loc ProvidersView_AddCustomProvider}"
                                           Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                      </StackPanel>
                    </Border>

                </StackPanel>

                <TextBlock Classes="section-label" Text="{l:Loc ProvidersView_Models_Section}" />
                <Border Classes="card">
                    <StackPanel>
                        <Grid Margin="16,12" ColumnDefinitions="30,*,Auto">
                            <Border Grid.Column="0" Classes="provider-logo" Background="{DynamicResource AccentSoftBrush}">
                                <lucide:PackIconLucide Kind="Brain" Width="16" Height="16"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Classes="row-label" Text="{l:Loc ProvidersView_Models_Title}" />
                                <TextBlock Classes="row-desc" Text="{l:Loc ProvidersView_Models_Description}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{l:LocFormat Key=ProvidersView_Models_TotalCount, Path=TotalAvailableModelCount}"
                                       Classes="status"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}}" />
                        </Grid>
                        <Border Classes="row-divider" />

                        <!-- Empty state -->
                        <StackPanel Margin="16,24,16,24" HorizontalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}, ConverterParameter=Invert}">
                            <lucide:PackIconLucide Kind="ServerOff" Width="28" Height="28"
                                                   Foreground="{DynamicResource FgFaintBrush}"
                                                   HorizontalAlignment="Center" />
                            <TextBlock Text="{l:Loc ProvidersView_Models_EmptyState}"
                                       FontSize="12"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Model groups -->
                        <ItemsControl ItemsSource="{Binding FocusedModelGroups}"
                                      IsVisible="{Binding ServerState, Converter={StaticResource StateIsRunning}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AvailableModelGroupViewModel">
                                    <StackPanel>
                                        <ToggleButton Classes="model-group" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                            <Grid ColumnDefinitions="30,*,Auto,24">
                                                <Border Grid.Column="0" Classes="provider-logo"
                                                        Background="{Binding LogoColor, Converter={StaticResource HexBrush}}">
                                                    <Panel>
                                                        <si:PackIconSimpleIcons Kind="{Binding IconKind}" Foreground="White"
                                                                                Width="14" Height="14"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                IsVisible="{Binding ShowSimpleIcon}" />
                                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 IsVisible="{Binding HasCustomIcon}">
                                                            <Path Data="{Binding CustomIconData}" Fill="White" Stretch="Uniform" />
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding Monogram}" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding UseMonogram}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Classes="row-label" Text="{Binding ProviderName}" />
                                                    <TextBlock Classes="row-desc" Text="{l:LocFormat Key=ProvidersView_Models_ModelCount, Path=ModelCount}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="chip" Background="#14000000" VerticalAlignment="Center">
                                                    <TextBlock Text="{l:LocFormat Key=ProvidersView_Models_ModelCount, Path=ModelCount}" Foreground="{DynamicResource FgMutedBrush}" />
                                                </Border>
                                                <Grid Grid.Column="3" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <lucide:PackIconLucide Kind="ChevronRight" Width="14" Height="14"
                                                                           Foreground="{DynamicResource FgMutedBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           IsVisible="{Binding !IsExpanded}" />
                                                    <lucide:PackIconLucide Kind="ChevronDown" Width="14" Height="14"
                                                                           Foreground="{DynamicResource FgMutedBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           IsVisible="{Binding IsExpanded}" />
                                                </Grid>
                                            </Grid>
                                        </ToggleButton>
                                        <ItemsControl ItemsSource="{Binding Models}" IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AvailableModelViewModel">
                                                    <Grid Margin="54,6,14,8" ColumnDefinitions="*,Auto,Auto">
                                                        <StackPanel Grid.Column="0" MinWidth="0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource FgBrush}" />
                                                            <TextBlock Classes="row-desc" Text="{Binding Context}"
                                                                       IsVisible="{Binding Context, Converter={StaticResource StringNotEmpty}}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Classes="chip" Background="#14000000"
                                                                Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Provider}" Foreground="{DynamicResource FgMutedBrush}" />
                                                        </Border>
                                                        <Border Grid.Column="2" Classes="chip"
                                                                Background="{DynamicResource AccentSoftBrush}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AuthKind}" Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Classes="row-divider" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
