<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TunnelAgent.ViewModels"
             xmlns:cv="using:TunnelAgent.Converters"
             xmlns:ctrl="using:TunnelAgent.Controls"
             xmlns:lucide="using:IconPacks.Avalonia.Lucide"
             xmlns:l="using:TunnelAgent.Services"
             x:Class="TunnelAgent.Views.LogsView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <cv:IntGreaterThanZeroConverter x:Key="IntGtZero" />
        <cv:StatusChipBrushConverter    x:Key="StatusChipBrush" />
        <cv:StatusChipFgConverter       x:Key="StatusChipFg" />
        <cv:InvertBoolConverter         x:Key="InvertBool" />
    </UserControl.Resources>

    <StackPanel Spacing="0">
        <!-- Header row: title + toolbar icons -->
        <Grid Margin="0,0,0,14" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="page-title" Text="{l:Loc LogsView_Title}" />
                <TextBlock Classes="page-sub" Text="{l:Loc LogsView_Subtitle}" />
            </StackPanel>
            <!-- Toolbar: Download · Refresh · Trash -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                <!-- Download: bounce down on hover -->
                <Button Classes="icon-btn" ToolTip.Tip="{l:Loc LogsView_ExportTooltip}"
                        RenderTransformOrigin="50%,50%"
                        Click="OnExportClick">
                    <Button.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                        </Transitions>
                    </Button.Transitions>
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="RenderTransform" Value="translateY(2px)" />
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="RenderTransform" Value="translateY(3px)" />
                        </Style>
                    </Button.Styles>
                    <lucide:PackIconLucide Kind="Download" Width="14" Height="14"
                                           Foreground="{DynamicResource FgMutedBrush}" />
                </Button>

                <!-- Refresh: spin icon on click -->
                <Button Classes="icon" ToolTip.Tip="{l:Loc LogsView_RefreshTooltip}" Click="OnRefreshLogs">
                    <lucide:PackIconLucide Kind="RefreshCw" Width="14" Height="14"
                                           Foreground="{DynamicResource FgMutedBrush}"
                                           Classes.spin="{Binding Logs.IsRefreshing}" />
                </Button>

                <!-- Requests: clear persisted usage history -->
                <Button Classes="icon-btn" ToolTip.Tip="{l:Loc Common_ClearUsageHistoryTooltip}"
                        Command="{Binding ShowClearUsageConfirmCommand}"
                        IsVisible="{Binding Logs.IsRequestsTab}"
                        RenderTransformOrigin="50%,50%">
                    <Button.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                        </Transitions>
                    </Button.Transitions>
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="RenderTransform" Value="scale(1.2)" />
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="RenderTransform" Value="scale(0.9)" />
                        </Style>
                    </Button.Styles>
                    <lucide:PackIconLucide Kind="Trash2" Width="14" Height="14"
                                           Foreground="#D46A6A" />
                </Button>

                <!-- Proxy logs: clear view only -->
                <Button Classes="icon-btn" ToolTip.Tip="{l:Loc LogsView_ClearViewTooltip}"
                        Command="{Binding ClearLogsCommand}"
                        IsVisible="{Binding Logs.IsProxyLogsTab}"
                        RenderTransformOrigin="50%,50%">
                    <Button.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                        </Transitions>
                    </Button.Transitions>
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="RenderTransform" Value="scale(1.2)" />
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="RenderTransform" Value="scale(0.9)" />
                        </Style>
                    </Button.Styles>
                    <lucide:PackIconLucide Kind="Eraser" Width="14" Height="14"
                                           Foreground="{DynamicResource FgMutedBrush}" />
                </Button>

                <!-- Proxy logs: delete log file with confirmation -->
                <Button Classes="icon-btn" ToolTip.Tip="{l:Loc LogsView_DeleteLogFileTooltip}"
                        Command="{Binding ShowDeleteLogsConfirmCommand}"
                        IsVisible="{Binding Logs.IsProxyLogsTab}"
                        RenderTransformOrigin="50%,50%">
                    <Button.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                        </Transitions>
                    </Button.Transitions>
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="RenderTransform" Value="scale(1.2)" />
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="RenderTransform" Value="scale(0.9)" />
                        </Style>
                    </Button.Styles>
                    <lucide:PackIconLucide Kind="Trash2" Width="14" Height="14"
                                           Foreground="#D46A6A" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tab bar: Requests | Proxy Logs -->
        <ctrl:SlidingTabBar Margin="0,0,0,14"
                            SelectedIndex="{Binding Logs.SelectedTabIndex}">
            <ctrl:SlidingTabBar.Tabs>
                <ctrl:SlidingTab Header="{l:Loc LogsView_TabRequests}"   Command="{Binding Logs.SelectRequestsTabCommand}" />
                <ctrl:SlidingTab Header="{l:Loc LogsView_TabProxyLogs}" Command="{Binding Logs.SelectProxyLogsTabCommand}" />
            </ctrl:SlidingTabBar.Tabs>
        </ctrl:SlidingTabBar>

        <!-- ══════════════════════════════════════════════
             REQUESTS TAB
             ══════════════════════════════════════════════ -->
        <StackPanel Spacing="0"
                    IsVisible="{Binding Logs.IsRequestsTab}">

            <!-- Stats bar + Provider dropdown -->
            <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Classes="row-desc" Text="{l:Loc LogsView_Requests_Total}" />
                    <TextBlock Classes="row-label" FontSize="15" FontWeight="SemiBold"
                               Text="{Binding Logs.TotalRequests}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Classes="row-desc" Text="{l:Loc LogsView_Requests_Success}" />
                    <TextBlock Classes="row-label" FontSize="15" FontWeight="SemiBold"
                               Text="{Binding Logs.SuccessRate}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <TextBlock Classes="row-desc" Text="{l:Loc LogsView_Requests_AvgTime}" />
                    <TextBlock Classes="row-label" FontSize="15" FontWeight="SemiBold"
                               Text="{Binding Logs.AvgTime}" />
                </StackPanel>

                <!-- Provider/model filters — ComboBoxes on the right -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="0,0,10,0">
                    <TextBlock Classes="row-desc" VerticalAlignment="Center" Text="{l:Loc LogsView_Requests_ProviderLabel}" />
                    <ComboBox ItemsSource="{Binding Logs.ProviderOptions}"
                              SelectedItem="{Binding Logs.SelectedProvider, Mode=TwoWay}"
                              MinWidth="120"
                              FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Classes="row-desc" VerticalAlignment="Center" Text="{l:Loc LogsView_Requests_ModelLabel}" />
                    <ComboBox ItemsSource="{Binding Logs.ModelOptions}"
                              SelectedItem="{Binding Logs.SelectedModel, Mode=TwoWay}"
                              MinWidth="140"
                              FontSize="12" />
                </StackPanel>
            </Grid>

            <!-- Search bar -->
            <Border Margin="0,0,0,10"
                    Background="{DynamicResource BtnBgBrush}"
                    BorderBrush="{DynamicResource BtnBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,0">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <lucide:PackIconLucide Grid.Column="0" Kind="Search" Width="13" Height="13"
                                           Foreground="{DynamicResource FgFaintBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4,8"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Watermark="{l:Loc LogsView_Requests_SearchPlaceholder}"
                             Text="{Binding Logs.SearchText, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Request list card -->
            <Border Classes="card">
                <Panel>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="6" Margin="0,40"
                                IsVisible="{Binding Logs.TotalRequests, Converter={StaticResource IntGtZero},
                                            ConverterParameter=invert, FallbackValue=True}">
                        <lucide:PackIconLucide Kind="FileText" Width="28" Height="28"
                                              HorizontalAlignment="Center"
                                              Foreground="{DynamicResource FgFaintBrush}" />
                        <TextBlock Classes="row-desc" Text="{l:Loc LogsView_Requests_EmptyTitle}" HorizontalAlignment="Center" />
                        <TextBlock Classes="row-desc" Text="{l:Loc LogsView_Requests_EmptyDescription}"
                                   HorizontalAlignment="Center" Opacity="0.6" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Logs.FilteredEntries}"
                                  IsVisible="{Binding Logs.TotalRequests, Converter={StaticResource IntGtZero}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RequestLogEntry">
                                <StackPanel>
                                    <Grid Margin="14,10" ColumnDefinitions="40,*,Auto,Auto,Auto">
                                        <!-- Status badge -->
                                        <Border Grid.Column="0"
                                                Classes="chip"
                                                Background="{Binding IsSuccess, Converter={StaticResource StatusChipBrush}}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusCode}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding IsSuccess, Converter={StaticResource StatusChipFg}}" />
                                        </Border>
                                        <!-- Provider + path -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="row-label" FontSize="12" Text="{Binding Provider}" />
                                                <Ellipse Width="3" Height="3"
                                                         Fill="{DynamicResource FgFaintBrush}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Classes="row-desc"
                                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                                           FontSize="11"
                                                           MaxWidth="220"
                                                           Text="{Binding Model}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock FontFamily="Cascadia Mono,Consolas,monospace"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgMutedBrush}"
                                                       Text="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Method -->
                                        <TextBlock Grid.Column="2"
                                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource FgFaintBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" Text="{Binding Method}" />
                                        <!-- Latency -->
                                        <TextBlock Grid.Column="3"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   MinWidth="50"
                                                   TextAlignment="Right"
                                                   Text="{Binding LatencyRaw}" />
                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="4"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource FgFaintBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   MinWidth="118"
                                                   TextAlignment="Right"
                                                   Text="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" />
                                    </Grid>
                                    <Border Classes="row-divider" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Border>

            <!-- Pagination -->
            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto"
                  IsVisible="{Binding Logs.TotalRequests, Converter={StaticResource IntGtZero}}">
                <Button Grid.Column="0" Classes="app"
                        Content="{l:Loc LogsView_Requests_PrevButton}"
                        FontSize="11" Padding="10,4"
                        IsEnabled="{Binding Logs.CanGoPrev}"
                        Command="{Binding Logs.PrevPageCommand}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Logs.PageLabel}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource FgMutedBrush}" />
                <Button Grid.Column="2" Classes="app"
                        Content="{l:Loc LogsView_Requests_NextButton}"
                        FontSize="11" Padding="10,4"
                        IsEnabled="{Binding Logs.CanGoNext}"
                        Command="{Binding Logs.NextPageCommand}" />
            </Grid>
        </StackPanel>

        <!-- ══════════════════════════════════════════════
             PROXY LOGS TAB
             ══════════════════════════════════════════════ -->
        <StackPanel Spacing="0"
                    IsVisible="{Binding Logs.IsProxyLogsTab}">

            <!-- Search bar -->
            <Border Margin="0,0,0,10"
                    Background="{DynamicResource BtnBgBrush}"
                    BorderBrush="{DynamicResource BtnBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,0">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <lucide:PackIconLucide Grid.Column="0" Kind="Search" Width="13" Height="13"
                                           Foreground="{DynamicResource FgFaintBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4,8"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Watermark="{l:Loc LogsView_ProxyLogs_SearchPlaceholder}"
                             Text="{Binding Logs.ProxyLogsSearch, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Log lines card -->
            <Border Classes="card">
                <Panel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="6" Margin="0,40"
                                IsVisible="{Binding Logs.ProxyLogLines.Count,
                                            Converter={StaticResource IntGtZero},
                                            ConverterParameter=invert, FallbackValue=True}">
                        <lucide:PackIconLucide Kind="FileText" Width="28" Height="28"
                                              HorizontalAlignment="Center"
                                              Foreground="{DynamicResource FgFaintBrush}" />
                        <TextBlock Classes="row-desc" Text="{l:Loc LogsView_ProxyLogs_EmptyTitle}" HorizontalAlignment="Center" />
                        <TextBlock Classes="row-desc" Text="{l:Loc LogsView_ProxyLogs_EmptyDescription}"
                                   HorizontalAlignment="Center" Opacity="0.6" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Logs.ProxyLogLines}"
                                  IsVisible="{Binding Logs.ProxyLogLines.Count, Converter={StaticResource IntGtZero}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel>
                                    <TextBlock FontFamily="Cascadia Mono,Consolas,monospace"
                                               FontSize="11"
                                               Foreground="{DynamicResource FgMutedBrush}"
                                               Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Margin="14,6" />
                                    <Border Classes="row-divider" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
