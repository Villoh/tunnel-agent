<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TunnelAgent.ViewModels"
             xmlns:nineRouter="using:TunnelAgent.Infrastructure.Engine.NineRouter"
             xmlns:ctrl="using:TunnelAgent.Controls"
             xmlns:lucide="using:IconPacks.Avalonia.Lucide"
             xmlns:l="using:TunnelAgent.Services"
             x:Class="TunnelAgent.Views.DashboardView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
               <Color x:Key="ChartLineColor">#F2A33C</Color>
        <SolidColorBrush x:Key="ChartLineBrush" Color="#F2A33C" />
        <LinearGradientBrush x:Key="ChartAreaBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#59F2A33C" />
            <GradientStop Offset="1" Color="#00F2A33C" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Stat-card labels: cancel section-label's 4px horizontal inset so the label
             aligns with its value/number (which sit at the card padding edge). -->
        <Style Selector="Border.card &gt; StackPanel &gt; TextBlock.section-label">
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16" Margin="0,0,0,8">

        <!-- Page header -->
        <StackPanel>
            <TextBlock Classes="page-title" Text="{l:Loc DashboardView_Title}" />
            <TextBlock Classes="page-sub" Text="{l:Loc DashboardView_Subtitle}" />
        </StackPanel>

        <ctrl:SlidingTabBar HorizontalAlignment="Left" MinWidth="280" SelectedIndex="{Binding HomeDashboardTabIndex}">
            <ctrl:SlidingTabBar.Tabs>
                <ctrl:SlidingTab Header="{l:Loc DashboardView_Tab_Local}" Command="{Binding SelectHomeDashboardTabCommand}" CommandParameter="LocalProxy" />
                <ctrl:SlidingTab Header="{l:Loc DashboardView_Tab_NineRouter}" Command="{Binding SelectHomeDashboardTabCommand}" CommandParameter="NineRouter" />
            </ctrl:SlidingTabBar.Tabs>
        </ctrl:SlidingTabBar>

        <!-- Toolbar: range tabs + refresh -->
        <Border Classes="card" Padding="14" IsVisible="{Binding IsLocalHomeDashboardTab}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <ctrl:SlidingTabBar Grid.Column="0" HorizontalAlignment="Left"
                                        MinWidth="420"
                                        SelectedIndex="{Binding Dashboard.RangeIndex}">
                        <ctrl:SlidingTabBar.Tabs>
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Range_Today}"
                                             Command="{Binding Dashboard.SelectRangeCommand}" CommandParameter="Today" />
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Range_7d}"
                                             Command="{Binding Dashboard.SelectRangeCommand}" CommandParameter="Last7Days" />
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Range_14d}"
                                             Command="{Binding Dashboard.SelectRangeCommand}" CommandParameter="Last14Days" />
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Range_30d}"
                                             Command="{Binding Dashboard.SelectRangeCommand}" CommandParameter="Last30Days" />
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Range_All}"
                                             Command="{Binding Dashboard.SelectRangeCommand}" CommandParameter="All" />
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Range_Custom}"
                                             Command="{Binding Dashboard.SelectRangeCommand}" CommandParameter="Custom" />
                        </ctrl:SlidingTabBar.Tabs>
                    </ctrl:SlidingTabBar>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="icon"
                                ToolTip.Tip="{l:Loc DashboardView_Refresh}"
                                Command="{Binding Dashboard.RefreshCommand}">
                            <lucide:PackIconLucide Kind="RefreshCw" Width="14" Height="14"
                                                   Classes.spin="{Binding Dashboard.IsRefreshing}" />
                        </Button>
                        <Button Classes="icon"
                                ToolTip.Tip="{l:Loc Common_ClearUsageHistoryTooltip}"
                                Command="{Binding ShowClearUsageConfirmCommand}">
                            <lucide:PackIconLucide Kind="Trash2" Width="14" Height="14" Foreground="#D46A6A" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Custom date range: single Fluent-style range picker, shown only in Custom mode -->
                <ctrl:DateRangePicker IsVisible="{Binding Dashboard.IsCustomRange}"
                                      Start="{Binding Dashboard.CustomStart}"
                                      End="{Binding Dashboard.CustomEnd}"
                                      Watermark="{l:Loc DashboardView_Range_SelectRange}" />
            </StackPanel>
        </Border>

        <!-- 9Router live usage -->
        <Border Background="#18F59E0B" BorderBrush="#44F59E0B" BorderThickness="1" CornerRadius="8" Padding="10"
                IsVisible="{Binding ShowNineRouterUsageWarning}">
            <StackPanel Spacing="4">
                <TextBlock Classes="row-label" Text="{l:Loc Fallback_AddModelPopup_ServerWarning_Title}" />
                <TextBlock Classes="row-desc" TextWrapping="Wrap" Text="{l:Loc DashboardView_NineRouter_EngineNotRunning}" />
            </StackPanel>
        </Border>
        <Border Classes="card" Padding="18" IsVisible="{Binding ShowNineRouterUsage}">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="{l:Loc DashboardView_NineRouter_Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Classes="row-desc" Text="{l:Loc DashboardView_NineRouter_Subtitle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:Loc DashboardView_Refresh}"
                            Command="{Binding NineRouterUsage.RefreshCommand}">
                        <lucide:PackIconLucide Kind="RefreshCw" Width="14" Height="14"
                                               Classes.spin="{Binding NineRouterUsage.IsBusy}" />
                    </Button>
                </Grid>

                <TextBlock Text="{Binding NineRouterUsage.ErrorMessage}" Foreground="{DynamicResource ErrBrush}"
                           IsVisible="{Binding NineRouterUsage.HasError}" />

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="card" Padding="14,12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc DashboardView_NineRouter_Requests}" />
                            <TextBlock Text="{Binding NineRouterUsage.TotalRequests}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Padding="14,12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc DashboardView_NineRouter_Tokens}" />
                            <TextBlock Text="{Binding NineRouterUsage.TotalTokens}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Classes="row-desc" Text="{l:LocFormat Key=DashboardView_NineRouter_Cached, Path=NineRouterUsage.CachedTokens}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card" Padding="14,12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc DashboardView_NineRouter_Cost}" />
                            <TextBlock Text="{Binding NineRouterUsage.TotalCost}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="card" Padding="14,12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="{l:Loc DashboardView_NineRouter_Active}" />
                            <TextBlock Text="{Binding NineRouterUsage.ActiveRequestCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="8" IsVisible="{Binding NineRouterUsage.HasActiveRequests}">
                    <TextBlock Text="{l:Loc DashboardView_NineRouter_ActiveRequests}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding NineRouterUsage.ActiveRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="nineRouter:NineRouterActiveRequest">
                                <Grid ColumnDefinitions="2*,2*,2*,Auto" Margin="4,0">
                                    <TextBlock Grid.Column="0" Text="{Binding Provider}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Account}" Foreground="{DynamicResource FgMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Count}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{l:Loc DashboardView_NineRouter_ByProvider}" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="3*,*,*,*,*" Margin="4,0">
                        <TextBlock Grid.Column="0" Classes="section-label" Text="{l:Loc DashboardView_Summary_Provider}" />
                        <TextBlock Grid.Column="1" Classes="section-label" Text="{l:Loc DashboardView_Summary_Calls}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Classes="section-label" Text="{l:Loc DashboardView_Summary_Tokens}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Classes="section-label" Text="{l:Loc DashboardView_NineRouter_CachedLabel}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="section-label" Text="{l:Loc DashboardView_Summary_Cost}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding NineRouterUsage.ProviderRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NineRouterUsageProviderRow">
                                <Grid ColumnDefinitions="3*,*,*,*,*" Margin="4,0">
                                    <TextBlock Grid.Column="0" Text="{Binding Provider}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Requests}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding Tokens}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding CachedTokens}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding Cost}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{l:Loc DashboardView_NineRouter_Empty}" Classes="row-desc"
                               IsVisible="{Binding !NineRouterUsage.HasProviderRows}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{l:Loc DashboardView_NineRouter_RequestDetails}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding NineRouterUsage.PageLabel}" Classes="row-desc" />
                    </Grid>
                    <Grid ColumnDefinitions="1.1*,2*,1.4*,*,*,*,1.5*" Margin="4,0">
                        <TextBlock Grid.Column="0" Classes="section-label" Text="{l:Loc DashboardView_Summary_Provider}" />
                        <TextBlock Grid.Column="1" Classes="section-label" Text="{l:Loc DashboardView_Summary_Model}" />
                        <TextBlock Grid.Column="2" Classes="section-label" Text="{l:Loc DashboardView_NineRouter_Connection}" />
                        <TextBlock Grid.Column="3" Classes="section-label" Text="{l:Loc DashboardView_NineRouter_Status}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="section-label" Text="{l:Loc DashboardView_Summary_Tokens}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Classes="section-label" Text="{l:Loc DashboardView_NineRouter_Latency}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Classes="section-label" Text="{l:Loc DashboardView_Summary_Last}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding NineRouterUsage.RequestRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NineRouterUsageRequestRow">
                                <Grid ColumnDefinitions="1.1*,2*,1.4*,*,*,*,1.5*" Margin="4,0">
                                    <TextBlock Grid.Column="0" Text="{Binding Provider}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Connection}" Foreground="{DynamicResource FgMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding Tokens}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{Binding Latency}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="{Binding Timestamp}" HorizontalAlignment="Right" Foreground="{DynamicResource FgFaintBrush}" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{l:Loc DashboardView_NineRouter_RequestDetailsEmpty}" Classes="row-desc"
                               IsVisible="{Binding !NineRouterUsage.HasRequestRows}" />

                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                IsVisible="{Binding NineRouterUsage.HasRequestRows}">
                        <Button Classes="icon-btn" IsVisible="{Binding NineRouterUsage.CanGoPrev}" Command="{Binding NineRouterUsage.FirstPageCommand}">
                            <lucide:PackIconLucide Kind="ChevronsLeft" Width="14" Height="14" />
                        </Button>
                        <Button Classes="icon-btn" IsVisible="{Binding NineRouterUsage.CanGoPrev}" Command="{Binding NineRouterUsage.PrevPageCommand}">
                            <lucide:PackIconLucide Kind="ChevronLeft" Width="14" Height="14" />
                        </Button>
                        <ItemsControl ItemsSource="{Binding NineRouterUsage.PageNavigationItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogPageItem">
                                    <Panel>
                                        <Button Classes="icon-btn page" Classes.current="{Binding IsCurrent}" MinWidth="24" Padding="6,4"
                                                Content="{Binding Label}" IsVisible="{Binding !IsEllipsis}"
                                                Command="{Binding $parent[ItemsControl].DataContext.NineRouterUsage.GoToPageCommand}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Label}" IsVisible="{Binding IsEllipsis}" Padding="6,4" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="icon-btn" IsVisible="{Binding NineRouterUsage.CanGoNext}" Command="{Binding NineRouterUsage.NextPageCommand}">
                            <lucide:PackIconLucide Kind="ChevronRight" Width="14" Height="14" />
                        </Button>
                        <Button Classes="icon-btn" IsVisible="{Binding NineRouterUsage.CanGoNext}" Command="{Binding NineRouterUsage.LastPageCommand}">
                            <lucide:PackIconLucide Kind="ChevronsRight" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Stat cards row 1 -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" IsVisible="{Binding IsLocalHomeDashboardTab}">
            <Border Grid.Column="0" Classes="card" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Card_TotalCalls}" />
                    <TextBlock Text="{Binding Dashboard.TotalCalls}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Classes="row-desc" Text="{l:LocFormat Key=DashboardView_Card_TotalCalls_Sub, Path=Dashboard.ProviderSummaryCount}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Card_SuccessRate}" />
                    <TextBlock Text="{Binding Dashboard.SuccessRate}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource OkBrush}" />
                    <TextBlock Classes="row-desc" Text="{l:LocFormat Key=DashboardView_Card_SuccessRate_Sub, Path=Dashboard.SuccessCount}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Card_Failures}" />
                    <TextBlock Text="{Binding Dashboard.FailureCount}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource ErrBrush}" />
                    <TextBlock Classes="row-desc" Text="{l:LocFormat Key=DashboardView_Card_Failures_Sub, Path=Dashboard.FailureRate}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Card_EstCost}" />
                    <TextBlock Text="{Binding Dashboard.EstimatedCost}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource WarnBrush}" />
                    <TextBlock Classes="row-desc" Text="{l:Loc DashboardView_Card_EstCost_Sub}"
                               IsVisible="{Binding Dashboard.HasCost}" />
                    <TextBlock Classes="row-desc" Text="{l:Loc DashboardView_Card_EstCost_NoData}"
                               IsVisible="{Binding !Dashboard.HasCost}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Stat cards row 2 (tokens — placeholder) -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" IsVisible="{Binding IsLocalHomeDashboardTab}">
            <Border Grid.Column="0" Classes="card" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Card_TotalTokens}" />
                    <TextBlock Text="{Binding Dashboard.TotalTokens}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Classes="row-desc" Text="{l:LocFormat Key=DashboardView_Card_TotalTokens_Sub, Path=Dashboard.ReasoningTokens}"
                               IsVisible="{Binding Dashboard.HasTokenData}" />
                    <TextBlock Classes="row-desc" Text="{l:Loc DashboardView_Card_Tokens_Sub}"
                               IsVisible="{Binding !Dashboard.HasTokenData}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Card_InputTokens}" />
                    <TextBlock Text="{Binding Dashboard.InputTokens}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Classes="row-desc" Text="{l:LocFormat Key=DashboardView_Card_Ratio_Sub, Path=Dashboard.InputTokenRatio}"
                               IsVisible="{Binding Dashboard.HasTokenData}" />
                    <TextBlock Classes="row-desc" Text="{l:Loc DashboardView_Card_Tokens_Sub}"
                               IsVisible="{Binding !Dashboard.HasTokenData}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Card_OutputTokens}" />
                    <TextBlock Text="{Binding Dashboard.OutputTokens}" FontSize="26" FontWeight="Bold"
Foreground="{DynamicResource AccentBrush}" />
<TextBlock Classes="row-desc" Text="{l:LocFormat Key=DashboardView_Card_Ratio_Sub, Path=Dashboard.OutputTokenRatio}"
                               IsVisible="{Binding Dashboard.HasTokenData}" />
                    <TextBlock Classes="row-desc" Text="{l:Loc DashboardView_Card_Tokens_Sub}"
                               IsVisible="{Binding !Dashboard.HasTokenData}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Card_CacheTokens}" />
                    <TextBlock Text="{Binding Dashboard.CacheTokens}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Classes="row-desc" Text="{l:LocFormat Key=DashboardView_Card_CacheHit_Sub, Path=Dashboard.CacheHitRate}"
                               IsVisible="{Binding Dashboard.HasTokenData}" />
                    <TextBlock Classes="row-desc" Text="{l:Loc DashboardView_Card_Tokens_Sub}"
                               IsVisible="{Binding !Dashboard.HasTokenData}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Usage chart -->
        <Border Classes="card" Padding="18" IsVisible="{Binding IsLocalHomeDashboardTab}">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{l:Loc DashboardView_Chart_Title}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                        <TextBlock Classes="row-desc" Text="{l:Loc DashboardView_Chart_Subtitle}" />
                    </StackPanel>
                    <ctrl:SlidingTabBar Grid.Column="1" MinWidth="280"
                                        SelectedIndex="{Binding Dashboard.ChartMetricIndex}">
                        <ctrl:SlidingTabBar.Tabs>
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Chart_Calls}"
                                             Command="{Binding Dashboard.SelectChartMetricCommand}" CommandParameter="Calls" />
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Chart_Tokens}"
                                             Command="{Binding Dashboard.SelectChartMetricCommand}" CommandParameter="Tokens" />
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Chart_Cost}"
                                             Command="{Binding Dashboard.SelectChartMetricCommand}" CommandParameter="Cost" />
                        </ctrl:SlidingTabBar.Tabs>
                    </ctrl:SlidingTabBar>
                </Grid>

                <Panel Height="240">
                    <ctrl:UsageChart Values="{Binding Dashboard.ChartValues}"
                                     Labels="{Binding Dashboard.ChartLabels}"
                                     LineBrush="{StaticResource ChartLineBrush}"
                                     AreaBrush="{StaticResource ChartAreaBrush}"
                                     GridBrush="{DynamicResource RowDividerBrush}"
                                     GridLines="4"
                                     IsVisible="{Binding Dashboard.HasData}" />
                    <TextBlock Text="{l:Loc DashboardView_Chart_Empty}"
                               Foreground="{DynamicResource FgFaintBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !Dashboard.HasData}" />
                    <TextBlock Text="{Binding Dashboard.ChartAxisMax}" FontSize="11"
                               Foreground="{DynamicResource FgFaintBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Panel>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Dashboard.HasData}">
                    <TextBlock Grid.Column="0" Text="{Binding Dashboard.ChartAxisStart}" FontSize="11"
                               Foreground="{DynamicResource FgFaintBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.ChartAxisEnd}" FontSize="11"
                               Foreground="{DynamicResource FgFaintBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Usage summary (by provider / by model) -->
        <Border Classes="card" IsVisible="{Binding IsLocalHomeDashboardTab}">
            <StackPanel>
                <Grid Margin="16,14,16,10" ColumnDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Column="0" Text="{l:Loc DashboardView_Summary_Title}"
                               FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="chip" Background="{DynamicResource AccentSoftBrush}"
                            Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Dashboard.SummaryRowCount}"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                    </Border>
                    <ctrl:SlidingTabBar Grid.Column="2" HorizontalAlignment="Right" MinWidth="240"
                                        SelectedIndex="{Binding Dashboard.SummaryModeIndex}">
                        <ctrl:SlidingTabBar.Tabs>
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Summary_ByProvider}"
                                             Command="{Binding Dashboard.SelectSummaryModeCommand}" CommandParameter="Provider" />
                            <ctrl:SlidingTab Header="{l:Loc DashboardView_Summary_ByModel}"
                                             Command="{Binding Dashboard.SelectSummaryModeCommand}" CommandParameter="Model" />
                        </ctrl:SlidingTabBar.Tabs>
                    </ctrl:SlidingTabBar>
                </Grid>

                <Border Classes="row-divider" />

                <!-- Column headers -->
                <Grid Margin="16,10,16,8"
                      ColumnDefinitions="3*,0.8*,0.8*,0.8*,0.9*,1*,1*,1.4*">
                    <Panel Grid.Column="0">
                        <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Summary_Provider}"
                                   IsVisible="{Binding !Dashboard.IsModelSummary}" />
                        <TextBlock Classes="section-label" Text="{l:Loc DashboardView_Summary_Model}"
                                   IsVisible="{Binding Dashboard.IsModelSummary}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Classes="section-label" Text="{l:Loc DashboardView_Summary_Calls}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Classes="section-label" Text="{l:Loc DashboardView_Summary_Success}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Classes="section-label" Text="{l:Loc DashboardView_Summary_Fail}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Classes="section-label" Text="{l:Loc DashboardView_Summary_Rate}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Classes="section-label" Text="{l:Loc DashboardView_Summary_Tokens}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Classes="section-label" Text="{l:Loc DashboardView_Summary_Cost}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Classes="section-label" Text="{l:Loc DashboardView_Summary_Last}" HorizontalAlignment="Right" />
                </Grid>

                <Border Classes="row-divider" />

                <ItemsControl ItemsSource="{Binding Dashboard.SummaryRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UsageSummaryRow">
                            <StackPanel>
                                <Grid Margin="16,11" ColumnDefinitions="3*,0.8*,0.8*,0.8*,0.9*,1*,1*,1.4*">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalCalls}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SuccessCount}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding FailureCount}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource ErrBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding SuccessRate}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding TotalTokens}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding EstimatedCost}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Text="{Binding LastRequest}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource FgFaintBrush}" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <Border Classes="row-divider" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l:Loc DashboardView_Summary_Empty}"
                           Foreground="{DynamicResource FgFaintBrush}"
                           Margin="16,18" HorizontalAlignment="Center"
                           IsVisible="{Binding !Dashboard.HasData}" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
