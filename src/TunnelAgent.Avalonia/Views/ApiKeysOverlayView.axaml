<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TunnelAgent.ViewModels"
             xmlns:cv="using:TunnelAgent.Converters"
             xmlns:lucide="using:IconPacks.Avalonia.Lucide"
             xmlns:l="using:TunnelAgent.Services"
             x:Class="TunnelAgent.Views.ApiKeysOverlayView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <cv:SecretPasswordCharConverter x:Key="SecretPasswordChar" />
        <cv:BoolToEyeIconConverter x:Key="EyeIcon" />
    </UserControl.Resources>
<Border x:Name="ApiKeysOverlay" IsVisible="{Binding ShowApiKeysDialog}" Background="#88000000"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="50"
        KeyDown="OnApiKeysDialogKeyDown" Focusable="True"
        PointerPressed="OnApiKeysOverlayPressed">
    <Border Classes="card" Width="480" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0"
            PointerPressed="OnDialogCardPressed">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" Margin="24,20,24,14" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="row-label" FontSize="15" Text="{Binding ApiKeysDialogTitle}" />
                    <TextBlock Classes="row-desc" TextWrapping="Wrap"
                               Text="{Binding ApiKeysDialogDescription}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="icon" Command="{Binding DismissApiKeysCommand}" VerticalAlignment="Top">
                    <lucide:PackIconLucide Kind="X" Width="14" Height="14" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Margin="24,0,24,0">
                    <ItemsControl ItemsSource="{Binding ApiKeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApiKeyViewModel">
                                <Border Background="{DynamicResource SideBgBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" IsVisible="{Binding HasName}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Masked}"
                                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <Border Classes="chip" Background="{DynamicResource AccentSoftBrush}"
                                                    IsVisible="{Binding IsDefault}">
                                                <TextBlock Text="{l:Loc ApiKeysOverlay_DefaultChip}" Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="app" Content="{l:Loc ApiKeysOverlay_UseButton}"
                                                Margin="8,0,4,0" Padding="8,0"
                                                Height="24" MinHeight="0"
                                                VerticalContentAlignment="Center"
                                                IsVisible="{Binding CanSetDefault}"
                                                Command="{Binding #Root.DataContext.SetDefaultApiKeyCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Classes="icon-btn"
                                                ToolTip.Tip="{l:Loc ApiKeysOverlay_RemoveKeyTooltip}"
                                                IsVisible="{Binding CanRemove}"
                                                Command="{Binding #Root.DataContext.RemoveApiKeyCommand}"
                                                CommandParameter="{Binding}">
                                            <lucide:PackIconLucide Kind="Trash2" Width="13" Height="13"
                                                                   Foreground="{DynamicResource FgMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="row-desc" Text="{Binding ApiKeyDraftLabel}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Classes="app"
                                     PasswordChar="{Binding IsApiKeyDraftSecret, Converter={StaticResource SecretPasswordChar}}"
                                     Watermark="{Binding ApiKeyDraftWatermark}"
                                     Text="{Binding ApiKeyDraft, Mode=TwoWay}"
                                     KeyDown="OnApiKeyDraftKeyDown" />
                            <Button Grid.Column="1" Classes="icon-btn" Margin="8,0,0,0"
                                    ToolTip.Tip="{l:Loc ApiKeysOverlay_ShowHideKeyTooltip}"
                                    IsVisible="{Binding IsApiKeyDraftSecret}"
                                    Command="{Binding ToggleApiKeyDraftVisibilityCommand}">
                                <lucide:PackIconLucide Kind="{Binding ShowApiKeyDraft, Converter={StaticResource EyeIcon}}" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="24,14,24,20">
                <Button Classes="app" Content="{l:Loc ApiKeysOverlay_CloseButton}" Command="{Binding DismissApiKeysCommand}" />
                <Button Classes="app primary" Content="{l:Loc ApiKeysOverlay_AddKeyButton}" Command="{Binding AddApiKeyCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</Border>

</UserControl>
