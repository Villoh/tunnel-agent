<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TunnelAgent.ViewModels"
             xmlns:cv="using:TunnelAgent.Converters"
             xmlns:lucide="using:IconPacks.Avalonia.Lucide"
             xmlns:ctrl="using:TunnelAgent.Controls"
             xmlns:l="using:TunnelAgent.Services"
             x:Class="TunnelAgent.Views.ConfigurationView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <cv:EngineStateToTextConverter x:Key="EngineStateToText" />
        <cv:SectionEqualsConverter x:Key="SectionEq" />
        <cv:ServerStateToTextConverter x:Key="StateToText" />
        <cv:ServerStateToBrushConverter x:Key="StateToBrush" />
        <cv:ServerStateRunningConverter x:Key="StateIsRunning" />
    </UserControl.Resources>

    <Panel>
        <ScrollViewer x:Name="ConfigurationScrollViewer">
            <StackPanel x:Name="ConfigurationContent" Spacing="0">

                <!-- ── Tab bar ──────────────────────────────────────────── -->
                <ctrl:SlidingTabBar Margin="0,0,0,16"
                                    SelectedIndex="{Binding ConfigTabIndex}">
                    <ctrl:SlidingTabBar.Tabs>
                        <ctrl:SlidingTab Header="{l:Loc ConfigView_TabGeneral}"    Command="{Binding SelectConfigGeneralCommand}" />
                        <ctrl:SlidingTab Header="{l:Loc ConfigView_TabCLIProxyAPI}" Command="{Binding SelectConfigCliProxyCommand}" />
                        <ctrl:SlidingTab Header="{l:Loc ConfigView_TabNineRouter}" Command="{Binding SelectConfigNineRouterCommand}" />
                        <ctrl:SlidingTab Header="{l:Loc ConfigView_TabPerplexity}" Command="{Binding SelectConfigPerplexityCommand}" />
                    </ctrl:SlidingTabBar.Tabs>
                </ctrl:SlidingTabBar>

                <!-- ══ GENERAL ══════════════════════════════════════════ -->
                <StackPanel IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=ConfigGeneral}">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Classes="page-title" Text="{l:Loc ConfigView_General_Title}" />
                        <TextBlock Classes="page-sub" Text="{l:Loc ConfigView_General_Subtitle}" />
                    </StackPanel>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_General_TunnelAgentSection}"/>
                    <Border Classes="card" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_General_TunnelAgent_Label}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                        <TextBlock Classes="row-desc" Text="{l:LocFormat Key=ConfigView_General_TunnelAgent_Installed, Path=AppVersion}" />
                                        <TextBlock Classes="row-desc" Text="→" IsVisible="{Binding AppUpdateAvailable}" />
                                        <TextBlock Classes="row-desc" Foreground="{DynamicResource AccentBrush}"
                                                   Text="{l:LocFormat Key=ConfigView_General_TunnelAgent_Available, Path=AppUpdateNewVersion}"
                                                   IsVisible="{Binding AppUpdateAvailable}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="app" Content="{l:Loc ConfigView_General_TunnelAgent_Check}"
                                            Command="{Binding CheckForAppUpdateCommand}"
                                            IsVisible="{Binding !AppUpdateAvailable}" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_General_TunnelAgent_Download}"
                                            Command="{Binding DownloadAppUpdateCommand}"
                                            IsVisible="{Binding AppUpdateAvailable}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="14,0,14,11"
                                        IsVisible="{Binding AppUpdateDownloading}">
                                <ProgressBar Value="{Binding AppUpdateDownloadProgress}" Minimum="0" Maximum="100"
                                             Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource RowDividerBrush}" />
                                <TextBlock Classes="row-desc" Margin="0,4,0,0"
                                           Text="{l:LocFormat Key=Toast_Downloading, Path=AppUpdateDownloadProgress}" />
                            </StackPanel>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_General_TunnelAgent_AutoCheck_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_General_TunnelAgent_AutoCheck_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding AutoCheckForAppUpdates, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_General_AppSection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_General_LaunchAtLogin_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_General_LaunchAtLogin_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"
                                              IsEnabled="{Binding IsLaunchAtLoginSupported}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_General_Theme_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_General_Theme_Description}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeModes}"
                                          SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"
                                          Width="155" Height="26" MinHeight="0" Padding="8,0" VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_General_Language_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_General_Language_Description}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SupportedLanguages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          Width="155" Height="26" MinHeight="0" Padding="8,0" VerticalContentAlignment="Center" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_General_MaskEmails_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_General_MaskEmails_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding MaskEmails, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ══ CLIPROXY ══════════════════════════════════════════ -->
                <StackPanel IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=ConfigCliProxy}">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Classes="page-title" Text="{l:Loc ConfigView_CLIProxy_Title}" />
                        <TextBlock Classes="page-sub" Text="{l:Loc ConfigView_CLIProxy_Subtitle}" />
                    </StackPanel>

                    <!-- Update success banner -->
                    <Border IsVisible="{Binding ShowCliProxyUpdateSuccess}" Background="{DynamicResource AccentBrush}"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <TextBlock Text="{l:LocFormat Key=ConfigView_CLIProxy_UpdateSuccess, Path=InstalledVersion}"
                                   Foreground="White" FontSize="12" FontWeight="Medium"/>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_EngineSection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_Engine_Label}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                        <TextBlock Classes="row-desc"
                                                   Text="{l:LocFormat Key=ConfigView_CLIProxy_Engine_Installed, Path=CliProxyInstalledVersion}" />
                                        <TextBlock Classes="row-desc" Text="→" IsVisible="{Binding CliProxyUpdateAvailable}" />
                                        <TextBlock Classes="row-desc" Foreground="{DynamicResource AccentBrush}"
                                                   Text="{l:LocFormat Key=ConfigView_CLIProxy_Engine_Available, Path=CliProxyLatestVersion}"
                                                   IsVisible="{Binding CliProxyUpdateAvailable}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="app" Content="{l:Loc ConfigView_CLIProxy_Engine_Check}"
                                            Command="{Binding CheckForUpdateCommand}"
                                            IsEnabled="{Binding !IsCheckingForUpdate}"
                                            IsVisible="{Binding !CliProxyUpdateAvailable}" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_CLIProxy_Engine_UpdateNow}"
                                            Command="{Binding UpdateEngineCommand}"
                                            IsVisible="{Binding CliProxyUpdateAvailable}" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_EngineVersion_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{Binding SelectedEngineVersionDescription}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding EngineReleases}" SelectedItem="{Binding SelectedEngineRelease}"
                                              Cursor="Hand" IsEnabled="{Binding CanSelectEngineRelease}"
                                              Width="150" Height="26" MinHeight="0" Padding="8,0"
                                              VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                    <Button Classes="app" Content="{l:Loc ConfigView_CLIProxy_EngineVersion_Reload}"
                                            Command="{Binding RefreshEngineReleasesCommand}"
                                            IsEnabled="{Binding CanSelectEngineRelease}" VerticalAlignment="Center" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_CLIProxy_EngineVersion_Install}"
                                            Command="{Binding InstallSelectedEngineCommand}"
                                            IsEnabled="{Binding CanInstallSelectedEngine}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="14,0,14,11"
                                        IsVisible="{Binding EngineState, Converter={StaticResource EngineStateToText}, ConverterParameter=IsDownloading}">
                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                                             Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource RowDividerBrush}" />
                                <TextBlock Classes="row-desc" Margin="0,4,0,0" Text="{Binding EngineStatusText}" />
                            </StackPanel>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_Integrity_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_Integrity_Description}"/>
                                    <TextBlock Classes="row-desc" ToolTip.Tip="{Binding InstalledEngineHashFull}">
                                        <Run Text="{Binding InstalledEngineHashLabel}" /><Run Text=": " /><Run Text="{Binding InstalledEngineHashShort}" />
                                    </TextBlock>
                                    <TextBlock Classes="row-desc" ToolTip.Tip="{Binding LatestEngineHashFull}">
                                        <Run Text="{l:Loc ConfigView_CLIProxy_Integrity_RemotePackageSha256}" /><Run Text=": " /><Run Text="{Binding LatestEngineHashShort}" />
                                    </TextBlock>
                                    <TextBlock Classes="row-desc" Foreground="{DynamicResource ErrBrush}"
                                               Text="{Binding EngineIntegrityMessage}"
                                               IsVisible="{Binding HasEngineIntegrityError}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="chip" Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Center" ToolTip.Tip="{Binding LatestEngineAssetName}">
                                    <TextBlock Text="{Binding EngineIntegrityStatus}" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoStart_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoStart_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding EngineAutoStart, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoCheck_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoCheck_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoUpdate_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoUpdate_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding AutoUpdate, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAutoUpdateEnabled}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_SecuritySection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AuthFolder_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AuthFolder_Description}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="app" Content="{l:Loc ConfigView_CLIProxy_AuthFolder_Open}"
                                        Command="{Binding OpenAuthFolderCommand}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_ApiKeys_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_ApiKeys_Description}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="app" Content="{l:Loc ConfigView_CLIProxy_ApiKeys_Manage}"
                                        Command="{Binding OpenApiKeysCommand}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_ResetCredentials_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_ResetCredentials_Description}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="app danger" Content="{l:Loc ConfigView_CLIProxy_ResetCredentials_Reset}"
                                        Command="{Binding ResetAllCredentialsCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_NetworkSection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_RoutingStrategy_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_RoutingStrategy_Description}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RoutingStrategyOptions}" Cursor="Hand"
                                          SelectedItem="{Binding SelectedRoutingStrategy, Mode=TwoWay}"
                                          Width="250" Height="26" MinHeight="0" Padding="8,0"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_ListenPort_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_ListenPort_Description}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox Classes="app" Text="{Binding EditablePort, Mode=TwoWay}"
                                             Width="70" Height="24" MinHeight="0" Padding="8,0" MaxLength="5"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_ListenPort_Apply}"
                                            Command="{Binding ApplyPortCommand}"
                                            IsEnabled="{Binding CanApplyPort}" />
                                    <Button Classes="app" Content="{l:Loc ConfigView_CLIProxy_ListenPort_Reset}" Command="{Binding ResetPortCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_LogsSection}"/>
                    <Border Classes="card" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_LogsAutoRefresh_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_LogsAutoRefresh_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding LogsAutoRefresh, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="row-divider"
                                    IsVisible="{Binding LogsAutoRefresh}" />
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding LogsAutoRefresh}">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_LogsRefreshInterval_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_LogsRefreshInterval_Description}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LogsRefreshIntervalOptions}"
                                          SelectedItem="{Binding LogsRefreshIntervalSeconds, Mode=TwoWay}"
                                          FontSize="12" MinWidth="110">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:Int32">
                                            <TextBlock Text="{l:LocFormat Key=ConfigView_CLIProxy_LogsRefreshInterval_Seconds, Path=.}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LocalProxySectionLabel" Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_LocalProxySection}"/>
                    <Border x:Name="LocalProxySectionCard" Classes="card" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc Sidebar_ProxyCard_Title}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,2,0,0">
                                        <Grid Classes="status-indicator" VerticalAlignment="Center">
                                            <Ellipse Classes="status-pulse"
                                                     Fill="{Binding FallbackProxyServerState, Converter={StaticResource StateToBrush}}"
                                                     IsVisible="{Binding FallbackProxyServerState, Converter={StaticResource StateIsRunning}}" />
                                            <Ellipse Classes="status-dot"
                                                     Fill="{Binding FallbackProxyServerState, Converter={StaticResource StateToBrush}}" />
                                        </Grid>
                                        <TextBlock Classes="row-desc"
                                                   Text="{Binding FallbackProxyServerState, Converter={StaticResource StateToText}}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="endpoint" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CliProxyEndpointUrl}"
                                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource FgBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Classes="icon-btn copy-endpoint"
                                            Classes.copied="{Binding EndpointCopied}"
                                            ToolTip.Tip="{l:Loc ProvidersView_CopyEndpointTooltip}"
                                            Click="OnCopyCliProxyEndpoint">
                                        <Panel>
                                            <lucide:PackIconLucide Kind="Copy" Width="13" Height="13" IsVisible="{Binding !EndpointCopied}" />
                                            <lucide:PackIconLucide Kind="Check" Width="13" Height="13" IsVisible="{Binding EndpointCopied}" />
                                        </Panel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Classes="row-divider" />
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc Fallback_RouteCaching_Label}" />
                                    <TextBlock Classes="row-desc" Text="{l:Loc Fallback_RouteCaching_Description}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding Fallback.RouteCachingEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="row-divider" />
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_RouteCacheDuration_Label}" />
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_RouteCacheDuration_Description}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Fallback.RouteCacheDurations}"
                                          SelectedItem="{Binding Fallback.SelectedRouteCacheDuration, Mode=TwoWay}"
                                          IsEnabled="{Binding Fallback.RouteCachingEnabled}"
                                          Width="92" Height="26" MinHeight="0" Padding="8,0"
                                          VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Border Classes="row-divider" IsVisible="{Binding IsFallbackBridgeActive}"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto" IsVisible="{Binding IsFallbackBridgeActive}">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_FallbackBridge_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_FallbackBridge_Description}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Classes="chip" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource AccentBrush}"
                                               Text="{l:LocFormat Key=ConfigView_CLIProxy_InternalPort, Path=CliProxyInternalPort}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ══ PERPLEXITY ══════════════════════════════════════════ -->
                <StackPanel IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=ConfigPerplexity}">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Classes="page-title" Text="{l:Loc ConfigView_Perplexity_Title}" />
                        <TextBlock Classes="page-sub" Text="{l:Loc ConfigView_Perplexity_Subtitle}" />
                    </StackPanel>

                    <!-- Update success banner -->
                    <Border IsVisible="{Binding ShowPerplexityUpdateSuccess}" Background="{DynamicResource AccentBrush}"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <TextBlock Text="{l:LocFormat Key=ConfigView_Perplexity_UpdateSuccess, Path=InstalledVersion}"
                                   Foreground="White" FontSize="12" FontWeight="Medium"/>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_EngineSection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <!-- Version row -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_Perplexity_Engine_Label}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                        <TextBlock Classes="row-desc"
                                                   Text="{l:LocFormat Key=ConfigView_Perplexity_Engine_Installed, Path=PerplexityInstalledVersion}" />
                                        <TextBlock Classes="row-desc" Text="→" IsVisible="{Binding PerplexityUpdateAvailable}" />
                                        <TextBlock Classes="row-desc" Foreground="{DynamicResource AccentBrush}"
                                                   Text="{l:LocFormat Key=ConfigView_Perplexity_Engine_Available, Path=PerplexityLatestVersion}"
                                                   IsVisible="{Binding PerplexityUpdateAvailable}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="app" Content="{l:Loc ConfigView_Perplexity_Engine_Check}"
                                            Command="{Binding CheckForUpdateCommand}"
                                            IsEnabled="{Binding !IsCheckingForUpdate}"
                                            IsVisible="{Binding !UpdateAvailable}" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_Perplexity_Engine_UpdateNow}"
                                            Command="{Binding UpdateEngineCommand}"
                                            IsVisible="{Binding UpdateAvailable}" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <!-- Version selector -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_EngineVersion_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{Binding SelectedEngineVersionDescription}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding EngineReleases}" SelectedItem="{Binding SelectedEngineRelease}"
                                              Cursor="Hand" IsEnabled="{Binding CanSelectEngineRelease}"
                                              Width="150" Height="26" MinHeight="0" Padding="8,0"
                                              VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                    <Button Classes="app" Content="{l:Loc ConfigView_CLIProxy_EngineVersion_Reload}"
                                            Command="{Binding RefreshEngineReleasesCommand}"
                                            IsEnabled="{Binding CanSelectEngineRelease}" VerticalAlignment="Center" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_CLIProxy_EngineVersion_Install}"
                                            Command="{Binding InstallSelectedEngineCommand}"
                                            IsEnabled="{Binding CanInstallSelectedEngine}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <!-- Download progress -->
                            <StackPanel Margin="14,0,14,11"
                                        IsVisible="{Binding EngineState, Converter={StaticResource EngineStateToText}, ConverterParameter=IsDownloading}">
                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                                             Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource RowDividerBrush}" />
                                <TextBlock Classes="row-desc" Margin="0,4,0,0" Text="{Binding EngineStatusText}" />
                            </StackPanel>
                            <Border Classes="row-divider"/>
                            <!-- Package integrity -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_Integrity_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_Integrity_Description}"/>
                                    <TextBlock Classes="row-desc" ToolTip.Tip="{Binding InstalledEngineHashFull}">
                                        <Run Text="{Binding InstalledEngineHashLabel}" /><Run Text=": " /><Run Text="{Binding InstalledEngineHashShort}" />
                                    </TextBlock>
                                    <TextBlock Classes="row-desc" ToolTip.Tip="{Binding LatestEngineHashFull}">
                                        <Run Text="{l:Loc ConfigView_CLIProxy_Integrity_RemotePackageSha256}" /><Run Text=": " /><Run Text="{Binding LatestEngineHashShort}" />
                                    </TextBlock>
                                    <TextBlock Classes="row-desc" Foreground="{DynamicResource ErrBrush}"
                                               Text="{Binding EngineIntegrityMessage}"
                                               IsVisible="{Binding HasEngineIntegrityError}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="chip" Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Center" ToolTip.Tip="{Binding LatestEngineAssetName}">
                                    <TextBlock Text="{Binding EngineIntegrityStatus}" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <!-- Auto-start -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoStart_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoStart_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding EngineAutoStart, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <!-- Auto-check -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoCheck_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoCheck_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <!-- Auto-update -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoUpdate_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoUpdate_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding AutoUpdate, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAutoUpdateEnabled}" />
                            </Grid>

                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_SecuritySection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_Perplexity_AccountsFolder_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_Perplexity_AccountsFolder_Description}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="app" Content="{l:Loc ConfigView_Perplexity_AccountsFolder_Open}"
                                        Command="{Binding OpenSettingsFolderCommand}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_Perplexity_ResetAccounts_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_Perplexity_ResetAccounts_Description}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="app danger" Content="{l:Loc ConfigView_Perplexity_ResetAccounts_Reset}"
                                        Command="{Binding ResetPerplexityAccountsCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_NetworkSection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_Perplexity_ListenPort_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_Perplexity_ListenPort_Description}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox Classes="app" Text="{Binding EditablePort, Mode=TwoWay}"
                                             Width="70" Height="24" MinHeight="0" Padding="8,0" MaxLength="5"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_ListenPort_Apply}"
                                            Command="{Binding ApplyPortCommand}"
                                            IsEnabled="{Binding CanApplyPort}" />
                                    <Button Classes="app" Content="{l:Loc ConfigView_Perplexity_ListenPort_Reset}" Command="{Binding ResetPortCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══ 9ROUTER ══════════════════════════════════════════ -->
                <StackPanel IsVisible="{Binding SelectedSection, Converter={StaticResource SectionEq}, ConverterParameter=ConfigNineRouter}">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Classes="page-title" Text="{l:Loc ConfigView_NineRouter_Title}" />
                        <TextBlock Classes="page-sub" Text="{l:Loc ConfigView_NineRouter_Subtitle}" />
                    </StackPanel>

                    <Border Classes="alert warning" IsVisible="{Binding IsNineRouterNodeMissing}" Margin="0,0,0,8">
                        <TextBlock Classes="alert-body" Text="{l:Loc ConfigView_NineRouter_NodeMissing}" />
                    </Border>

                    <!-- Update success banner -->
                    <Border IsVisible="{Binding ShowNineRouterUpdateSuccess}" Background="{DynamicResource AccentBrush}"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <TextBlock Text="{l:LocFormat Key=ConfigView_NineRouter_UpdateSuccess, Path=NineRouterInstalledVersion}"
                                   Foreground="White" FontSize="12" FontWeight="Medium"/>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_EngineSection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <!-- Version row -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_NineRouter_Engine_Label}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                        <TextBlock Classes="row-desc"
                                                   Text="{l:LocFormat Key=ConfigView_NineRouter_Engine_Installed, Path=NineRouterInstalledVersion}" />
                                        <TextBlock Classes="row-desc" Text="→" IsVisible="{Binding NineRouterUpdateAvailable}" />
                                        <TextBlock Classes="row-desc" Foreground="{DynamicResource AccentBrush}"
                                                   Text="{l:LocFormat Key=ConfigView_NineRouter_Engine_Available, Path=NineRouterLatestVersion}"
                                                   IsVisible="{Binding NineRouterUpdateAvailable}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="app" Content="{l:Loc ConfigView_NineRouter_Engine_Check}"
                                            Command="{Binding CheckForUpdateCommand}"
                                            IsEnabled="{Binding !IsCheckingForUpdate}"
                                            IsVisible="{Binding !UpdateAvailable}" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_NineRouter_Engine_UpdateNow}"
                                            Command="{Binding UpdateEngineCommand}"
                                            IsVisible="{Binding UpdateAvailable}" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <!-- Version selector -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_EngineVersion_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{Binding SelectedEngineVersionDescription}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding EngineReleases}" SelectedItem="{Binding SelectedEngineRelease}"
                                              Cursor="Hand" IsEnabled="{Binding CanSelectEngineRelease}"
                                              Width="150" Height="26" MinHeight="0" Padding="8,0"
                                              VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                    <Button Classes="app" Content="{l:Loc ConfigView_CLIProxy_EngineVersion_Reload}"
                                            Command="{Binding RefreshEngineReleasesCommand}"
                                            IsEnabled="{Binding CanSelectEngineRelease}" VerticalAlignment="Center" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_CLIProxy_EngineVersion_Install}"
                                            Command="{Binding InstallSelectedEngineCommand}"
                                            IsEnabled="{Binding CanInstallSelectedEngine}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <!-- Download progress -->
                            <StackPanel Margin="14,0,14,11"
                                        IsVisible="{Binding EngineState, Converter={StaticResource EngineStateToText}, ConverterParameter=IsDownloading}">
                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                                             Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource RowDividerBrush}" />
                                <TextBlock Classes="row-desc" Margin="0,4,0,0" Text="{Binding EngineStatusText}" />
                            </StackPanel>
                            <Border Classes="row-divider"/>
                            <!-- Package integrity -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_Integrity_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_Integrity_Description}"/>
                                    <TextBlock Classes="row-desc" ToolTip.Tip="{Binding InstalledEngineHashFull}">
                                        <Run Text="{Binding InstalledEngineHashLabel}" /><Run Text=": " /><Run Text="{Binding InstalledEngineHashShort}" />
                                    </TextBlock>
                                    <TextBlock Classes="row-desc" ToolTip.Tip="{Binding LatestEngineHashFull}">
                                        <Run Text="{l:Loc ConfigView_CLIProxy_Integrity_RemotePackageSha256}" /><Run Text=": " /><Run Text="{Binding LatestEngineHashShort}" />
                                    </TextBlock>
                                    <TextBlock Classes="row-desc" Foreground="{DynamicResource ErrBrush}"
                                               Text="{Binding EngineIntegrityMessage}"
                                               IsVisible="{Binding HasEngineIntegrityError}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="chip" Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Center" ToolTip.Tip="{Binding LatestEngineAssetName}">
                                    <TextBlock Text="{Binding EngineIntegrityStatus}" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <!-- Auto-start -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoStart_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoStart_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding EngineAutoStart, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <!-- Auto-check -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoCheck_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoCheck_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <!-- Auto-update -->
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_CLIProxy_AutoUpdate_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_CLIProxy_AutoUpdate_Description}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Classes="enable-toggle"
                                              IsChecked="{Binding AutoUpdate, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAutoUpdateEnabled}" />
                            </Grid>

                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_SecuritySection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_NineRouter_EngineFolder_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_NineRouter_EngineFolder_Description}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="app" Content="{l:Loc ConfigView_NineRouter_EngineFolder_Open}"
                                        Command="{Binding OpenNineRouterEngineFolderCommand}" />
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_NineRouter_Dashboard_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_NineRouter_Dashboard_Description}"/>
                                    <TextBlock Classes="row-desc" Text="{Binding NineRouterDashboardUrl}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="app" Content="{l:Loc ConfigView_NineRouter_Dashboard_Open}"
                                        Command="{Binding OpenNineRouterDashboardCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-label" Text="{l:Loc ConfigView_CLIProxy_NetworkSection}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Margin="14,11" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="row-label" Text="{l:Loc ConfigView_NineRouter_ListenPort_Label}"/>
                                    <TextBlock Classes="row-desc" Text="{l:Loc ConfigView_NineRouter_ListenPort_Description}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox Classes="app" Text="{Binding EditablePort, Mode=TwoWay}"
                                             Width="70" Height="24" MinHeight="0" Padding="8,0" MaxLength="5"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                    <Button Classes="app primary" Content="{l:Loc ConfigView_ListenPort_Apply}"
                                            Command="{Binding ApplyPortCommand}"
                                            IsEnabled="{Binding CanApplyPort}" />
                                    <Button Classes="app" Content="{l:Loc ConfigView_NineRouter_ListenPort_Reset}" Command="{Binding ResetPortCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Panel>
</UserControl>
